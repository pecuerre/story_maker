<% modal_fields = local_assigns.fetch(:modal_fields, []) %>
<% taxonomy_field = local_assigns[:taxonomy_field] %>
<li class="taxonomy-node" draggable="true" data-taxonomy-tree-target="node" data-action="dragstart->taxonomy-tree#startDrag dragover->taxonomy-tree#allowDrop drop->taxonomy-tree#moveNode" data-node-id="<%= node.id %>" data-update-url="<%= update_url.call(node) %>" data-edit-url="<%= edit_url.call(node) %>" data-create-url="<%= create_url %>" data-name="<%= node.name %>" data-description="<%= node.description %>"<% if taxonomy_field %> data-taxonomy-field-value="<%= node.public_send(taxonomy_field) %>"<% end %>>
  <div class="taxonomy-row d-flex align-items-center gap-2 border-bottom py-2">
    <i class="bi bi-grip-vertical text-body-secondary" aria-hidden="true"></i>
    <span class="flex-grow-1 text-break" role="button" tabindex="0" data-taxonomy-tree-target="name" data-action="click->taxonomy-tree#editName keydown.enter->taxonomy-tree#editName"><%= node.name %></span>
    <span class="taxonomy-actions d-flex gap-1">
      <% if new_url %>
        <%= button_tag type: "button", class: "btn btn-sm btn-outline-secondary", title: "Add child", aria: { label: "Add child to #{node.name}" }, data: { action: "taxonomy-tree#add" } do %>
          <i class="bi bi-plus-lg" aria-hidden="true"></i>
        <% end %>
      <% end %>
      <%= button_tag type: "button", class: "btn btn-sm btn-outline-secondary", title: "Edit", aria: { label: "Edit #{node.name}" }, data: { action: "taxonomy-tree#edit" } do %>
        <i class="bi bi-pencil" aria-hidden="true"></i>
      <% end %>
      <%= button_tag type: "button", class: "btn btn-sm btn-outline-danger", title: "Delete", aria: { label: "Delete #{node.name}" }, data: { action: "taxonomy-tree#remove" } do %>
        <i class="bi bi-trash" aria-hidden="true"></i>
      <% end %>
    </span>
  </div>

  <% children = node.public_send(children_method) %>
  <% if children.any? %>
    <ul class="taxonomy-list list-unstyled ms-4" data-action="dragover->taxonomy-tree#allowDrop drop->taxonomy-tree#moveNode" data-drop-parent-id="<%= node.id %>">
      <% children.each do |child| %>
        <%= render "shared/taxonomy_node",
          node: child,
          children_method: children_method,
          new_url: new_url,
          edit_url: edit_url,
          update_url: update_url,
          delete_url: delete_url,
          create_url: create_url,
          model_param: model_param,
          modal_fields: modal_fields,
          taxonomy_field: taxonomy_field %>
      <% end %>
    </ul>
  <% end %>
</li>