<% nodes = local_assigns.fetch(:nodes) %>
<% children_method = local_assigns.fetch(:children_method, :children) %>
<% new_url = local_assigns[:new_url] %>
<% create_url = local_assigns.fetch(:create_url) %>
<% edit_url = local_assigns.fetch(:edit_url) %>
<% update_url = local_assigns.fetch(:update_url) %>
<% delete_url = local_assigns.fetch(:delete_url) %>
<% model_param = local_assigns.fetch(:model_param) %>
<% modal_fields = local_assigns.fetch(:modal_fields, []) %>
<% taxonomy_field = local_assigns[:taxonomy_field] %>

<div class="taxonomy-tree" data-controller="taxonomy-tree" data-taxonomy-tree-model-param-value="<%= model_param %>" data-taxonomy-tree-create-url-value="<%= create_url %>" data-taxonomy-tree-modal-fields-value="<%= modal_fields.to_json %>"<% if taxonomy_field %> data-taxonomy-tree-field-name-value="<%= taxonomy_field %>"<% end %>>
  <%= button_tag type: "button", class: "btn btn-sm btn-primary mb-3", data: { action: "taxonomy-tree#add", create_url: new_url.call } do %>
    <i class="bi bi-plus-circle" aria-hidden="true"></i>
    <span>Add <%= model_param.capitalize %></span>
  <% end if new_url %>

  <ul class="taxonomy-list list-unstyled mb-0" data-action="dragover->taxonomy-tree#allowDrop drop->taxonomy-tree#drop" data-drop-parent-id="">
    <% nodes.each do |node| %>
      <%= render "shared/taxonomy_node",
        node: node,
        children_method: children_method,
        new_url: new_url,
        edit_url: edit_url,
        update_url: update_url,
        delete_url: delete_url,
        create_url: create_url,
        model_param: model_param,
        modal_fields: modal_fields,
        taxonomy_field: taxonomy_field %>
    <% end %>
  </ul>
</div>