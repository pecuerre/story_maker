<% content_for :title, "Stories" %>

<div class="d-flex align-items-center justify-content-between mb-3">
  <h1 class="mb-0">Stories</h1>
  <%= link_to "New story", new_universe_story_path, class: "btn btn-primary" %>
</div>

<% if @stories.empty? %>
  <p class="text-body-secondary">
    No stories yet. A story holds the plot and sections of this universe, while
    characters, locations, events and items are shared by all of them.
  </p>
<% end %>

<div class="row">
  <% @stories.each do |story| %>
    <div class="col-md-6 col-lg-4 mb-3">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="card-title">
            <%= link_to story.name, universe_story_path(id: story) %>
            <% if Current.story == story %>
              <span class="badge text-bg-primary">Current</span>
            <% end %>
          </h5>
          <% if story.description.present? %>
            <p class="card-text"><%= story.description %></p>
          <% end %>
          <p class="card-text">
            <small class="text-body-secondary">
              <%= pluralize(story.sections.size, "section") %>
            </small>
          </p>
          <%= link_to "Sections", universe_story_sections_path(story_id: story), class: "btn btn-sm btn-outline-primary" %>
        </div>
        <div class="card-footer d-flex justify-content-between">
          <%= link_to "Edit", edit_universe_story_path(id: story) %>
          <%= button_to "Destroy",
                universe_story_path(id: story),
                method: :delete,
                class: "btn btn-sm btn-outline-danger",
                data: { turbo_confirm: "Delete this story and all of its sections?" } %>
        </div>
      </div>
    </div>
  <% end %>
</div>
