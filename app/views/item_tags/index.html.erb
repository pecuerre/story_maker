<% content_for :title, t("tags.types.item.title") %>

<%= render "shared/taxonomy_tree",
  title: t("tags.types.item.title"),
  description: t("tags.types.item.description"),
  eyebrow: t("sidebar.universe_bible"),
  count: Current.universe.item_tags.count,
  count_label: "tag",
  new_label: t("tags.types.item.new_label"),
  tag_workspace_scope: "universe",
  tag_workspace_taxonomy: "item",
  empty_description: t("tags.types.item.empty_description"),
  read_only_empty_description: t("tags.types.item.read_only_empty_description"),
  nodes: @item_tags,
  hierarchy: @hierarchy,
  create_url: universe_item_tags_path,
  update_url: ->(item_tag) { universe_item_tag_path(id: item_tag) },
  model_param: "item_tag",
  details_url: ->(item_tag) { universe_item_tag_path(id: item_tag) },
  details_count: ->(tag) { @tagged_counts.fetch(tag.id, 0) },
  details_count_label: "item",
  modal_fields: item_tag_taxonomy_fields(@hierarchy.records) %>
