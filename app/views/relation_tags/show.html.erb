<% content_for :title, @relation_tag.name %>

<%= render "shared/record_details",
  record: @relation_tag,
  eyebrow: t("tags.show.eyebrow"),
  label: t("tags.types.relation.record_label"),
  **tag_identity_details(@relation_tag),
  back_url: universe_relation_tags_path,
  back_label: t("tags.types.relation.all_label"),
  actions: discussion_control(@relation_tag) %>

<%= render "shared/include_descendants_toggle" %>

<%= render "shared/detail_section",
  title: t("tags.types.relation.records_title"),
  count: @tagged_records.size,
  count_label: "relation",
  icon: "diagram-2",
  empty_title: t("shared.detail_section.empty_title", determiner: t("shared.detail_section.determiners.none_masculine"), label: t("relation", count: 1)),
  empty_description: t("tags.types.relation.unused_description") do %>
  <%= render "shared/tagged_record_list",
    records: @tagged_records,
    path: ->(record) { universe_relation_path(id: record) } %>
<% end %>
