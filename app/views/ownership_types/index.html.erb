<% content_for :title, "Ownership types" %>

<h1>Ownership types</h1>

<%= render "shared/taxonomy_tree",
  nodes: @ownership_types,
  new_url: ->(parent = nil) { new_universe_ownership_type_path(parent_id: parent&.id) },
  create_url: universe_ownership_types_path(),
  edit_url: ->(ownership_type) { edit_universe_ownership_type_path(id: ownership_type) },
  update_url: ->(ownership_type) { universe_ownership_type_path(id: ownership_type) },
  delete_url: ->(ownership_type) { universe_ownership_type_path(id: ownership_type) },
  model_param: "ownership_type",
  modal_fields: ownership_type_taxonomy_fields(Current.universe.ownership_types.order(:position, :id)) %>