<% content_for :title, "Item Tags" %>

<%= render "shared/taxonomy_tree",
  title: "Item tags",
  description: "Define optional categories for objects and resources in this universe.",
  eyebrow: "Universe Bible",
  count: Current.universe.item_tags.count,
  count_label: "tag",
  new_label: "Add item tag",
  tabs_aria_label: "Item workspace",
  tabs: [
    { label: "Items", path: universe_items_path, controller: :items },
    { label: "Item tags", path: universe_item_tags_path, controller: :item_tags },
    { label: "Ownerships", path: universe_ownerships_path, controller: :ownerships },
    { label: "Ownership tags", path: universe_ownership_tags_path, controller: :ownership_tags }
  ],
  empty_description: "Tags are optional. Add one to group items, or create untagged items.",
  nodes: @item_tags,
  new_url: ->(parent = nil) { new_universe_item_tag_path(parent_id: parent&.id) },
  create_url: universe_item_tags_path,
  edit_url: ->(item_tag) { edit_universe_item_tag_path(id: item_tag) },
  update_url: ->(item_tag) { universe_item_tag_path(id: item_tag) },
  delete_url: ->(item_tag) { universe_item_tag_path(id: item_tag) },
  model_param: "item_tag",
  modal_fields: item_tag_taxonomy_fields(Current.universe.item_tags.order(:position, :id)) %>
