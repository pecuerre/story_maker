<% content_for :title, @location.name %>
<%# A Location with no description keeps the identity card exactly as every
    other record's card is: the wide prose block exists only when there is prose
    to read. The description is Markdown, so its `##` sections and its
    `[[kind:slug]]` links are rendered by the shared dialect. %>
<% description_facts = if @location.description.present?
  [ detail_fact(t("locations.show.facts.description"), markdown_description_html(@location)) ]
else
  []
end %>
<%# A writer gets the tree's own editor as an Edit control; the descriptors are
    built once here so the trigger and the page's other reads share one list. %>
<% editable = can_write_universe? %>
<% edit_fields = location_taxonomy_fields(@location_tags, @location_options) if editable %>

<%= render "shared/record_details",
  record: @location,
  eyebrow: t("sidebar.universe_bible"),
  label: t("locations.show.label"),
  description: summary_html(@location),
  facts: [
    detail_fact(t("locations.show.facts.universe"), link_to(Current.universe.name, universe_path(id: Current.universe))),
    detail_fact(t("locations.show.facts.tags"), entity_tag_badge(@location), blank: t("locations.show.facts.tags_blank")),
    detail_fact(t("locations.show.facts.parent"), @location.parent && @location.parent.name, blank: t("locations.show.facts.parent_blank")),
    detail_fact(t("locations.show.facts.children"), count_with_label(@location.children.size, "location"), blank: t("locations.show.facts.children_blank"))
  ],
  wide_facts: description_facts,
  back_url: universe_locations_path,
  back_label: t("locations.show.back_label"),
  editor: (render("locations/edit_control", location: @location, fields: edit_fields) if editable),
  actions: discussion_control(@location) %>

<%= render "locations/presence", location: @location %>
<%= render "scene_appearances/section", record: @location %>
