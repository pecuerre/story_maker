<%# Settings is a platform page, not universe content, so it is reached from the top
    bar and renders without a workspace. Each section has one address, selected
    by `?section=…`; a new section is one entry in `settings_tabs`, one value in
    `SETTINGS_SECTIONS`, and one panel here. %>
<%= render "shared/page_header",
  title: t("settings.title"),
  eyebrow: t("settings.eyebrow"),
  description: t("settings.description") do %>
  <%# The page remembers where it was opened from, so finishing here returns the
      reader to the page they were on rather than to the landing page. %>
  <%= link_to after_settings_url,
    class: "btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-2" do %>
    <i class="bi bi-arrow-left" aria-hidden="true"></i>
    <%= t("settings.go_back") %>
  <% end %>
<% end %>

<div class="settings-layout">
  <%= render "shared/settings_navigation", tabs: settings_tabs %>

  <% if settings_section?("language") %>
    <section class="settings-panel" aria-labelledby="language-title">
      <h2 class="settings-panel-title" id="language-title"><%= t("settings.language.title") %></h2>
      <p class="settings-panel-description"><%= t("settings.language.description") %></p>

      <%# A plain full-page form, like the theme one. It opts out of Turbo for a
          different reason, and the same reason in effect: `I18n.locale` is read
          when the response is rendered, and a Turbo Drive navigation would
          render the new language into the body while leaving `<html lang>` and
          any already-loaded page in the old one. A real page load is the one
          navigation that guarantees the whole document changes language at
          once. %>
      <%= form_with url: settings_path_for("language"), method: :patch, class: "form-surface settings-form",
        data: { turbo: false } do |form| %>
        <fieldset class="settings-fieldset">
          <legend class="form-label"><%= t("settings.language.legend") %></legend>
          <p class="settings-hint" id="language-hint"><%= t("settings.language.hint") %></p>

          <div class="theme-options">
            <% AppLocale.names.each do |name| %>
              <%# Each option is labelled in its own language, so a reader who
                  cannot read the current one can still find theirs. %>
              <div class="theme-option">
                <%= form.radio_button :locale, name,
                  checked: name == current_locale,
                  class: "form-check-input",
                  aria: { describedby: "language-hint" } %>
                <label class="theme-option-label" for="locale_<%= name %>">
                  <span class="theme-option-copy">
                    <span class="theme-option-name"><%= AppLocale.label_for(name) %></span>
                    <span class="theme-option-description"><%= t("settings.language.option_description.#{name}") %></span>
                  </span>
                </label>
              </div>
            <% end %>
          </div>
        </fieldset>

        <div class="form-actions">
          <%= form.submit t("settings.language.submit"), class: "btn btn-primary" %>
        </div>
      <% end %>
    </section>
  <% elsif settings_section?("limits") %>
    <%# The one panel that is not a browser preference. The others write a signed
        cookie this browser sends back; this one writes a row the whole deployment
        reads, because the number it holds bounds how many universes *any* account
        may create. The page's own premise is that a preference belongs to this
        browser, so the panel says in its own words that this one is the platform's
        and not the reader's, rather than letting a reader assume otherwise.

        It reaches here only for an operator: `settings_sections` omits it for
        everyone else and `current_settings_section` treats a guessed
        `?section=limits` as unrecognised, so the authorization is `Ability`'s and
        is not merely a hidden control. %>
    <section class="settings-panel" aria-labelledby="limits-title">
      <h2 class="settings-panel-title" id="limits-title"><%= t("settings.limits.title") %></h2>
      <p class="settings-panel-description"><%= t("settings.limits.description") %></p>

      <%= form_with url: settings_path_for("limits"), method: :patch, class: "form-surface settings-form",
        data: { turbo: false } do |form| %>
        <fieldset class="settings-fieldset">
          <legend class="form-label"><%= t("settings.limits.legend") %></legend>
          <p class="settings-hint" id="limits-hint"><%= t("settings.limits.hint", limit: PlatformSetting::DEFAULT_UNIVERSE_CREATION_LIMIT) %></p>

          <%# Bound explicitly, for the same reason the universe form binds its
              budget: `universe_creation_limit` answers the *default* for a row
              storing `NULL`, so letting Rails bind it would print 5 where an
              operator deliberately stored "no limit" and submitting it would
              impose 5. The predicate is asked first, and an omitted parameter
              leaves the column alone. %>
          <% limit_setting = PlatformSetting.current %>
          <div class="mb-3">
            <%= form.label limit_param, t("settings.limits.universe_creation_limit"), class: "form-label" %>
            <%= form.number_field limit_param,
              value: (limit_setting.universe_creations_unlimited? ? nil : limit_setting.universe_creation_limit),
              min: 1, step: 1, class: "form-control", aria: { describedby: "limits-hint" } %>
          </div>
        </fieldset>

        <div class="form-actions">
          <%= form.submit t("settings.limits.submit"), class: "btn btn-primary" %>
        </div>
      <% end %>
    </section>
  <% elsif settings_section?("start_page") %>
    <%# This section is neither display nor language: it changes which page opens
        rather than how the page is drawn, which is why it has its own tab. %>
    <section class="settings-panel" aria-labelledby="start-page-title">
      <h2 class="settings-panel-title" id="start-page-title"><%= t("settings.start_page.title") %></h2>
      <p class="settings-panel-description"><%= t("settings.start_page.description") %></p>

      <%# A plain full-page form, opting out of Turbo for consistency with the
          other two sections rather than out of necessity: nothing here lives on
          the root element, so a Turbo submission would work. It is still a real
          page load, so every section of this page saves the same way — the
          section navigation's active state and the flash are both rendered by
          the response rather than re-derived from the request that preceded it. %>
      <%= form_with url: settings_path_for("start_page"), method: :patch, class: "form-surface settings-form",
        data: { turbo: false } do |form| %>
        <fieldset class="settings-fieldset">
          <legend class="form-label"><%= t("settings.start_page.legend") %></legend>
          <p class="settings-hint" id="start-page-hint"><%= t("settings.start_page.hint") %></p>

          <div class="theme-options">
            <% AppStartPage.names.each do |name| %>
              <%# The label is the card, so the checked state is one adjacent-sibling
                  rule away and the control needs no scripting. %>
              <div class="theme-option">
                <%= form.radio_button :start_page, name,
                  checked: name == current_start_page,
                  class: "form-check-input",
                  aria: { describedby: "start-page-hint" } %>
                <label class="theme-option-label" for="start_page_<%= name %>">
                  <span class="theme-option-icon" aria-hidden="true"><i class="bi bi-<%= AppStartPage.icon_for(name) %>"></i></span>
                  <span class="theme-option-copy">
                    <span class="theme-option-name"><%= AppStartPage.label_for(name) %></span>
                    <span class="theme-option-description"><%= AppStartPage.description_for(name) %></span>
                  </span>
                </label>
              </div>
            <% end %>
          </div>
        </fieldset>

        <div class="form-actions">
          <%= form.submit t("settings.start_page.submit"), class: "btn btn-primary" %>
        </div>
      <% end %>
    </section>
  <% else %>
    <section class="settings-panel" aria-labelledby="appearance-title">
      <h2 class="settings-panel-title" id="appearance-title"><%= t("settings.appearance.title") %></h2>
      <p class="settings-panel-description"><%= t("settings.appearance.description") %></p>

      <%# A plain full-page form: the theme is a preference, so it is submitted once
          and answered with a redirect, the same shape as the other non-model forms.
          It opts out of Turbo deliberately. The theme lives in an attribute on the
          root element, and a Turbo Drive navigation replaces the body without
          touching the root element's attributes, so a Turbo submission would leave
          the new choice unapplied. A real page load is also the one navigation that
          guarantees the first paint is already in the new palette. %>
      <%= form_with url: settings_path, method: :patch, class: "form-surface settings-form",
        data: { turbo: false } do |form| %>
        <fieldset class="settings-fieldset">
          <legend class="form-label"><%= t("settings.appearance.legend") %></legend>
          <p class="settings-hint" id="theme-hint"><%= t("settings.appearance.hint") %></p>

          <div class="theme-options">
            <% AppTheme.names.each do |name| %>
              <%# The label is the card, so the checked state is one adjacent-sibling
                  rule away and the control needs no scripting. %>
              <div class="theme-option">
                <%= form.radio_button :theme, name,
                  checked: name == current_theme,
                  class: "form-check-input",
                  aria: { describedby: "theme-hint" } %>
                <label class="theme-option-label" for="theme_<%= name %>">
                  <span class="theme-option-swatch theme-option-swatch--<%= name %>" aria-hidden="true"></span>
                  <span class="theme-option-copy">
                    <span class="theme-option-name"><%= AppTheme.label_for(name) %></span>
                    <span class="theme-option-description"><%= t("settings.appearance.option_description.#{name}") %></span>
                  </span>
                </label>
              </div>
            <% end %>
          </div>
        </fieldset>

        <div class="form-actions">
          <%= form.submit t("settings.appearance.submit"), class: "btn btn-primary" %>
        </div>
      <% end %>
    </section>
  <% end %>
</div>