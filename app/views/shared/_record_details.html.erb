<%# The header and identity block shared by every record's own details page.

    Local contract:
      record     - the record being shown
      eyebrow    - scope label, e.g. "Universe Bible" or "Story: <name>"
      label      - record type, e.g. "Character"
      facts      - [ label, value ] pairs for shared/detail_facts
      back_url / back_label - where the list this page was opened from lives
      edit_url / edit_label - optional editor link, writers only
      block      - optional content between the page header and the identity
                    card. The tab strip belongs to the page's navigation
                    chrome, not to the record, so a workspace that stays open
                    here puts its tabs there and keeps the card below them.

    A record with a photo shows it in the left part of the identity card, with
    the facts beside it. A record without one is laid out exactly as it was
    before photos existed: the two branches below differ only by the presence of
    the picture. %>
<% record = local_assigns.fetch(:record) %>
<% title = local_assigns[:title] || (record.try(:display_string) || record.name) %>
<% photo = record.try(:photo) %>

<%= render "shared/page_header",
  title: title,
  eyebrow: local_assigns.fetch(:eyebrow),
  description: local_assigns[:description] || record.description do %>
  <%= link_to local_assigns.fetch(:back_label), local_assigns.fetch(:back_url),
    class: "btn btn-outline-secondary" %>
  <% if local_assigns[:edit_url].present? && can_write_universe? %>
    <%= link_to local_assigns.fetch(:edit_label), local_assigns.fetch(:edit_url),
      class: "btn btn-primary" %>
  <% end %>
<% end %>

<% if block_given? %>
  <%= yield %>
<% end %>

<div class="surface-card p-4">
  <% if photo %>
    <div class="row g-4 align-items-start">
      <div class="col-12 col-sm-5 col-md-4 col-lg-3">
        <%= render "shared/record_photo", photo: photo, name: title %>
      </div>
      <div class="col-12 col-sm-7 col-md-8 col-lg-9">
        <%= render "shared/record_details_identity",
          title: title,
          label: local_assigns[:label],
          facts: local_assigns.fetch(:facts) %>
      </div>
    </div>
  <% else %>
    <%= render "shared/record_details_identity",
      title: title,
      label: local_assigns[:label],
      facts: local_assigns.fetch(:facts) %>
  <% end %>
</div>
