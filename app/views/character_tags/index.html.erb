<% content_for :title, "Character Tags" %>

<%= render "shared/taxonomy_tree",
  title: "Character tags",
  description: "Define the optional labels used to organize characters across this universe.",
  eyebrow: "Universe Bible",
  count: Current.universe.character_tags.count,
  count_label: "tag",
  new_label: "Add character tag",
  tabs_aria_label: "Character workspace",
  tabs: [
    { label: "Characters", path: universe_characters_path, controller: :characters },
    { label: "Character tags", path: universe_character_tags_path, controller: :character_tags },
    { label: "Relations", path: universe_relations_path, controller: :relations },
    { label: "Relation tags", path: universe_relation_tags_path, controller: :relation_tags }
  ],
  empty_description: "Tags are optional. Add one to group characters, or create characters without a tag.",
  nodes: @character_tags,
  new_url: ->(parent = nil) { new_universe_character_tag_path(parent_id: parent&.id) },
  create_url: universe_character_tags_path,
  edit_url: ->(character_tag) { edit_universe_character_tag_path(id: character_tag) },
  update_url: ->(character_tag) { universe_character_tag_path(id: character_tag) },
  delete_url: ->(character_tag) { universe_character_tag_path(id: character_tag) },
  model_param: "character_tag",
  modal_fields: character_tag_taxonomy_fields(Current.universe.character_tags.order(:position, :id)) %>
