<%# The header and identity block shared by every record's own details page.

    Local contract:
      record     - the record being shown
      eyebrow    - scope label, e.g. "Universe Bible" or "Story: <name>"
      label      - record type, e.g. "Character"
      facts      - [ label, value ] pairs for shared/detail_facts. Optional: a
                    page whose facts are all prose passes none, because an empty
                    grid would render as an empty `<dl>`.
      wide_facts - [ label, value ] pairs rendered full width *below* the photo
                    row rather than beside the photo. A long value the reader
                    reads as prose (a description) belongs to the card's whole
                    measure, not to the column the photo leaves.
      footer     - the record's own settings as compact `label: value` pairs on
                    one quiet line at the bottom of the card. See
                    `shared/_detail_footer` for the shape and why.
      back_url / back_label - where the list this page was opened from lives
      edit_url / edit_label - optional editor link, writers only
      actions     - optional already-rendered controls placed in the page header's
                    action group, after the back and edit links. A page passes one
                    only when the control is genuinely its own: the "Discuss"
                    control decides for itself whether a reader may use it, so
                    passing it cannot give a guest a control to press.
      block      - optional content between the page header and the identity
                    card. The tab strip belongs to the page's navigation
                    chrome, not to the record, so a workspace that stays open
                    here puts its tabs there and keeps the card below them.

    A record with a photo shows it in the left part of the identity card, with
    the facts beside it. A record without one is laid out exactly as it was
    before photos existed: the two branches below differ only by the presence of
    the picture. `wide_facts` and `footer` sit outside both branches, so they
    span the whole card whatever the photo layout is. %>
<% record = local_assigns.fetch(:record) %>
<% title = local_assigns[:title] || record_label(record) %>
<% photo = record.try(:photo) %>

<%= render "shared/page_header",
  title: title,
  eyebrow: local_assigns.fetch(:eyebrow),
  description: local_assigns[:description] || record.description do %>
  <%= link_to local_assigns.fetch(:back_label), local_assigns.fetch(:back_url),
    class: "btn btn-outline-secondary" %>
  <% if local_assigns[:edit_url].present? && can_write_universe? %>
    <%= link_to local_assigns.fetch(:edit_label), local_assigns.fetch(:edit_url),
      class: "btn btn-primary" %>
  <% end %>
  <%= local_assigns[:actions] %>
<% end %>

<% if block_given? %>
  <%= yield %>
<% end %>

<% facts = local_assigns[:facts] || [] %>
<% wide_facts = local_assigns[:wide_facts] || [] %>
<% footer = local_assigns[:footer] || [] %>

<div class="surface-card p-4">
  <% if photo %>
    <div class="row g-4 align-items-start">
      <div class="col-12 col-sm-5 col-md-4 col-lg-3">
        <%= render "shared/record_photo", photo: photo, name: title %>
      </div>
      <div class="col-12 col-sm-7 col-md-8 col-lg-9">
        <%= render "shared/record_details_identity",
          title: title,
          label: local_assigns[:label],
          facts: facts %>
      </div>
    </div>
  <% else %>
    <%= render "shared/record_details_identity",
      title: title,
      label: local_assigns[:label],
      facts: facts %>
  <% end %>

  <% if wide_facts.present? %>
    <%= render "shared/detail_facts", facts: wide_facts, class_name: "detail-facts-wide" %>
  <% end %>

  <%= render "shared/detail_footer", facts: footer %>
</div>
