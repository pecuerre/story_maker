<% content_for :title, @faction_tag.name %>

<%= render "shared/record_details",
  record: @faction_tag,
  eyebrow: t("tags.show.eyebrow"),
  label: t("tags.types.faction.record_label"),
  **tag_identity_details(@faction_tag),
  back_url: universe_faction_tags_path,
  back_label: t("tags.types.faction.all_label"),
  actions: discussion_control(@faction_tag) do %>
  <%= render "shared/menu_tag_content_tabs", tag_type: "faction", tag: @faction_tag %>
<% end %>

<% empty_title = t("shared.detail_section.empty_title", determiner: t("shared.detail_section.determiners.none_feminine"), label: t("faction", count: 1)) %>

<% if @faction_tag.taggable %>
  <%= render "shared/include_descendants_toggle" %>
  <%= render "shared/detail_section",
    title: t("tags.types.faction.records_title"),
    count: @tagged_records.size,
    pending_count: draft_pending_records_for_tag(@faction_tag, include_descendants: @include_descendants).size,
    count_label: "faction",
    icon: "people-fill",
    empty_title: empty_title,
    empty_description: t("tags.types.faction.unused_description") do %>
    <%= render "shared/tagged_record_list",
      records: @tagged_records,
      pending: draft_pending_records_for_tag(@faction_tag, include_descendants: @include_descendants),
      path: ->(record) { universe_faction_path(id: record) } %>
  <% end %>
<% else %>
  <%= render "shared/tagged_records_by_child_tag",
    child_tags: @child_tags,
    records_by_child_tag: @records_by_child_tag,
    tags_by_record: @tags_by_record,
    count_label: "faction",
    icon: "people-fill",
    path: ->(record) { universe_faction_path(id: record) } %>
<% end %>
