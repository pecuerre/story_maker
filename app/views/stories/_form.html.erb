<%= form_with model: story,
  url: story.persisted? ? universe_story_path(id: story) : universe_stories_path,
  class: "form-surface" do |form| %>
  <% if story.errors.any? %>
    <div class="alert alert-danger" role="alert">
      <h2 class="h6"><%= pluralize(story.errors.count, "error") %> prevented this story from being saved:</h2>
      <ul class="mb-0">
        <% story.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, class: "form-control", required: true, autofocus: true %>
  </div>

  <div>
    <%= form.label :description, class: "form-label" %>
    <%= form.text_area :description, class: "form-control", rows: 5 %>
  </div>

  <div class="form-actions">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", story.persisted? ? universe_story_path(id: story) : universe_stories_path,
      class: "btn btn-link" %>
  </div>
<% end %>
