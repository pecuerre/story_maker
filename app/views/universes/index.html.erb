<% content_for :title, "Universes" %>

<h1>Universes</h1>

<table id="universes" class="index_table table">
  <thead>
    <tr>
      <th>Name</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <div id="universes">
      <% @universes.each do |universe| %>
        <tr>
          <td>
            <%= universe.name %>
            <% if universe.private? %>
              <span class="badge bg-warning">Private</span>
            <% else %>
              <span class="badge bg-success">Public</span>
            <% end %>
          </td>
          <td>
            <%= link_to "Details", universe %>
            <%= link_to "Edit", edit_universe_path(universe) %>
            <%= link_to "Destroy", universe, method: :delete %>
          </td>
        </tr>
      <% end %>
    </div>
  </tbody>
</table>

<%= link_to "New universe", new_universe_path %>
