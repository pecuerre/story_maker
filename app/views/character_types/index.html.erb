<% content_for :title, "Character types" %>

<h1>Character types</h1>

<%= render "shared/taxonomy_tree",
  nodes: @character_types,
  new_url: ->(parent = nil) { new_universe_character_type_path(parent_id: parent&.id) },
  create_url: universe_character_types_path(),
  edit_url: ->(character_type) { edit_universe_character_type_path(id: character_type) },
  update_url: ->(character_type) { universe_character_type_path(id: character_type) },
  delete_url: ->(character_type) { universe_character_type_path(id: character_type) },
  model_param: "character_type",
  modal_fields: character_type_taxonomy_fields(Current.universe.character_types.order(:position, :id)) %>
