<% content_for :title, t("scenes.characters.document_title", scene: @scene.name) %>
<% editable = can_write_universe? %>

<%# The editor's wrapper has to contain the modal *and* every control that opens
    it, which is why the page header is inside it rather than beside it. %>
<div
  <% if editable %>data-controller="modal-form"<% end %>
  data-modal-form-model-param-value="scene_character"
  data-modal-form-response-value="json"
  data-modal-form-create-title-value="<%= t("scenes.characters.add") %>">
  <%= render "shared/page_header",
    title: t("characters.title"),
    eyebrow: t("shared.eyebrow.scene", scene: @scene.name),
    description: t("scenes.characters.description"),
    count: @participants.count,
    count_label: "character" do %>
    <%= link_to t("scenes.back_to_details"), universe_story_scene_path(story_id: @story, id: @scene), class: "btn btn-outline-secondary" %>
    <% if editable %>
      <button type="button" class="btn btn-primary"
        data-action="modal-form#open"
        data-modal-form-url="<%= universe_story_scene_scene_characters_path(story_id: @story, scene_id: @scene) %>"
        data-modal-form-method="post"
        data-modal-form-title="<%= t("scenes.characters.add") %>"
        data-modal-form-values-value="{}">
        <i class="bi bi-plus-lg" aria-hidden="true"></i>
        <span><%= t("scenes.characters.add") %></span>
      </button>
    <% end %>
  <% end %>

  <%= render "scenes/workspace_tabs" %>

  <%# Only the stored links are editable. A derived speaker has no link of its
      own, so its row explains where the participation comes from instead of
      offering a control that would edit nothing. %>
  <% if @participants.any? %>
    <div class="content-surface entity-list">
      <div class="list-group list-group-flush">
        <% @participants.entries.each do |entry| %>
          <div class="list-group-item entity-row d-flex align-items-start gap-3">
            <div class="entity-copy flex-grow-1">
              <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="entity-title"><%= entry.character.name %></span>
                <% scene_character_participation_badges(entry).each do |badge| %>
                  <span class="badge rounded-pill text-bg-light border"><%= badge %></span>
                <% end %>
              </div>
              <%# The role is the author's own free text, so it is interpolated into
                  the row's label rather than translated. %>
              <div class="entity-description">
                <% if entry.explicitly_linked? %>
                  <%= t("scenes.participation.role", role: scene_character_role_label(entry)) %>
                <% end %>
              </div>
              <% if entry.speaks? %>
                <div class="form-text">
                  <%= t("scenes.participation.speaks_in_html",
                    elements: scene_character_speaking_in(entry).to_sentence) %>
                </div>
              <% end %>
            </div>

            <div class="entity-row-actions d-flex align-items-center gap-2 flex-wrap justify-content-end">
              <%= record_details_link universe_character_path(id: entry.character), record: entry.character %>

              <% if editable && entry.explicitly_linked? %>
                <div class="dropdown row-actions">
                  <button class="btn btn-sm btn-light border dropdown-toggle" type="button"
                    id="<%= dom_id(entry.link) %>-actions"
                    data-bs-toggle="dropdown"
                    aria-expanded="false"
                    aria-label="<%= t("scenes.participation.actions_for", name: entry.character.name, scene: @scene.name) %>">
                    <i class="bi bi-three-dots" aria-hidden="true"></i>
                  </button>
                  <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="<%= dom_id(entry.link) %>-actions">
                    <li>
                      <button type="button" class="dropdown-item"
                        data-action="modal-form#open"
                        data-modal-form-url="<%= universe_story_scene_scene_character_path(story_id: @story, scene_id: @scene, id: entry.link) %>"
                        data-modal-form-method="patch"
                        data-modal-form-title="<%= t("scenes.characters.edit_role") %>"
                        data-modal-form-values-value="<%= scene_character_fields_json(entry.link) %>">
                        <i class="bi bi-pencil me-2" aria-hidden="true"></i><%= t("scenes.characters.edit_role") %>
                      </button>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                      <button type="button" class="dropdown-item text-danger"
                        data-action="modal-form#destroy"
                        data-modal-form-url="<%= universe_story_scene_scene_character_path(story_id: @story, scene_id: @scene, id: entry.link) %>"
                        data-modal-form-confirm="<%= t("scenes.participation.remove.character",
                          name: entry.character.name, scene: @scene.name) %>">
                        <i class="bi bi-trash me-2" aria-hidden="true"></i><%= t("scenes.participation.remove_label") %>
                      </button>
                    </li>
                  </ul>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <%= render "shared/empty_state",
      title: t("scenes.characters.empty_title"),
      description: t("scenes.characters.empty_description"),
      icon: "person" %>
  <% end %>

  <% if editable %>
    <div class="modal fade" tabindex="-1"
      aria-labelledby="scene-character-modal-title"
      aria-hidden="true"
      data-modal-form-target="modal">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h2 class="modal-title fs-5" id="scene-character-modal-title" data-modal-form-target="title"><%= t("scenes.characters.add") %></h2>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t("shared.form.close") %>"></button>
          </div>
          <%= form_with scope: :scene_character,
            url: universe_story_scene_scene_characters_path(story_id: @story, scene_id: @scene),
            method: :post,
            data: { modal_form_target: "form", action: "modal-form#save" } do |form| %>
            <div class="modal-body">
              <%= render "shared/modal_errors" %>

              <div class="mb-3">
                <%= form.label :character_id, t("scenes.characters.form.character"), class: "form-label" %>
                <%# The blank option's value is the empty string the form stores, so
                    it is not translated; the character ids beside the names are
                    record ids and are not translated either. %>
                <%= form.select :character_id, scene_character_choices(@character_options),
                  { include_blank: t("scenes.characters.form.choose_character") },
                  class: "form-select", required: true %>
                <div class="form-text"><%= t("scenes.characters.form.character_hint") %></div>
              </div>

              <div>
                <%= form.label :role, t("scenes.characters.form.role"), class: "form-label" %>
                <%= form.text_field :role, class: "form-control" %>
                <%# The examples are chrome too — they are words the interface
                    suggests — so they are their own key, interpolated into the one
                    hint all three tabs share. %>
                <div class="form-text"><%= t("scenes.participation.role_hint",
                  examples: t("scenes.characters.role_examples")) %></div>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t("shared.form.cancel") %></button>
              <%= form.submit t("scenes.characters.save"), class: "btn btn-primary", data: { modal_form_target: "submit" } %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>