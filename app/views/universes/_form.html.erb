<%= form_with(model: universe, class: "form-surface") do |form| %>
  <% if universe.errors.any? %>
    <%= render "shared/error_summary", record: universe, subject: t("universe", count: 1) %>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, class: "form-control", required: true, autofocus: true %>
  </div>

  <div class="mb-3">
    <%# Optional, and blank on a fresh open: an address set here wins for this
        save, while a blank one leaves `HasSlug` to derive it from the name.
        Prefilling would show a value the callback silently replaces on a
        rename, and a cleared field would republish the universe under a new
        address on an unrelated save. A refused save keeps what the author
        actually typed, because this field is the answer to the error it shows. %>
    <% typed_slug = universe.persisted? && universe.slug != universe.slug_in_database %>
    <%= form.label :slug, t("universes.form.slug"), class: "form-label" %>
    <%= form.text_field :slug, class: "form-control", value: (typed_slug ? universe.slug : "") %>
    <div class="form-text">
      <%= universe.persisted? ? t("universes.form.slug_hint_current", slug: universe.slug) : t("universes.form.slug_hint") %>
    </div>
  </div>

  <%= render "shared/photo_field", param: "universe", current_url: record_photo_url(universe) %>

  <div class="form-check form-switch mb-2">
    <%= form.check_box :private, class: "form-check-input" %>
    <%= form.label :private, t("universes.form.private"), class: "form-check-label" %>
  </div>
  <p class="form-text">
    <%= t("universes.form.private_hint") %>
  </p>

  <div class="mb-3">
    <%# The options come from the model's own list rather than being spelled out
        here, so the select can only offer a value the model accepts. The stored
        value travels in the form field and is therefore not translated; the word
        beside it is a key, and each label carries its own short meaning so the
        three modes can be told apart without opening anything. %>
    <%= form.label :collaboration_mode, class: "form-label" %>
    <%= form.select :collaboration_mode,
      Universe::COLLABORATION_MODES.map { |mode| [ t("universes.form.collaboration_modes.#{mode}"), mode ] },
      {}, class: "form-select" %>
    <div class="form-text">
      <%= t("universes.form.collaboration_mode_hint") %>
    </div>
  </div>

  <div class="form-actions">
    <%# The default submit label comes from Rails' English-only
        `helpers.submit.*`, so the label is named here. %>
    <%= form.submit(universe.persisted? ? t("universes.form.submit_update") : t("universes.form.submit_create"),
      class: "btn btn-primary") %>
    <%= link_to t("shared.form.cancel"), universe.persisted? ? universe_path(universe) : universes_path, class: "btn btn-link" %>
  </div>
<% end %>
