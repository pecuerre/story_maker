<% content_for :title, @scene.name %>

<%= render "shared/page_header",
  title: @scene.name,
  eyebrow: t("shared.eyebrow.story", story: @story.name),
  description: t("scenes.show.description",
    position: @scene.position + 1, total: @scene_total, story: @story.name) do %>
  <%# The page's primary action leads the action group, as it does on every
      header: the controls that follow it are navigation and conversation, not
      a second destination for the same task. %>
  <% if can_write_universe? %>
    <%= link_to t("scenes.edit_title"), edit_universe_story_scene_path(story_id: @story, id: @scene), class: "btn btn-primary" %>
  <% end %>
  <%= link_to t("scenes.show.all_scenes"), universe_story_scenes_path(story_id: @story), class: "btn btn-outline-secondary" %>
  <%= discussion_control(@scene) %>
<% end %>

<%= render "scenes/workspace_tabs" %>

<%# The Elements come first, before the identity card. Scene Details is the page a
    writer returns to in order to write, and the identity facts are reference
    matter around the prose rather than the prose's gateway: a page that opens
    with twelve facts and puts the writing below them makes the next block the
    last thing a writer scrolls to. They stay on this page, in reading order,
    rather than moving to a second one. %>
<%= render "scenes/elements" %>

<%# Scene Details is the canonical, inspectable destination: the same content is
    shown to writers and read-only viewers, and only writers get the editor link. %>
<div class="surface-card p-3 scene-identity">
  <%# The photo sits in the left column of the same row as the identity facts,
      exactly as it does on every `shared/_record_details` page. With no photo
      the facts keep the whole card, which is how this page looked before. %>
  <% if @scene.photo %>
    <div class="row g-4 align-items-start">
      <div class="col-12 col-sm-5 col-md-4 col-lg-3">
        <%= render "shared/record_photo", photo: @scene.photo, name: @scene.name %>
      </div>
      <div class="col-12 col-sm-7 col-md-8 col-lg-9">
        <%= render "scenes/show_identity", scene: @scene, story: @story %>
      </div>
    </div>
  <% else %>
    <%= render "scenes/show_identity", scene: @scene, story: @story %>
  <% end %>
</div>

<%# The drafting contract closes the page: it is the writer's note about the
    scene as a whole, not one of its identity facts. It is a browser display
    preference, so hiding it draws nothing here; the stored note and the import
    that wrote it are untouched. %>
<% if drafting_contract_visible? %>
  <section class="detail-section scene-drafting-contract">
    <h2 class="h5 mb-3"><%= t("scenes.show.facts.drafting_contract") %></h2>
    <% if @scene.drafting_contract.present? %>
      <div class="drafting-contract-body text-break"><%= drafting_contract_html(@scene) %></div>
    <% else %>
      <p class="mb-0 text-body-secondary"><%= t("scenes.show.facts.drafting_contract_blank") %></p>
    <% end %>
  </section>
<% end %>
