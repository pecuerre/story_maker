<% content_for :title, "Items" %>
<% empty_description = can_write_universe? ? "Items belong to the universe and can be used to track objects, resources, and ownership across every story. Add the first one to begin." : "Items belong to the universe and are shared by all of its stories." %>

<div
  <% if can_write_universe? %>data-controller="modal-form"<% end %>
  data-modal-form-model-param-value="item"
  data-modal-form-create-title-value="New item">
  <%= render "shared/page_header",
    title: "Items",
    eyebrow: "Universe Bible",
    description: "Objects and resources whose details are shared by every story in this universe.",
    count: @items.size,
    count_label: "item" do %>
    <% if can_write_universe? %>
      <button type="button" class="btn btn-primary"
        data-action="modal-form#open"
        data-modal-form-url="<%= universe_items_path %>"
        data-modal-form-method="post"
        data-modal-form-title="New item"
        data-modal-form-values-value="{}">
        <i class="bi bi-plus-lg" aria-hidden="true"></i>
        <span>Add item</span>
      </button>
    <% end %>
  <% end %>

  <%= render "shared/content_tabs",
    aria_label: "Item workspace",
    tabs: [
      { label: "Items", path: universe_items_path, controller: :items },
      { label: "Ownerships", path: universe_ownerships_path, controller: :ownerships }
    ] %>

  <% if @items.any? %>
    <div class="content-surface entity-list">
      <div class="list-group list-group-flush">
        <% @items.each do |item| %>
          <div class="list-group-item entity-row d-flex align-items-center gap-3">
            <div class="entity-copy flex-grow-1">
              <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="entity-title"><%= item.name %></span>
                <%= entity_tag_badge(item) %>
              </div>
              <% if item.description.present? %>
                <div class="entity-description"><%= item.description %></div>
              <% end %>
            </div>

            <%= record_details_link universe_item_path(id: item), record: item %>

            <%= render "shared/row_actions",
              record: item,
              label: "item",
              record_name: item.name,
              edit_url: universe_item_path(id: item),
              delete_url: universe_item_path(id: item),
              values: item_fields_json(item) %>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <%= render "shared/empty_state",
      title: "No items yet",
      description: empty_description,
      icon: "box-seam" %>
  <% end %>

  <% if can_write_universe? %>
    <div class="modal fade" tabindex="-1"
    aria-labelledby="item-modal-title"
    aria-hidden="true"
    data-modal-form-target="modal">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title fs-5" id="item-modal-title" data-modal-form-target="title">New item</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <%= form_with scope: :item, url: universe_items_path, method: :post,
          data: { modal_form_target: "form" } do |form| %>
          <div class="modal-body">
            <div class="mb-3">
              <%= form.label :name, class: "form-label" %>
              <%= form.text_field :name, class: "form-control", required: true %>
            </div>
            <div class="mb-3">
              <%= form.label :item_tag_ids, "Item tags", class: "form-label" %>
              <%= form.collection_select :item_tag_ids, @item_tags, :id, :name,
                {},
                { class: "form-select", multiple: true, data: { controller: "tom-select" } } %>
            </div>
            <div>
              <%= form.label :description, class: "form-label" %>
              <%= form.text_area :description, class: "form-control", rows: 4 %>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <%= form.submit "Save item", class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  <% end %>
</div>
