<% content_for :title, "Sections" %>

<%= render "shared/taxonomy_tree",
  title: "Sections",
  description: "Organize this story into a hierarchy of books, chapters, acts, scenes, or any structure you need.",
  eyebrow: "Story: #{@story.name}",
  count: @story.sections.count,
  count_label: "section",
  new_label: "Add section",
  tabs_aria_label: "Story workspace",
  tabs: [
    { label: "Sections", path: universe_story_sections_path(story_id: @story), controller: :sections }
  ],
  empty_description: "Add a section, then drag rows to create the outline for this story.",
  nodes: @sections,
  new_url: ->(parent = nil) { new_universe_story_section_path(story_id: @story, parent_id: parent&.id) },
  create_url: universe_story_sections_path(story_id: @story),
  edit_url: ->(section) { edit_universe_story_section_path(story_id: @story, id: section) },
  update_url: ->(section) { universe_story_section_path(story_id: @story, id: section) },
  delete_url: ->(section) { universe_story_section_path(story_id: @story, id: section) },
  model_param: "section",
  taxonomy_field: "section_tag_ids",
  modal_fields: section_taxonomy_fields(@section_tags) %>
