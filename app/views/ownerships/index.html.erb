<% content_for :title, "Ownerships" %>
<% empty_description = can_write_universe? ? "Connect a character to an item to record present or historical ownership." : "Ownership records in this universe will appear here once they have been added." %>

<div
  <% if can_write_universe? %>data-controller="modal-form"<% end %>
  data-modal-form-model-param-value="ownership"
  data-modal-form-create-title-value="New ownership">
  <%= render "shared/page_header",
    title: "Ownerships",
    eyebrow: "Items",
    description: "Track which characters own items and when those relationships change.",
    count: @ownerships.size,
    count_label: "ownership" do %>
    <% if can_write_universe? %>
      <button type="button" class="btn btn-primary"
        data-action="modal-form#open"
        data-modal-form-url="<%= universe_ownerships_path %>"
        data-modal-form-method="post"
        data-modal-form-title="New ownership"
        data-modal-form-values-value="{}">
        <i class="bi bi-plus-lg" aria-hidden="true"></i>
        <span>Add ownership</span>
      </button>
    <% end %>
  <% end %>

  <%= render "shared/content_tabs",
    aria_label: "Item workspace",
    tabs: [
      { label: "Items", path: universe_items_path, controller: :items },
      { label: "Ownerships", path: universe_ownerships_path, controller: :ownerships }
    ] %>

  <% if @ownerships.any? %>
    <div class="content-surface entity-list">
      <div class="list-group list-group-flush">
        <% @ownerships.each do |ownership| %>
          <% ownership_name = "#{ownership.character.name} and #{ownership.item.name}" %>
          <div class="list-group-item entity-row d-flex align-items-center gap-3">
            <div class="entity-copy flex-grow-1">
              <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="entity-title"><%= ownership.item.name %></span>
                <%= entity_tag_badge(ownership) %>
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                <span class="entity-title"><%= ownership.character.name %></span>
              </div>
              <% if ownership.description.present? %>
                <div class="entity-description"><%= ownership.description %></div>
              <% end %>
            </div>

            <%= render "shared/row_actions",
              record: ownership,
              label: "ownership",
              record_name: ownership_name,
              edit_url: universe_ownership_path(id: ownership),
              delete_url: universe_ownership_path(id: ownership),
              values: ownership_fields_json(ownership) %>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <%= render "shared/empty_state",
      title: "No ownerships yet",
      description: empty_description,
      icon: "person-bounding-box" %>
  <% end %>

  <% if can_write_universe? %>
    <div class="modal fade" tabindex="-1"
    aria-labelledby="ownership-modal-title"
    aria-hidden="true"
    data-modal-form-target="modal">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title fs-5" id="ownership-modal-title" data-modal-form-target="title">New ownership</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <%= form_with scope: :ownership,
          url: universe_ownerships_path,
          method: :post,
          data: { modal_form_target: "form" } do |form| %>
          <div class="modal-body">
            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <%= form.label :item_id, "Item", class: "form-label" %>
                <%= form.collection_select :item_id, @items, :id, :name,
                  { prompt: "Select an item" },
                  { class: "form-select", required: true } %>
              </div>
              <div class="col-md-6">
                <%= form.label :character_id, "Character", class: "form-label" %>
                <%= form.collection_select :character_id, @characters, :id, :name,
                  { prompt: "Select a character" },
                  { class: "form-select", required: true } %>
              </div>
            </div>
            <div class="mb-3">
              <%= form.label :ownership_tag_ids, "Ownership tags", class: "form-label" %>
              <%= form.collection_select :ownership_tag_ids, @ownership_tags, :id, :name,
                {},
                { class: "form-select", multiple: true, data: { controller: "tom-select" } } %>
            </div>
            <div class="mb-3">
              <%= form.label :description, class: "form-label" %>
              <%= form.text_area :description, class: "form-control", rows: 4 %>
            </div>
            <div class="row g-3">
              <div class="col-md-6">
                <%= form.label :from_date, "From", class: "form-label" %>
                <%= form.datetime_local_field :from_date, class: "form-control" %>
              </div>
              <div class="col-md-6">
                <%= form.label :to_date, "To", class: "form-label" %>
                <%= form.datetime_local_field :to_date, class: "form-control" %>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <%= form.submit "Save ownership", class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  <% end %>
</div>
