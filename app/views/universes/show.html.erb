<% content_for :title, @universe.name %>
<%# The stories of this universe are listed here instead of behind a second
    click: entering a universe is the point where the next story is chosen. This
    is the same ordered list the navbar's Story switcher shows, reused from its
    per-request memo, and the header's "All stories" page stays for the full
    list with its own actions. %>
<% stories = nav_stories %>

<%= render "shared/page_header",
  title: @universe.name,
  eyebrow: "Universe",
  description: "The shared world and story collection for this workspace." do %>
  <%= link_to "All stories", universe_stories_path, class: "btn btn-primary" %>
  <% if can_administer_universe? %>
    <%= link_to "Members", universe_memberships_path, class: "btn btn-outline-secondary" %>
    <div class="dropdown">
      <button class="btn btn-outline-secondary dropdown-toggle" type="button"
        data-bs-toggle="dropdown" aria-expanded="false" aria-label="Universe actions">
        <i class="bi bi-three-dots" aria-hidden="true"></i>
      </button>
      <ul class="dropdown-menu dropdown-menu-end">
        <li><%= link_to "Edit universe", edit_universe_path(@universe), class: "dropdown-item" %></li>
        <li><hr class="dropdown-divider"></li>
        <li>
          <%= button_to "Delete universe", universe_path(@universe),
            method: :delete,
            class: "dropdown-item text-danger",
            data: { turbo_confirm: "Delete #{@universe.name} and all of its content?" } %>
        </li>
      </ul>
    </div>
  <% end %>
<% end %>

<div class="row g-3">
  <div class="col-lg-7">
    <section class="surface-card h-100 p-4" aria-labelledby="universe-stories-title">
      <div class="page-eyebrow">Stories</div>
      <h2 class="h4 mb-3" id="universe-stories-title"><%= pluralize(stories.size, "story") %></h2>

      <% if stories.any? %>
        <div class="list-group list-group-flush">
          <% stories.each do |story| %>
            <div class="list-group-item entity-row px-0 d-flex align-items-center gap-3">
              <div class="entity-copy flex-grow-1">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                  <%= link_to story.name, universe_story_path(id: story), class: "entity-title text-break" %>
                  <% if Current.story == story %>
                    <span class="badge text-bg-primary">Current</span>
                  <% end %>
                </div>
                <% if story.description.present? %>
                  <div class="entity-description"><%= story.description %></div>
                <% end %>
              </div>
              <%= link_to "Open", universe_story_path(id: story),
                class: "btn btn-sm btn-outline-primary flex-shrink-0",
                aria: { label: "Open #{story.name}" } %>
            </div>
          <% end %>
        </div>
      <% else %>
        <%= render "shared/empty_state",
          title: "No stories yet",
          description: can_write_universe? ?
            "A story holds the plot, sections, and scenes of this universe while sharing its world. Create the first one from the Story menu." :
            "This universe has no stories to show yet.",
          icon: "books" %>
      <% end %>
    </section>
  </div>

  <div class="col-lg-5">
    <div class="surface-card h-100 p-4">
      <div class="page-eyebrow">Universe Bible</div>
      <h2 class="h4">Shared world</h2>
      <p class="text-body-secondary">Characters, places, events, items, and their relationships live at universe scope.</p>
      <div class="d-flex flex-wrap gap-2">
        <%= link_to "Characters", universe_characters_path, class: "btn btn-outline-secondary btn-sm" %>
        <%= link_to "Locations", universe_locations_path, class: "btn btn-outline-secondary btn-sm" %>
        <%= link_to "Events", universe_events_path, class: "btn btn-outline-secondary btn-sm" %>
        <%= link_to "Timeline", universe_timeline_path, class: "btn btn-outline-secondary btn-sm" %>
      </div>
    </div>
  </div>
</div>
