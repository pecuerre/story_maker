<% record = local_assigns.fetch(:record) %>
<% editable = local_assigns.fetch(:editable) { can_write_universe?(universe_for_record(record)) } %>
<% if editable %>
  <% label = local_assigns[:label] || record.model_name.human.downcase %>
  <% record_name = local_assigns[:record_name] || record_label(record) %>
  <% values = local_assigns.fetch(:values, "{}") %>
  <%# Deletion consequences are mandatory copy for records with dependents: the
      default stays short, and a caller that owns dependents passes the full
      template so an unannounced cascade is never possible. %>
  <% confirm_text = local_assigns[:confirm_text] || t("shared.row_actions.delete_confirm", name: record_name) %>
  <%# `:turbo` is the HTML redirect/re-render flow. `:json` is for a row whose
      destroy action is JSON-only: there is no Turbo form to follow, so the modal
      controller issues the DELETE, confirms the copy, and refreshes the list. %>
  <% delete_via = local_assigns.fetch(:delete_via, :turbo) %>
  <% actions_id = "#{dom_id(record)}-actions" %>

  <div class="dropdown row-actions">
    <button class="btn btn-sm btn-light border dropdown-toggle" type="button"
      id="<%= actions_id %>"
      data-bs-toggle="dropdown"
      aria-expanded="false"
      aria-label="<%= t("shared.row_actions.actions_for", name: record_name) %>">
      <i class="bi bi-three-dots" aria-hidden="true"></i>
    </button>
    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="<%= actions_id %>">
      <li>
        <%# The row's own id travels with its trigger because one modal form
            serves every row: a select that must not offer the record being
            edited (Event's three temporal references) can only drop that option
            once it knows which row opened the modal. %>
        <button type="button" class="dropdown-item"
          data-action="modal-form#open"
          data-modal-form-url="<%= local_assigns.fetch(:edit_url) %>"
          data-modal-form-method="patch"
          data-modal-form-record-id="<%= record.id %>"
          data-modal-form-title="<%= t("shared.row_actions.edit_title", label: label) %>"
          data-modal-form-values-value="<%= values %>">
          <i class="bi bi-pencil me-2" aria-hidden="true"></i><%= t("shared.row_actions.edit") %>
        </button>
      </li>
      <li><hr class="dropdown-divider"></li>
      <li>
        <% if delete_via == :json %>
          <button type="button" class="dropdown-item text-danger"
            data-action="modal-form#destroy"
            data-modal-form-url="<%= local_assigns.fetch(:delete_url) %>"
            data-modal-form-confirm="<%= confirm_text %>">
            <i class="bi bi-trash me-2" aria-hidden="true"></i><%= t("shared.row_actions.delete") %>
          </button>
        <% else %>
          <%= button_to local_assigns.fetch(:delete_url),
            method: :delete,
            class: "dropdown-item text-danger",
            data: { turbo_confirm: confirm_text } do %>
            <i class="bi bi-trash me-2" aria-hidden="true"></i><%= t("shared.row_actions.delete") %>
          <% end %>
        <% end %>
      </li>
    </ul>
  </div>
<% end %>
