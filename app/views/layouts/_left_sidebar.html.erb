<div class="py-4">

<% if Current.universe.present? %>
  <% menu_counts = Current.universe.menu_counts %>

  <%# WHAT and HOW are story-scoped, so they stay hidden until a story is
      selected in the top bar. The stories menu itself lives there too. %>
  <% if Current.story.present? %>
    <% section_count = Current.story.menu_section_count %>

    <div class="card flex-column mb-4 nav">
      <div class="card-header border-primary text-primary">
        WHAT
      </div>
      <ul class="list-group list-group-flush">
        <li class="list-group-item">
          <%= link_to icon_text_count("diagram-3", "Plot"), "#",
            class: "nav-link px-0 link-secondary" %>
        </li>
        <li class="list-group-item">
          <%= link_to icon_text_count("globe", "World Building"), "#",
            class: "nav-link px-0 link-secondary" %>
        </li>
        <li class="list-group-item">
          <%= link_to icon_text_count("bricks", "Tropes"), "#",
            class: "nav-link px-0 link-secondary" %>
        </li>
      </ul>
    </div>

    <div class="card flex-column mb-4 nav">
      <div class="card-header border-primary text-primary">
        HOW
      </div>
      <ul class="list-group list-group-flush">
        <li class="list-group-item">
          <%= link_to icon_text_count("film", "Scenes"), "#",
            class: "nav-link px-0 link-secondary" %>
        </li>
        <li class="list-group-item <%= active_if(:sections, :section_tags) %>">
          <div class="d-flex align-items-center justify-content-between">
            <%= link_to icon_text_count("list-nested", "Sections", section_count),
              universe_story_sections_path(story_id: Current.story),
              class: "nav-link px-0#{active_if(:sections)}"
            %>
            <% if visible?(:sections, :section_tags) %>
              <%= link_to icon("tags"),
                universe_story_section_tags_path(story_id: Current.story),
                class: "nav-link px-0#{active_if(:section_tags)}"
              %>
            <% end %>
          </div>
        </li>
      </ul>
    </div>
  <% end %>


  <div class="card flex-column mb-4 nav">
    <div class="card-header border-danger text-danger">
      WHO
    </div>
    <ul class="list-group list-group-flush">
      <li class="list-group-item <%= active_if(:characters, :character_tags) %>">
        <div class="d-flex align-items-center justify-content-between">
          <%= link_to icon_text_count("person", "Characters", menu_counts[:characters]),
            universe_characters_path(),
            class: "nav-link text-danger px-0#{active_if(:characters)}"
          %>
          <% if visible?(:characters, :character_tags) %>
            <%= link_to icon("tags"),
              universe_character_tags_path(),
              class: "nav-link text-danger px-0#{active_if(:character_tags)}"
            %>
          <% end %>
        </div>
      </li>
      <li class="list-group-item <%= active_if(:relations, :relation_tags) %>">
        <div class="d-flex align-items-center justify-content-between">
          <%= link_to icon_text_count("people", "Relations", menu_counts[:relations]),
            universe_relations_path(),
            class: "nav-link text-danger px-0#{active_if(:relations)}"
          %>
          <% if visible?(:relations, :relation_tags) %>
            <%= link_to icon("tags"),
              universe_relation_tags_path(),
              class: "nav-link text-danger px-0#{active_if(:relation_tags)}"
            %>
          <% end %>
        </div>
      </li>
      <li class="list-group-item">
        <%= link_to icon_text_count("person-plus", "Meetings"), "#",
          class: "nav-link px-0 link-secondary" %>
      </li>
      <li class="list-group-item">
        <%= link_to icon_text_count("chat-dots", "Dialogs"),
          "#", class: "nav-link px-0 link-secondary" %>
      </li>
    </ul>
  </div>

  <div class="card flex-column mb-4 nav">
    <div class="card-header border-danger text-danger">
      WHERE
    </div>
    <ul class="list-group list-group-flush">
      <li class="list-group-item <%= active_if(:locations, :location_tags) %>">
        <div class="d-flex align-items-center justify-content-between">
          <%= link_to icon_text_count("geo-alt", "Locations", menu_counts[:locations]),
            universe_locations_path(),
            class: "nav-link text-danger px-0#{active_if(:locations)}"
          %>
          <% if visible?(:locations, :location_tags) %>
            <%= link_to icon("tags"),
              universe_location_tags_path(),
              class: "nav-link text-danger px-0#{active_if(:location_tags)}"
            %>
          <% end %>
        </div>
      </li>
      <li class="list-group-item">
        <%= link_to icon_text_count("sign-turn-right", "Routes"), "#",
          class: "nav-link px-0 link-secondary" %>
      </li>
      <li class="list-group-item">
        <%= link_to icon_text_count("map", "Map"), "#",
          class: "nav-link px-0 link-secondary" %>
      </li>
      <li class="list-group-item">
        <%= link_to icon_text_count("rulers", "Distances"), "#",
          class: "nav-link px-0 link-secondary" %>
      </li>
      <li class="list-group-item">
        <%= link_to icon_text_count("bounding-box-circles", "Connections"), "#",
          class: "nav-link px-0 link-secondary" %>
      </li>
    </ul>
  </div>

  <div class="card flex-column mb-4 nav">
    <div class="card-header border-danger text-danger">
      WHEN
    </div>
    <ul class="list-group list-group-flush">
      <li class="list-group-item <%= active_if(:events, :event_tags) %>">
        <div class="d-flex align-items-center justify-content-between">
          <%= link_to icon_text_count("calendar-event", "Events", menu_counts[:events]),
            universe_events_path(),
            class: "nav-link text-danger px-0#{active_if(:events)}"
          %>
          <% if visible?(:events, :event_tags) %>
            <%= link_to icon("tags"),
              universe_event_tags_path(),
              class: "nav-link text-danger px-0#{active_if(:event_tags)}"
            %>
          <% end %>
        </div>
      </li>
      <li class="list-group-item <%= active_if(:timeline) %>">
        <%= link_to icon_text_count("calendar-range", "Timeline"),
          universe_timeline_path(),
          class: "nav-link text-danger px-0#{active_if(:timeline)}" %>
      </li>
    </ul>
  </div>

  <div class="card flex-column mb-4 nav">
    <div class="card-header border-danger text-danger">
      WITH
    </div>
    <ul class="list-group list-group-flush">
      <li class="list-group-item <%= active_if(:items, :item_tags) %>">
        <div class="d-flex align-items-center justify-content-between">
          <%= link_to icon_text_count("box-seam", "Items", menu_counts[:items]),
            universe_items_path(),
            class: "nav-link text-danger px-0#{active_if(:items)}"
          %>
          <% if visible?(:items, :item_tags) %>
            <%= link_to icon("tags"),
              universe_item_tags_path(),
              class: "nav-link text-danger px-0#{active_if(:item_tags)}"
            %>
          <% end %>
        </div>
      </li>
      <li class="list-group-item <%= active_if(:ownerships, :ownership_tags) %>">
        <div class="d-flex align-items-center justify-content-between">
          <%= link_to icon_text_count("person-bounding-box", "Ownerships", menu_counts[:ownerships]),
            universe_ownerships_path(),
            class: "nav-link text-danger px-0#{active_if(:ownerships)}"
          %>
          <% if visible?(:ownerships, :ownership_tags) %>
            <%= link_to icon("tags"),
              universe_ownership_tags_path(),
              class: "nav-link text-danger px-0#{active_if(:ownership_tags)}"
            %>
          <% end %>
        </div>
      </li>
    </ul>
  </div>
<% end %>

</div>