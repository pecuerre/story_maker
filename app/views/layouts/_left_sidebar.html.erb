<% menu_counts = Current.universe.menu_counts %>
<% section_count = Current.story&.menu_section_count %>

<div class="sidebar-context">
  <div class="sidebar-eyebrow">Current universe</div>
  <h2 class="sidebar-universe-name"><%= Current.universe.name %></h2>
  <% if Current.story.present? %>
    <p class="sidebar-story-name">Story: <%= Current.story.name %></p>
  <% end %>
</div>

<nav class="workspace-navigation" aria-label="Universe and story navigation">
  <section class="sidebar-section" aria-labelledby="story-workspace-title">
    <h3 class="sidebar-section-title" id="story-workspace-title">Story workspace</h3>
    <ul class="sidebar-list">
      <% if Current.story.present? %>
        <%= render "shared/sidebar_link",
          icon: "house",
          label: "Story overview",
          path: universe_story_path(id: Current.story),
          controllers: %i[ stories ] %>

        <%= render "shared/sidebar_link",
          icon: "list-nested",
          label: "Sections",
          count: section_count,
          path: universe_story_sections_path(story_id: Current.story),
          controllers: %i[ sections ] %>
      <% else %>
        <%= render "shared/sidebar_link",
          icon: "books",
          label: "All stories",
          path: universe_stories_path,
          controllers: %i[ stories ] %>
        <p class="sidebar-hint">Select a story to work on its sections and story-specific structure.</p>
      <% end %>
    </ul>

    <%= link_to "New story", new_universe_story_path, class: "btn btn-outline-primary btn-sm w-100 sidebar-create-link" %>
  </section>

  <section class="sidebar-section" aria-labelledby="universe-bible-title">
    <h3 class="sidebar-section-title" id="universe-bible-title">Universe Bible</h3>

    <h4 class="sidebar-group-title">People</h4>
    <ul class="sidebar-list">
      <%= render "shared/sidebar_link",
        icon: "person",
        label: "Characters",
        count: menu_counts[:characters],
        path: universe_characters_path,
        controllers: %i[ characters ] %>

      <%= render "shared/sidebar_link",
        icon: "people",
        label: "Relations",
        count: menu_counts[:relations],
        path: universe_relations_path,
        controllers: %i[ relations ] %>
    </ul>

    <h4 class="sidebar-group-title">Places</h4>
    <ul class="sidebar-list">
      <%= render "shared/sidebar_link",
        icon: "geo-alt",
        label: "Locations",
        count: menu_counts[:locations],
        path: universe_locations_path,
        controllers: %i[ locations ] %>
    </ul>

    <h4 class="sidebar-group-title">Time</h4>
    <ul class="sidebar-list">
      <%= render "shared/sidebar_link",
        icon: "calendar-event",
        label: "Events",
        count: menu_counts[:events],
        path: universe_events_path,
        controllers: %i[ events ] %>

      <%= render "shared/sidebar_link",
        icon: "calendar-range",
        label: "Timeline",
        path: universe_timeline_path,
        controllers: %i[ timeline ] %>
    </ul>

    <h4 class="sidebar-group-title">Objects</h4>
    <ul class="sidebar-list">
      <%= render "shared/sidebar_link",
        icon: "box-seam",
        label: "Items",
        count: menu_counts[:items],
        path: universe_items_path,
        controllers: %i[ items ] %>

      <%= render "shared/sidebar_link",
        icon: "person-bounding-box",
        label: "Ownerships",
        count: menu_counts[:ownerships],
        path: universe_ownerships_path,
        controllers: %i[ ownerships ] %>
    </ul>
  </section>

  <section class="sidebar-section" aria-labelledby="configuration-title">
    <h3 class="sidebar-section-title" id="configuration-title">Configuration</h3>
    <p class="sidebar-hint">Tags and future organization tools live here.</p>

    <% if Current.story.present? %>
      <h4 class="sidebar-group-title">Story</h4>
      <ul class="sidebar-list">
        <%= render "shared/sidebar_link",
          icon: "tags",
          label: "Section tags",
          path: universe_story_section_tags_path(story_id: Current.story),
          controllers: %i[ section_tags ] %>
      </ul>
    <% end %>

    <h4 class="sidebar-group-title">Universe</h4>
    <ul class="sidebar-list">
      <%= render "shared/sidebar_link",
        icon: "tags",
        label: "Character tags",
        path: universe_character_tags_path,
        controllers: %i[ character_tags ] %>

      <%= render "shared/sidebar_link",
        icon: "tags",
        label: "Location tags",
        path: universe_location_tags_path,
        controllers: %i[ location_tags ] %>

      <%= render "shared/sidebar_link",
        icon: "tags",
        label: "Item tags",
        path: universe_item_tags_path,
        controllers: %i[ item_tags ] %>

      <%= render "shared/sidebar_link",
        icon: "tags",
        label: "Event tags",
        path: universe_event_tags_path,
        controllers: %i[ event_tags ] %>

      <%= render "shared/sidebar_link",
        icon: "tags",
        label: "Relation tags",
        path: universe_relation_tags_path,
        controllers: %i[ relation_tags ] %>

      <%= render "shared/sidebar_link",
        icon: "tags",
        label: "Ownership tags",
        path: universe_ownership_tags_path,
        controllers: %i[ ownership_tags ] %>
    </ul>
  </section>
</nav>
