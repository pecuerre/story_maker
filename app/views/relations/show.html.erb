<% content_for :title, @relation.display_string %>

<%= render "shared/record_details",
  record: @relation,
  eyebrow: t("sidebar.universe_bible"),
  label: t("relations.show.label"),
  facts: [
    detail_fact(t("relations.show.facts.character1"), link_to(@relation.character1.name, universe_character_path(id: @relation.character1))),
    detail_fact(t("relations.show.facts.character2"), link_to(@relation.character2.name, universe_character_path(id: @relation.character2))),
    detail_fact(t("relations.show.facts.tags"), entity_tag_badge(@relation), blank: t("relations.show.facts.tags_blank")),
    detail_fact(t("relations.show.facts.in_world_dates"), in_world_range(@relation.from_date, @relation.to_date)),
    detail_fact(t("relations.show.facts.description"), @relation.description, blank: t("relations.show.facts.description_blank"))
  ],
  back_url: universe_relations_path,
  back_label: t("relations.show.back_label"),
  actions: discussion_control(@relation) %>

<%= render "shared/detail_section",
  title: t("relations.show.related.title"),
  icon: "diagram-2",
  empty_title: t("relations.show.related.empty_title"),
  empty_description: t("relations.show.related.empty_description") %>
