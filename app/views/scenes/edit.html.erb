<% content_for :title, t("scenes.edit_document_title", name: @scene.name) %>

<%= render "shared/page_header",
  title: t("scenes.edit_title"),
  eyebrow: t("shared.eyebrow.story", story: @story.name),
  description: t("scenes.edit_description") %>

<%= render "shared/content_tabs",
  aria_label: t("sidebar.story_workspace"),
  tabs: story_workspace_tabs(@story) %>

<%= render "scenes/workspace_tabs" %>

<%= render "form", scene: @scene, section_paths: @section_paths %>
