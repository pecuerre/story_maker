<% content_for :title, t("tags.types.event.title") %>

<%= render "shared/taxonomy_tree",
  title: t("tags.types.event.title"),
  description: t("tags.types.event.description"),
  eyebrow: t("sidebar.universe_bible"),
  count: Current.universe.event_tags.count,
  count_label: "tag",
  new_label: t("tags.types.event.new_label"),
  tag_workspace_scope: "universe",
  tag_workspace_taxonomy: "event",
  empty_description: t("tags.types.event.empty_description"),
  read_only_empty_description: t("tags.types.event.read_only_empty_description"),
  nodes: @event_tags,
  hierarchy: @hierarchy,
  create_url: universe_event_tags_path,
  update_url: ->(event_tag) { universe_event_tag_path(id: event_tag) },
  model_param: "event_tag",
  details_url: ->(event_tag) { universe_event_tag_path(id: event_tag) },
  details_count: ->(tag) { @tagged_counts.fetch(tag.id, 0) },
  details_count_label: "event",
  modal_fields: event_tag_taxonomy_fields(@hierarchy.records) %>
