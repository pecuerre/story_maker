<% if records.any? %>
  <ul class="mb-0">
    <% records.each do |record| %>
      <li>
        <%= record.label %>
        <% note = import_record_notes(record) %>
        <% if note.present? %>
          <span class="text-body-secondary small"><%= note %></span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  —
<% end %>
