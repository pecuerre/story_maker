<% layout = local_assigns.fetch(:layout) %>
<% show_unconnected = local_assigns.fetch(:show_unconnected) %>
<% show_relation_links = local_assigns.fetch(:show_relation_links) %>
<% show_faction_links = local_assigns.fetch(:show_faction_links) %>

<figure class="character-network-diagram content-surface">
  <div class="character-network-scroll" role="region" tabindex="0"
    aria-label="<%= t("character_networks.diagram_scroll_label") %>">
    <svg class="character-network-svg" width="<%= layout.width %>" height="<%= layout.height %>"
      viewBox="0 0 <%= layout.width %> <%= layout.height %>" role="group"
      aria-label="<%= t("character_networks.diagram_aria_label", characters: layout.nodes.length, connections: layout.edges.length) %>">
      <g class="character-network-faction-links" aria-hidden="true">
        <% layout.faction_links.each do |link| %>
          <% touches_unconnected = link.source.degree.zero? || link.target.degree.zero? %>
          <% hidden = !show_faction_links || (!show_unconnected && touches_unconnected) %>
          <line class="character-network-faction-link<%= " character-network-hidden" if hidden %>"
            data-character-network-faction-link
            <% if touches_unconnected %>data-character-network-faction-unconnected="true"<% end %>
            x1="<%= link.source.x %>" y1="<%= link.source.y %>"
            x2="<%= link.target.x %>" y2="<%= link.target.y %>"></line>
        <% end %>
      </g>

      <g class="character-network-edges" aria-hidden="true">
        <% layout.edges.each do |edge| %>
          <line class="character-network-edge"
            stroke-width="<%= edge.stroke_width %>"
            x1="<%= edge.source.x %>" y1="<%= edge.source.y %>"
            x2="<%= edge.target.x %>" y2="<%= edge.target.y %>"></line>
        <% end %>
      </g>

      <%# A Relation is drawn after the interaction edge so its dashes show over
          a solid line for a pair that has both. %>
      <g class="character-network-relation-links" aria-hidden="true">
        <% layout.relation_links.each do |link| %>
          <% touches_unconnected = link.source.degree.zero? || link.target.degree.zero? %>
          <% hidden = !show_relation_links || (!show_unconnected && touches_unconnected) %>
          <line class="character-network-relation-link<%= " character-network-hidden" if hidden %>"
            <% if link.relation_tag %>style="stroke: <%= link.relation_tag.bgcolor %>;"<% end %>
            data-character-network-relation-link
            <% if touches_unconnected %>data-character-network-relation-unconnected="true"<% end %>
            x1="<%= link.source.x %>" y1="<%= link.source.y %>"
            x2="<%= link.target.x %>" y2="<%= link.target.y %>"></line>
        <% end %>
      </g>

      <g class="character-network-nodes">
        <% layout.nodes.each do |node| %>
          <% isolated = node.degree.zero? %>
          <% hidden = isolated && !show_unconnected %>
          <%= link_to universe_character_path(id: node.character),
            class: "character-network-node#{' character-network-node--isolated' if isolated}#{' character-network-hidden' if hidden}",
            data: isolated ? { character_network_unconnected: "true" } : {},
            aria: { label: t("character_networks.character_link", name: node.character.name) } do %>
            <circle cx="<%= node.x %>" cy="<%= node.y %>" r="<%= node.radius %>"></circle>
            <% if isolated %>
              <title><%= t("character_networks.node_title_unconnected", name: node.character.name) %></title>
            <% else %>
              <title><%= t("character_networks.node_title", name: node.character.name,
                score: node.interaction_total, connections: node.degree) %></title>
            <% end %>
            <text x="<%= node.x %>" y="<%= (node.y + node.radius + 15).round(2) %>"
              text-anchor="middle"><%= node.label %></text>
          <% end %>
        <% end %>
      </g>
    </svg>
  </div>

  <figcaption class="character-network-caption">
    <p class="mb-2"><%= t("character_networks.diagram_caption") %></p>
    <ul class="character-network-legend list-unstyled mb-0"
      aria-label="<%= t("character_networks.diagram_legend_label") %>">
      <li>
        <span class="character-network-legend-line" aria-hidden="true"></span>
        <%= t("character_networks.legend_line") %>
      </li>
      <% if layout.relation_links.any? %>
        <li class="<%= "character-network-hidden" unless show_relation_links %>"
          data-character-network-relation-legend>
          <span class="character-network-legend-line character-network-legend-line--relation" aria-hidden="true"></span>
          <%= t("character_networks.legend_relation_link") %>
        </li>
      <% end %>
      <% if layout.faction_links.any? %>
        <li class="<%= "character-network-hidden" unless show_faction_links %>"
          data-character-network-faction-legend>
          <span class="character-network-legend-line character-network-legend-line--faction" aria-hidden="true"></span>
          <%= t("character_networks.legend_faction_link") %>
        </li>
      <% end %>
      <li>
        <span class="character-network-legend-node" aria-hidden="true"></span>
        <%= t("character_networks.legend_node") %>
      </li>
      <% if layout.nodes.any? { |node| node.degree.zero? } %>
        <li class="<%= "character-network-hidden" unless show_unconnected %>"
          data-character-network-unconnected-legend>
          <span class="character-network-legend-node character-network-legend-node--isolated" aria-hidden="true"></span>
          <%= t("character_networks.legend_unconnected") %>
        </li>
      <% end %>
    </ul>
  </figcaption>
</figure>
