<p style="color: green"><%= notice %></p>

<% content_for :title, "Locations" %>

<h1>Locations</h1>

<%= render "shared/taxonomy_tree",
  nodes: @locations,
  new_url: ->(parent = nil) { new_story_location_path(story_slug: Current.story.slug, parent_id: parent&.id) },
  create_url: story_locations_path(story_slug: Current.story.slug),
  edit_url: ->(location) { edit_story_location_path(story_slug: Current.story.slug, id: location) },
  update_url: ->(location) { story_location_path(story_slug: Current.story.slug, id: location) },
  delete_url: ->(location) { story_location_path(story_slug: Current.story.slug, id: location) },
  model_param: "location",
  taxonomy_field: "location_type_id",
  modal_fields: [
    { name: "name", label: "Name", type: "text" },
    { name: "description", label: "Description", type: "textarea" },
    { name: "location_type_id", label: "Location type", type: "select", options: @location_types.map { |location_type| [ location_type.id, location_type.name ] } }
  ] %>
