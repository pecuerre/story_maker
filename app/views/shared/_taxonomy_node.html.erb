<li class="taxonomy-node" draggable="true" data-taxonomy-tree-target="node" data-node-id="<%= node.id %>" data-update-url="<%= update_url.call(node) %>">
  <div class="d-flex align-items-center gap-2 border-bottom py-2" data-action="dragstart->taxonomy-tree#startDrag dragover->taxonomy-tree#allowDrop drop->taxonomy-tree#moveNode">
    <i class="bi bi-grip-vertical text-body-secondary" aria-hidden="true"></i>
    <span class="flex-grow-1 text-break"><%= node.name %></span>
    <span class="taxonomy-actions d-flex gap-1">
      <% if new_url %>
        <%= link_to new_url.call(node), class: "btn btn-sm btn-outline-secondary", title: "Add child", aria: { label: "Add child to #{node.name}" } do %>
          <i class="bi bi-plus-lg" aria-hidden="true"></i>
        <% end %>
      <% end %>
      <%= link_to edit_url.call(node), class: "btn btn-sm btn-outline-secondary", title: "Edit", aria: { label: "Edit #{node.name}" } do %>
        <i class="bi bi-pencil" aria-hidden="true"></i>
      <% end %>
      <%= button_to delete_url.call(node), method: :delete, class: "btn btn-sm btn-outline-danger", title: "Delete", aria: { label: "Delete #{node.name}" }, form: { data: { turbo_confirm: "Delete #{node.name} and its children?" } } do %>
        <i class="bi bi-trash" aria-hidden="true"></i>
      <% end %>
    </span>
  </div>

  <% children = node.public_send(children_method) %>
  <% if children.any? %>
    <ul class="taxonomy-list list-unstyled ms-4">
      <% children.each do |child| %>
        <%= render "shared/taxonomy_node",
          node: child,
          children_method: children_method,
          new_url: new_url,
          edit_url: edit_url,
          update_url: update_url,
          delete_url: delete_url,
          model_param: model_param %>
      <% end %>
    </ul>
  <% end %>
</li>