<% child_tags = local_assigns.fetch(:child_tags) %>
<% records_by_child_tag = local_assigns.fetch(:records_by_child_tag) %>

<% if child_tags.empty? %>
  <%= render "shared/empty_state",
    title: "No child tags",
    description: "This grouping tag has no child tags yet.",
    icon: local_assigns.fetch(:icon) %>
<% else %>
  <% child_tags.each do |child_tag| %>
    <% child_records = records_by_child_tag.fetch(child_tag.id, []) %>
    <%= render "shared/detail_section",
      title: child_tag.name,
      count: child_records.size,
      count_label: local_assigns.fetch(:count_label),
      icon: local_assigns.fetch(:icon),
      empty_title: "No #{local_assigns.fetch(:count_label).pluralize} carry this tag",
      empty_description: "Nothing uses this child tag yet." do %>
      <%= render "shared/tagged_record_list",
        records: child_records,
        tags_by_record: local_assigns.fetch(:tags_by_record),
        path: local_assigns.fetch(:path) %>
    <% end %>
  <% end %>
<% end %>
