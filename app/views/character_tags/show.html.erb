<% content_for :title, @character_tag.name %>

<%= render "shared/record_details",
  record: @character_tag,
  eyebrow: t("tags.show.eyebrow"),
  label: t("tags.types.character.record_label"),
  **tag_identity_details(@character_tag),
  back_url: universe_character_tags_path,
  back_label: t("tags.types.character.all_label"),
  actions: discussion_control(@character_tag) do %>
  <%= render "shared/menu_tag_content_tabs", tag_type: "character", tag: @character_tag %>
<% end %>

<%# The section's empty title is the shared sentence with the record type in its
    plural, so the two branches below — a taggable tag lists the records directly,
    a grouping tag lists one section per child tag — read identically when empty. %>
<% empty_title = t("shared.detail_section.empty_title", determiner: t("shared.detail_section.determiners.none_masculine"), label: t("character", count: 1)) %>

<% if @character_tag.taggable %>
  <%= render "shared/include_descendants_toggle" %>

  <%= render "shared/detail_section",
    title: t("tags.types.character.records_title"),
    count: @tagged_records.size,
    count_label: "character",
    icon: "person",
    empty_title: empty_title,
    empty_description: t("tags.types.character.unused_description") do %>
    <%= render "shared/tagged_record_list",
      records: @tagged_records,
      path: ->(record) { universe_character_path(id: record) } %>
  <% end %>
<% else %>
  <%= render "shared/tagged_records_by_child_tag",
    child_tags: @child_tags,
    records_by_child_tag: @records_by_child_tag,
    tags_by_record: @tags_by_record,
    count_label: "character",
    icon: "person",
    path: ->(record) { universe_character_path(id: record) } %>
<% end %>
