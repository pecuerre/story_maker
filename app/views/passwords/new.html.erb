<% content_for :title, "Reset password" %>

<div class="auth-shell">
  <%= render "shared/page_header",
    title: "Forgot your password?",
    description: "Enter your email address and we will send password reset instructions." %>

  <%= form_with url: passwords_path, class: "form-surface" do |form| %>
    <div class="mb-3">
      <%= form.label :email_address, class: "form-label" %>
      <%= form.email_field :email_address,
        class: "form-control",
        required: true,
        autofocus: true,
        autocomplete: "username",
        placeholder: "you@example.com",
        value: params[:email_address] %>
    </div>

    <div class="d-flex align-items-center gap-3">
      <%= form.submit "Email reset instructions", class: "btn btn-primary" %>
      <%= link_to "Back to sign in", new_session_path, class: "btn btn-link" %>
    </div>
  <% end %>
</div>
