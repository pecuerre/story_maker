<%= form_with model: scene,
  url: scene.persisted? ? universe_story_scene_path(story_id: scene.story, id: scene) : universe_story_scenes_path(story_id: scene.story),
  class: "form-surface" do |form| %>
  <% if scene.errors.any? %>
    <div class="alert alert-danger" role="alert">
      <%# `shared.error_summary.heading` owns the sentence and its determiner, and
          `scene` is the workspace's own subject noun rather than a name, so the
          sentence decides where the phrase goes. %>
      <h2 class="h6"><%= t("shared.error_summary.heading", count: scene.errors.count, subject: t("scenes.errors.subject")) %></h2>
      <ul class="mb-0">
        <% scene.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, t("scenes.form.name"), class: "form-label" %>
    <%= form.text_field :name, class: "form-control", required: true, autofocus: true %>
    <div class="form-text"><%= t("scenes.form.name_hint") %></div>
  </div>

  <%= render "shared/photo_field", param: "scene", current_url: record_photo_url(scene) %>

  <div class="mb-3">
    <%= form.label :description, t("scenes.form.description"), class: "form-label" %>
    <%= form.text_area :description, class: "form-control", rows: 5 %>
    <div class="form-text"><%= t("scenes.form.description_hint") %></div>
  </div>

  <fieldset class="mb-3">
    <legend class="h6"><%= t("scenes.form.tags_legend") %></legend>
    <div class="mb-3">
      <%= form.label :scene_tag_ids, t("scenes.form.tags_label"), class: "form-label" %>
      <% if @scene_tags.any? %>
        <%= form.select :scene_tag_ids,
          scene_tag_choices(@taggable_scene_tags, @scene_tag_paths),
          { include_hidden: true },
          { multiple: true, class: "form-select", size: [ @taggable_scene_tags.size, 6 ].min } %>
        <div class="form-text"><%= t("scenes.form.tags_hint") %></div>
      <% else %>
        <p class="text-body-secondary mb-2"><%= t("scenes.form.tags_empty") %></p>
        <%= link_to t("scenes.form.manage_tags"), universe_tags_path(scope: "story", taxonomy: "scene"), class: "btn btn-sm btn-outline-secondary" %>
      <% end %>
    </div>
  </fieldset>

  <fieldset class="mb-3">
    <legend class="h6"><%= t("scenes.form.organization_legend") %></legend>
    <div class="mb-3">
      <%= form.label :section_id, t("scenes.form.section"), class: "form-label" %>
      <%# The selector's first option is the Ungrouped group, whose *value* is the
          empty string the form stores and whose label is translated through
          `SectionPaths`. %>
      <%= form.select :section_id, section_paths.grouping_options, {}, class: "form-select" %>
      <div class="form-text"><%= t("scenes.form.section_hint") %></div>
    </div>
  </fieldset>

  <fieldset class="mb-3">
    <legend class="h6"><%= t("scenes.form.in_world_time_legend") %></legend>
    <div class="mb-3">
      <%= form.label :event_id, t("scenes.form.event"), class: "form-label" %>
      <%# The blank option clears the reference and the values are event ids, so
          neither is translated; only the labels beside them are. %>
      <%= form.select :event_id, scene_event_choices(event_options),
        { include_blank: t("shared.none") }, class: "form-select" %>
      <div class="form-text"><%= t("scenes.form.event_hint") %></div>
    </div>

    <div class="mb-3">
      <%= form.label :datetime, t("scenes.form.datetime"), class: "form-label" %>
      <%# `step: 1` matches `ApplicationHelper::DATETIME_LOCAL_FORMAT`, which is what
            `scene_datetime_field_value` formats this control with: a whole-minute
            step could not hold stored seconds and would drop them on save. %>
        <%= form.datetime_local_field :datetime, value: scene_datetime_field_value(scene), class: "form-control", step: 1 %>
      <div class="form-text"><%= t("scenes.form.datetime_hint") %></div>
    </div>
  </fieldset>

  <%# One sentence with a link in it, so it is an `_html` key. The two control
      names are interpolated from the Scenes list's own keys rather than written
      out here, so the sentence names the controls the reader will actually find. %>
  <p class="form-text">
    <%= t("scenes.form.position_note_html",
      move_up: t("scenes.move.up"), move_down: t("scenes.move.down"),
      scenes_list: link_to(t("scenes.form.scenes_list_link"), universe_story_scenes_path(story_id: scene.story))) %>
  </p>

  <div class="form-actions">
    <%# Rails' default submit label comes from `helpers.submit.*`, which is English
        only, so each branch names its own. %>
    <%= form.submit(scene.persisted? ? t("scenes.form.submit_update") : t("scenes.form.submit_create"), class: "btn btn-primary") %>
    <%= link_to t("shared.form.cancel"), scene.persisted? ? universe_story_scene_path(story_id: scene.story, id: scene) : universe_story_scenes_path(story_id: scene.story),
      class: "btn btn-link" %>
  </div>
<% end %>