<% content_for :title, t("scenes.title") %>
<% editable = can_write_universe? %>
<% filtered = @scene_filter.active? %>
<% empty_description = if editable
  t("scenes.index.empty_writable_description")
else
  t("scenes.index.empty_read_only_description")
end %>

<%= render "shared/page_header",
  title: t("scenes.title"),
  eyebrow: t("shared.eyebrow.story", story: @story.name),
  description: t("scenes.index.description", story: @story.name),
  count: @scenes.size,
  count_label: "scene" do %>
  <% if editable %>
    <%= link_to new_universe_story_scene_path(story_id: @story), class: "btn btn-primary" do %>
      <i class="bi bi-plus-lg" aria-hidden="true"></i>
      <span><%= t("scenes.add") %></span>
    <% end %>
  <% end %>
<% end %>

<%= render "shared/content_tabs",
  aria_label: t("sidebar.story_workspace"),
  tabs: [
    { label: t("sidebar.sections"), path: universe_story_sections_path(story_id: @story), controller: :sections },
    { label: t("sidebar.scenes"), path: universe_story_scenes_path(story_id: @story), controller: :scenes }
  ] %>

<%= render "scenes/filter",
  story: @story,
  filter: @scene_filter,
  section_paths: @section_paths,
  scene_tags: @scene_tags,
  scene_tag_paths: @scene_tag_paths,
  total: @scene_total,
  shown: @scenes.size %>

<% filter_params = @scene_filter.query_params %>
<%# A remembered Scene create belongs to this story's list, but **not to a
    filtered one**: `SceneFilter` narrows the Story's real scenes, and a record
    that does not exist cannot match a section, a tag, or a date range. Offering
    a pending row beside a "nothing matched these filters" message would be
    answering a question the reader did not ask, so a narrowed list stays narrowed
    and the pending rows are the unfiltered list's own. %>
<% pending_creates = filtered ? [] : draft_pending_creates_for(Scene) %>
<% if @scenes.any? || pending_creates.any? %>
  <div class="content-surface entity-list">
    <div class="list-group list-group-flush">
      <% @scenes.each do |scene| %>
        <div class="list-group-item entity-row d-flex align-items-start gap-3">
          <div class="entity-copy flex-grow-1">
            <div class="d-flex align-items-center gap-2 flex-wrap">
              <%# The position and the totals come from the whole sequence, not from
                  the filtered rows, so a narrowed view still says where the scene
                  sits in the order the story is told. %>
              <span class="badge rounded-pill text-bg-light border"
                aria-label="<%= t("shared.scene_position_aria", position: scene.position + 1, total: @scene_total) %>">
                <%= scene.position + 1 %>
              </span>
              <span class="entity-title"><%= scene.name %></span>
              <% grouping = scene_grouping_label(scene, @section_paths) %>
              <span class="badge rounded-pill text-bg-light border"
                title="<%= grouping.present? ? t("scenes.index.grouped_title", grouping: grouping) : t("scenes.index.ungrouped_title") %>">
                <i class="bi <%= grouping.present? ? "bi-folder2" : "bi-folder2-open" %>" aria-hidden="true"></i>
                <span class="text-truncate"><%= grouping || @section_paths.ungrouped_label %></span>
              </span>
              <%# Both counts are per-row facts, and a row with none says so
                  rather than showing a zero that looks like a measurement. The
                  announced count and its record type are one phrase resolved with a
                  `count:`, so the plural comes from the locale. %>
              <span class="badge rounded-pill text-bg-light border"
                aria-label="<%= count_with_label(@element_counts.fetch(scene.id, 0), "element") %>">
                <i class="bi bi-text-paragraph" aria-hidden="true"></i>
                <%= @element_counts.fetch(scene.id, 0) %>
              </span>
              <%# The participants are the union of the stored presence links and the
                  derived speakers, so this badge never sums them; the title says what
                  it counted and why a speaker is one participant. %>
              <span class="badge rounded-pill text-bg-light border"
                title="<%= t("scenes.index.participants_title") %>"
                aria-label="<%= t("scenes.index.participants_aria",
                  characters: count_with_label(@participant_counts.fetch(scene.id, 0), "character")) %>">
                <i class="bi bi-people" aria-hidden="true"></i>
                <%= @participant_counts.fetch(scene.id, 0) %>
              </span>
              <%= entity_tag_badge(scene) %>
              <%= render "shared/draft_pending_badge", state: draft_pending_state(scene) %>
            </div>
            <% if scene.description.present? %>
              <div class="entity-description"><%= scene.description %></div>
            <% end %>
          </div>

          <%# The row's right-hand group matches every other list: Details is
              navigation into the scene's own page and is rendered for every
              access level, while the controls below it are for writers only. %>
          <div class="entity-row-actions d-flex align-items-center gap-2 flex-wrap justify-content-end">
            <%= record_details_link universe_story_scene_path(story_id: @story, id: scene), record: scene %>

            <% if editable %>
              <%# Boundary state is the Story's real first and last position, so a
                  filtered list never disables a move that has a neighbor. %>
              <% at_first = scene.position <= @first_position %>
              <% at_last = scene.position >= @last_position %>
              <div class="d-flex align-items-center gap-1">
                <%= button_to move_universe_story_scene_path(story_id: @story, id: scene, **filter_params),
                  method: :patch,
                  params: { direction: "up" },
                  class: "btn btn-sm btn-light border",
                  disabled: at_first,
                  title: at_first ? t("scenes.move.already_first") : t("scenes.move.up"),
                  aria: { label: t("scenes.move.up_aria", name: scene.name) },
                  data: { scene_move: "up" } do %>
                  <i class="bi bi-arrow-up" aria-hidden="true"></i>
                <% end %>
                <%= button_to move_universe_story_scene_path(story_id: @story, id: scene, **filter_params),
                  method: :patch,
                  params: { direction: "down" },
                  class: "btn btn-sm btn-light border",
                  disabled: at_last,
                  title: at_last ? t("scenes.move.already_last") : t("scenes.move.down"),
                  aria: { label: t("scenes.move.down_aria", name: scene.name) },
                  data: { scene_move: "down" } do %>
                  <i class="bi bi-arrow-down" aria-hidden="true"></i>
                <% end %>
              </div>

              <div class="dropdown row-actions">
                <button class="btn btn-sm btn-light border dropdown-toggle" type="button"
                  id="<%= dom_id(scene) %>-actions"
                  data-bs-toggle="dropdown"
                  aria-expanded="false"
                  aria-label="<%= t("shared.row_actions.actions_for", name: scene.name) %>">
                  <i class="bi bi-three-dots" aria-hidden="true"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="<%= dom_id(scene) %>-actions">
                  <li>
                    <%= link_to edit_universe_story_scene_path(story_id: @story, id: scene), class: "dropdown-item" do %>
                      <i class="bi bi-pencil me-2" aria-hidden="true"></i><%= t("shared.row_actions.edit") %>
                    <% end %>
                  </li>
                  <li><hr class="dropdown-divider"></li>
                  <li>
                    <%# A Scene owns its Elements and its presence links, so its
                        delete states that cascade rather than falling back to the
                        short shared confirmation. The scene's name is the author's
                        own record name and is interpolated, not translated. %>
                    <%= button_to universe_story_scene_path(story_id: @story, id: scene, **filter_params),
                      method: :delete,
                      class: "dropdown-item text-danger",
                      data: { turbo_confirm: t("scenes.index.delete_confirm", name: scene.name) } do %>
                      <i class="bi bi-trash me-2" aria-hidden="true"></i><%= t("shared.row_actions.delete") %>
                    <% end %>
                  </li>
                </ul>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <%= render partial: "shared/draft_pending_rows", collection: pending_creates, as: :record %>
    </div>
  </div>
<% elsif filtered %>
  <%# A filtered list with no match is not the same as a story without scenes,
      so it says which filters produced nothing and offers the way back. %>
  <div class="content-surface p-3 p-md-4">
    <%= render "shared/empty_state",
      title: t("scenes.index.no_match_title"),
      description: t("scenes.index.no_match_description",
        story: @story.name, total: count_with_label(@scene_total, "scene")),
      icon: "filter" do %>
      <span class="d-block mb-3">
        <% scene_filter_summaries(@scene_filter, @section_paths, @scene_tag_paths).each do |summary| %>
          <span class="badge rounded-pill text-bg-light border me-1"><%= summary %></span>
        <% end %>
      </span>
      <%= link_to t("scenes.filter.clear"), universe_story_scenes_path(story_id: @story), class: "btn btn-primary" %>
    <% end %>
  </div>
<% else %>
  <%= render "shared/empty_state",
    title: t("scenes.index.empty_title"),
    description: empty_description,
    icon: "film" do %>
    <% if editable %>
      <%= link_to new_universe_story_scene_path(story_id: @story), class: "btn btn-primary" do %>
        <i class="bi bi-plus-lg" aria-hidden="true"></i>
        <span><%= t("scenes.add") %></span>
      <% end %>
    <% end %>
  <% end %>
<% end %>