<% modal_fields = local_assigns.fetch(:modal_fields, []) %>
<% taxonomy_field = local_assigns[:taxonomy_field] %>
<% confirm_message = local_assigns[:confirm_message] %>
<% details_url = local_assigns[:details_url] %>
<% details_count = local_assigns[:details_count] %>
<% details_count_label = local_assigns.fetch(:details_count_label, "item") %>
<% editable = local_assigns.fetch(:editable) { can_write_universe?(universe_for_record(node) || Current.universe) } %>

<li class="taxonomy-node"
  <% if editable %>
    draggable="true"
    data-action="dragstart->taxonomy-tree#startDrag dragover->taxonomy-tree#allowDrop drop->taxonomy-tree#drop dragend->taxonomy-tree#endDrag"
  <% end %>
  data-taxonomy-tree-target="node"
  data-node-id="<%= node.id %>"
  <% if confirm_message %>data-confirm-message="<%= confirm_message.call(node) %>"<% end %>
  <% if editable %>
    data-update-url="<%= update_url.call(node) %>"
    data-edit-url="<%= edit_url.call(node) %>"
    data-create-url="<%= create_url %>"
  <% end %>
  data-name="<%= node.name %>"
  data-description="<%= node.description %>"
  data-taxonomy-values="<%= modal_fields.to_h { |field| [field[:name], node.public_send(field[:name])] }.to_json %>"
  <% if taxonomy_field %>data-taxonomy-field-value="<%= node.public_send(taxonomy_field).to_json %>"<% end %>>

  <div class="taxonomy-row d-flex align-items-center gap-2 border-bottom">
    <% if editable %>
      <i class="bi bi-grip-vertical text-body-secondary" aria-hidden="true"></i>
    <% end %>

    <%# The inline-rename trigger is deliberately sized to its own content: only
        hovering or focusing the name itself starts a rename, never the whole row. %>
    <span class="taxonomy-name-area d-flex align-items-center gap-2 flex-wrap">
      <% if editable %>
        <%= button_tag type: "button",
          class: "taxonomy-name-trigger text-break",
          aria: { label: "Rename #{node.name}" },
          data: { taxonomy_tree_target: "name", action: "click->taxonomy-tree#editName" } do %>
          <% if node.respond_to?(:bgcolor) %>
            <%= entity_tag_badge(node) %>
          <% else %>
            <span class="entity-title"><%= node.name %></span>
            <%= entity_tag_badge(node) %>
          <% end %>
          <% if node.description.present? %>
            <span class="entity-description d-block"><%= node.description %></span>
          <% end %>
        <% end %>
      <% else %>
        <span class="taxonomy-name-text text-break">
          <% if node.respond_to?(:bgcolor) %>
            <%= entity_tag_badge(node) %>
          <% else %>
            <span class="entity-title"><%= node.name %></span>
            <%= entity_tag_badge(node) %>
          <% end %>
          <% if node.description.present? %>
            <span class="entity-description d-block"><%= node.description %></span>
          <% end %>
        </span>
      <% end %>

      <%# Details is real navigation, so it stays visible for every access level
          and never hides behind the row's hover-revealed action menu. %>
      <% if details_url %>
        <%= record_details_link details_url.call(node),
          record: node,
          count: details_count&.call(node),
          count_label: details_count_label %>
      <% end %>
    </span>

    <% if editable %>
      <span class="taxonomy-actions ms-auto d-flex align-items-center gap-1">
        <div class="dropdown">
          <button class="btn btn-sm btn-light border dropdown-toggle" type="button"
            id="taxonomy-<%= node.id %>-actions"
            data-bs-toggle="dropdown"
            aria-expanded="false"
            aria-label="Actions for <%= node.name %>">
            <i class="bi bi-three-dots" aria-hidden="true"></i>
          </button>
          <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="taxonomy-<%= node.id %>-actions">
            <% if new_url %>
              <li>
                <button type="button" class="dropdown-item" data-action="taxonomy-tree#add" data-taxonomy-action="add-child">
                  <i class="bi bi-plus-lg me-2" aria-hidden="true"></i>Add child
                </button>
              </li>
            <% end %>
            <li>
              <button type="button" class="dropdown-item" data-action="taxonomy-tree#insertRelative" data-insert-position="before">
                <i class="bi bi-plus-lg me-2" aria-hidden="true"></i>Insert before
              </button>
            </li>
            <li>
              <button type="button" class="dropdown-item" data-action="taxonomy-tree#insertRelative" data-insert-position="after">
                <i class="bi bi-plus-lg me-2" aria-hidden="true"></i>Insert after
              </button>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li>
              <button type="button" class="dropdown-item"
                data-action="taxonomy-tree#move" data-move-direction="up" data-taxonomy-action="move-up">
                <i class="bi bi-arrow-up me-2" aria-hidden="true"></i>Move up
              </button>
            </li>
            <li>
              <button type="button" class="dropdown-item"
                data-action="taxonomy-tree#move" data-move-direction="down" data-taxonomy-action="move-down">
                <i class="bi bi-arrow-down me-2" aria-hidden="true"></i>Move down
              </button>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li>
              <button type="button" class="dropdown-item" data-action="taxonomy-tree#edit">
                <i class="bi bi-pencil me-2" aria-hidden="true"></i>Edit
              </button>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li>
              <button type="button" class="dropdown-item text-danger" data-action="taxonomy-tree#remove">
                <i class="bi bi-trash me-2" aria-hidden="true"></i>Delete
              </button>
            </li>
          </ul>
        </div>
      </span>
    <% end %>
  </div>

  <% children = node.public_send(children_method) %>
  <% if children.any? %>
    <ul class="taxonomy-list list-unstyled ms-4 ps-3"
      <% if editable %>data-action="dragover->taxonomy-tree#allowDrop drop->taxonomy-tree#drop"<% end %>
      data-drop-parent-id="<%= node.id %>">
      <% children.each do |child| %>
        <%= render "shared/taxonomy_node",
          node: child,
          children_method: children_method,
          new_url: new_url,
          edit_url: edit_url,
          update_url: update_url,
          delete_url: delete_url,
          create_url: create_url,
          model_param: model_param,
          modal_fields: modal_fields,
          taxonomy_field: taxonomy_field,
          confirm_message: confirm_message,
          details_url: details_url,
          details_count: details_count,
          details_count_label: details_count_label,
          editable: editable %>
      <% end %>
    </ul>
  <% end %>
</li>
