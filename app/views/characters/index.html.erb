<% content_for :title, "Characters" %>
<% empty_description = can_write_universe? ? "Characters belong to the universe and are shared by all of its stories. Add the first one to begin." : "Characters belong to the universe and are shared by all of its stories." %>

<div
  <% if can_write_universe? %>data-controller="modal-form"<% end %>
  data-modal-form-model-param-value="character"
  data-modal-form-create-title-value="New character">
  <%= render "shared/page_header",
    title: "Characters",
    eyebrow: "Universe Bible",
    description: "People and beings whose details are shared by every story in this universe.",
    count: @characters.size,
    count_label: "character" do %>
    <% if can_write_universe? %>
      <button type="button" class="btn btn-primary"
        data-action="modal-form#open"
        data-modal-form-url="<%= universe_characters_path %>"
        data-modal-form-method="post"
        data-modal-form-title="New character"
        data-modal-form-values-value="{}">
        <i class="bi bi-plus-lg" aria-hidden="true"></i>
        <span>Add character</span>
      </button>
    <% end %>
  <% end %>

  <%= render "shared/content_tabs",
    aria_label: "Character workspace",
    tabs: [
      { label: "Characters", path: universe_characters_path, controller: :characters },
      { label: "Character tags", path: universe_character_tags_path, controller: :character_tags },
      { label: "Relations", path: universe_relations_path, controller: :relations },
      { label: "Relation tags", path: universe_relation_tags_path, controller: :relation_tags }
    ] %>

  <% if @characters.any? %>
    <div class="content-surface entity-list">
      <div class="list-group list-group-flush">
        <% @characters.each do |character| %>
          <div class="list-group-item entity-row d-flex align-items-center gap-3">
            <div class="entity-copy flex-grow-1">
              <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="entity-title"><%= character.name %></span>
                <%= entity_tag_badge(character) %>
              </div>
              <% if character.description.present? %>
                <div class="entity-description"><%= character.description %></div>
              <% end %>
            </div>

            <%= render "shared/row_actions",
              record: character,
              label: "character",
              record_name: character.name,
              edit_url: universe_character_path(id: character),
              delete_url: universe_character_path(id: character),
              values: character_fields_json(character) %>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <%= render "shared/empty_state",
      title: "No characters yet",
      description: empty_description,
      icon: "person" %>
  <% end %>

  <% if can_write_universe? %>
    <div class="modal fade" tabindex="-1"
    aria-labelledby="character-modal-title"
    aria-hidden="true"
    data-modal-form-target="modal">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title fs-5" id="character-modal-title" data-modal-form-target="title">New character</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <%= form_with scope: :character,
          url: universe_characters_path,
          method: :post,
          data: { modal_form_target: "form" } do |form| %>
          <div class="modal-body">
            <div class="mb-3">
              <%= form.label :name, class: "form-label" %>
              <%= form.text_field :name, class: "form-control", required: true %>
            </div>
            <div class="mb-3">
              <%= form.label :character_tag_ids, "Character tags", class: "form-label" %>
              <%= form.collection_select :character_tag_ids, @character_tags, :id, :name,
                {},
                { class: "form-select", multiple: true, data: { controller: "tom-select" } } %>
            </div>
            <div>
              <%= form.label :description, class: "form-label" %>
              <%= form.text_area :description, class: "form-control", rows: 4 %>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <%= form.submit "Save character", class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  <% end %>
</div>
