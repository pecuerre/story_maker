<% content_for :title, t("tags.types.ownership.title") %>

<%= render "shared/taxonomy_tree",
  title: t("tags.types.ownership.title"),
  description: t("tags.types.ownership.description"),
  eyebrow: t("sidebar.universe_bible"),
  count: Current.universe.ownership_tags.count,
  count_label: "tag",
  new_label: t("tags.types.ownership.new_label"),
  tag_workspace_scope: "universe",
  tag_workspace_taxonomy: "ownership",
  empty_description: t("tags.types.ownership.empty_description"),
  read_only_empty_description: t("tags.types.ownership.read_only_empty_description"),
  nodes: @ownership_tags,
  create_url: universe_ownership_tags_path,
  update_url: ->(ownership_tag) { universe_ownership_tag_path(id: ownership_tag) },
  model_param: "ownership_tag",
  details_url: ->(ownership_tag) { universe_ownership_tag_path(id: ownership_tag) },
  details_count: ->(tag) { @tagged_counts.fetch(tag.id, 0) },
  details_count_label: "ownership",
  modal_fields: ownership_tag_taxonomy_fields(Current.universe.ownership_tags.order(:position, :id)) %>
