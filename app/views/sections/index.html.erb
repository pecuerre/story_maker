<% content_for :title, "Sections" %>

<h1>Sections</h1>

<%= render "shared/taxonomy_tree",
	nodes: @sections,
	new_url: ->(parent = nil) { new_story_section_path(parent_id: parent&.id) },
	create_url: story_sections_path(),
	edit_url: ->(section) { edit_story_section_path(id: section) },
	update_url: ->(section) { story_section_path(id: section) },
	delete_url: ->(section) { story_section_path(id: section) },
	model_param: "section",
	taxonomy_field: "section_type_id",
	modal_fields: [
		{ name: "name", label: "Name", type: "text", required: true },
		{ name: "description", label: "Description", type: "textarea" },
		{ name: "section_type_id", label: "Section type", type: "select", required: true, options: @section_types.map { |section_type| [ section_type.id, section_type.name ] } }
	] %>