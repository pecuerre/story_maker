<% content_for :title, t("tags.types.relation.title") %>

<%= render "shared/taxonomy_tree",
  title: t("tags.types.relation.title"),
  description: t("tags.types.relation.description"),
  eyebrow: t("sidebar.universe_bible"),
  count: @hierarchy.records.length,
  count_label: "tag",
  new_label: t("tags.types.relation.new_label"),
  tag_workspace_scope: "universe",
  tag_workspace_taxonomy: "relation",
  empty_description: t("tags.types.relation.empty_description"),
  read_only_empty_description: t("tags.types.relation.read_only_empty_description"),
  nodes: @relation_tags,
  hierarchy: @hierarchy,
  filter: @list_filter,
  filter_path: universe_relation_tags_path,
  filter_total: @relation_tag_total,
  filter_shown: @hierarchy.records.length,
  filter_count_label: "tag",
  create_url: universe_relation_tags_path,
  update_url: ->(relation_tag) { universe_relation_tag_path(id: relation_tag) },
  model_param: "relation_tag",
  details_url: ->(relation_tag) { universe_relation_tag_path(id: relation_tag) },
  details_count: ->(tag) { @tagged_counts.fetch(tag.id, 0) },
  details_count_label: "relation",
  modal_fields: relation_tag_taxonomy_fields(@hierarchy.records) %>
