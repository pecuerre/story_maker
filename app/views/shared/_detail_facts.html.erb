<%# The identity block every details page starts with. `facts` is a list of
    [ label, value ] pairs so each record type can add or reorder its own
    information as the page grows, without changing this partial.

    An empty list renders nothing rather than an empty `<dl>`: a page whose facts
    are all prose passes none here and gives them the card's full width through
    `shared/_record_details`'s `wide_facts` instead. `class_name` is what lets that
    wider variant be the same partial rather than a second copy of it. %>
<% facts = local_assigns.fetch(:facts) %>
<% classes = [ "detail-facts", local_assigns[:class_name] ].compact.join(" ") %>
<dl class="<%= classes %>">
  <% facts.each do |fact| %>
    <div class="detail-fact">
      <dt class="page-eyebrow"><%= fact.fetch(:label) %></dt>
      <dd class="detail-fact-value text-break"><%= fact.fetch(:value) %></dd>
    </div>
  <% end %>
</dl>
