<div class="py-4">

<% if Current.story.present? %>
  <h6 class="text-uppercase text-body-secondary small fw-bold">
    Story Structure
  </h6>

  <nav class="nav flex-column mb-4">
    <%= link_to "Sections", story_sections_path(story_slug: Current.story.slug), class: "nav-link px-0#{' active' if controller_name == 'sections'}" %>
    <%= link_to "Scenes", "#", class: "nav-link px-0 link-secondary" %>
  </nav>

  <h6 class="text-uppercase text-body-secondary small fw-bold">
    Story Elements
  </h6>

  <nav class="nav flex-column mb-4">
    <%= link_to "Locations",
      story_locations_path(story_slug: Current.story.slug),
      class: "nav-link px-0#{active_if(:locations)}"
    %>

    <%= link_to "Items",
      story_items_path(story_slug: Current.story.slug),
      class: "nav-link px-0#{active_if(:items)}"
    %>
      <%= link_to "Ownerships",
        story_ownerships_path(story_slug: Current.story.slug),
        class: "nav-link nav-sublink px-0#{active_if(:ownerships)}"
      %>

    <%= link_to "Characters",
      story_characters_path(story_slug: Current.story.slug),
      class: "nav-link px-0#{active_if(:characters)}"
    %>
      <%= link_to "Relations",
        story_relations_path(story_slug: Current.story.slug),
        class: "nav-link nav-sublink px-0#{active_if(:relations)}"
      %>

    <%= link_to "Dialogs", "#", class: "nav-link px-0 link-secondary" %>
    <%= link_to "Events", "#", class: "nav-link px-0 link-secondary" %>
  </nav>

  <h6 class="text-uppercase text-body-secondary small fw-bold">
    Story Tracking
  </h6>

  <nav class="nav flex-column mb-4">
    <%= link_to "Dashboard", "#", class: "nav-link px-0 link-secondary" %>
    <%= link_to "Timeline", "#", class: "nav-link px-0 link-secondary" %>
    <%= link_to "Map", "#", class: "nav-link px-0 link-secondary" %>
    <%= link_to "Meetings", "#", class: "nav-link px-0 link-secondary" %>
  </nav>

  <h6 class="text-uppercase text-body-secondary small fw-bold">
    Story Analyzer
  </h6>

  <nav class="nav flex-column mb-4">
    <%= link_to "Inconcistencies", "#", class: "nav-link px-0 link-secondary" %>
    <%= link_to "Undefined", "#", class: "nav-link px-0 link-secondary" %>
    <%= link_to "Incomplete", "#", class: "nav-link px-0 link-secondary" %>
    <%= link_to "Pending", "#", class: "nav-link px-0 link-secondary" %>
  </nav>
<% end %>

</div>