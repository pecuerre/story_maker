<%# The brand points here, so this route has two jobs. A guest gets the public
    front door: what the workspace is, and the public universes that can be read
    without an account. A signed-in reader gets the chooser, because picking a
    world is the only thing they came here to do. %>
<% if Current.user.present? %>
  <% content_for :title, t("universes.title") %>
  <%= render "chooser", universes: @universes %>
<% else %>
  <% content_for :title, t("universes.landing.document_title") %>
  <%= render "landing", universes: @universes %>
<% end %>
