<% scope = local_assigns[:scope] || tag_workspace_default_scope %>
<% taxonomy = local_assigns[:taxonomy] || tag_workspace_default_taxonomy %>
<% navigation = tag_workspace_navigation_data(scope: scope, taxonomy: taxonomy) %>

<%# The scope pair and the taxonomy strip answer different questions: the first
    opens the universe or story workspace, the second opens one page of it. Both
    used to be underlined tab strips, which made the taxonomy read as a nested
    page, so the scope is a segmented control and only the taxonomy is a tab
    strip. Both are still URL-backed links, so every choice has its own address. %>
<nav class="tag-scope-switch" aria-label="<%= t("shared.tag_workspace_navigation.scope_aria_label") %>">
  <% navigation.fetch(:scope_options).each do |option| %>
    <% is_active = option.fetch(:active) %>
    <%= link_to option.fetch(:label), option.fetch(:path),
      class: "tag-scope-option#{' active' if is_active}",
      aria: is_active ? { current: "page" } : {} %>
  <% end %>
</nav>

<%= render "shared/content_tabs",
  class_name: "tag-taxonomy-tabs",
  aria_label: scope == "story" ? t("shared.tag_workspace_navigation.story_aria_label") : t("shared.tag_workspace_navigation.universe_aria_label"),
  tabs: navigation.fetch(:taxonomy_tabs) %>
