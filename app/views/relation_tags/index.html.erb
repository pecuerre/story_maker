<% content_for :title, "Relation Tags" %>

<%= render "shared/taxonomy_tree",
  title: "Relation tags",
  description: "Define the relationship types used when connecting characters in this universe.",
  eyebrow: "Universe Bible",
  count: Current.universe.relation_tags.count,
  count_label: "tag",
  new_label: "Add relation tag",
  tabs_aria_label: "Character workspace",
  tabs: [
    { label: "Characters", path: universe_characters_path, controller: :characters },
    { label: "Character tags", path: universe_character_tags_path, controller: :character_tags },
    { label: "Relations", path: universe_relations_path, controller: :relations },
    { label: "Relation tags", path: universe_relation_tags_path, controller: :relation_tags }
  ],
  empty_description: "Tags are optional. Add one to describe character relationships, or leave relations untagged.",
  nodes: @relation_tags,
  new_url: ->(parent = nil) { new_universe_relation_tag_path(parent_id: parent&.id) },
  create_url: universe_relation_tags_path,
  edit_url: ->(relation_tag) { edit_universe_relation_tag_path(id: relation_tag) },
  update_url: ->(relation_tag) { universe_relation_tag_path(id: relation_tag) },
  delete_url: ->(relation_tag) { universe_relation_tag_path(id: relation_tag) },
  model_param: "relation_tag",
  modal_fields: relation_tag_taxonomy_fields(Current.universe.relation_tags.order(:position, :id)) %>
