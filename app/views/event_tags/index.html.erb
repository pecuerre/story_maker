<% content_for :title, "Event Tags" %>

<%= render "shared/taxonomy_tree",
  title: "Event tags",
  description: "Classify events so related moments are easier to find across the timeline.",
  eyebrow: "Universe Bible",
  count: Current.universe.event_tags.count,
  count_label: "tag",
  new_label: "Add event tag",
  tag_workspace_scope: "universe",
  tag_workspace_taxonomy: "event",
  empty_description: "Tags are optional. Add one to group events, or rely on dates and relationships instead.",
  read_only_empty_description: "No event tags are defined yet.",
  nodes: @event_tags,
  create_url: universe_event_tags_path,
  update_url: ->(event_tag) { universe_event_tag_path(id: event_tag) },
  model_param: "event_tag",
  details_url: ->(event_tag) { universe_event_tag_path(id: event_tag) },
  details_count: ->(tag) { @tagged_counts.fetch(tag.id, 0) },
  details_count_label: "event",
  modal_fields: event_tag_taxonomy_fields(Current.universe.event_tags.order(:position, :id)) %>
