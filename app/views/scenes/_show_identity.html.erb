<%# The identity facts inside Scene Details' card, with or without the photo
    beside them. Split out so the two layouts in `scenes/show` render exactly
    the same block and cannot drift apart. %>
<div class="row g-4">
  <div class="col-md-4">
    <div class="page-eyebrow"><%= t("scenes.show.facts.title") %></div>
    <p class="mb-0 text-break"><%= scene.name %></p>
  </div>
  <div class="col-md-4">
    <div class="page-eyebrow"><%= t("scenes.show.facts.narrative_position") %></div>
    <p class="mb-0"><%= t("scenes.show.facts.position", position: scene.position + 1, total: @scene_total) %></p>
  </div>
  <div class="col-md-4">
    <div class="page-eyebrow"><%= t("scenes.show.facts.status") %></div>
    <p class="mb-0">
      <span class="badge rounded-pill text-bg-light border"><%= scene_status_label(scene.status) %></span>
    </p>
    <div class="form-text"><%= t("scenes.show.facts.status_hint") %></div>
  </div>
  <div class="col-12">
    <div class="page-eyebrow"><%= t("scenes.show.facts.description") %></div>
    <% if scene.description.present? %>
      <p class="mb-0 text-break"><%= scene.description %></p>
    <% else %>
      <p class="mb-0 text-body-secondary"><%= t("scenes.show.facts.description_blank") %></p>
    <% end %>
  </div>
  <div class="col-12">
    <div class="page-eyebrow"><%= t("scenes.show.facts.tags") %></div>
    <% if scene.scene_tags.any? %>
      <div class="d-flex flex-wrap gap-1">
        <%= entity_tag_badge(scene) %>
      </div>
    <% else %>
      <p class="mb-0 text-body-secondary"><%= t("scenes.show.facts.tags_blank") %></p>
    <% end %>
    <%# Two hints with a link in each. They are `_html` keys so the *sentence*
        decides where the link sits rather than the template deciding it. %>
    <div class="form-text">
      <%= t("scenes.show.facts.tags_hint") %>
      <% if can_write_universe? %>
        <%= t("scenes.show.facts.tags_hint_editor_html",
          editor: link_to(t("scenes.show.facts.editor_link"), edit_universe_story_scene_path(story_id: story, id: scene))) %>
      <% end %>
      <%= t("scenes.show.facts.tags_hint_workspace_html",
        workspace: link_to(t("scenes.show.facts.workspace_link"), universe_tags_path(scope: "story", taxonomy: "scene"))) %>
    </div>
  </div>
  <div class="col-12">
    <div class="page-eyebrow"><%= t("scenes.show.facts.section_group") %></div>
    <% grouping = scene_grouping_label(scene, @section_paths) %>
    <% if grouping.present? %>
      <p class="mb-0"><%= link_to grouping, universe_story_sections_path(story_id: story), class: "text-break" %></p>
    <% else %>
      <p class="mb-0 text-body-secondary"><%= t("scenes.show.facts.section_blank") %></p>
    <% end %>
  </div>
  <div class="col-12">
    <div class="page-eyebrow"><%= t("scenes.show.facts.plots") %></div>
    <% if scene.plots.any? %>
      <p class="mb-0">
        <% scene.plots.each do |plot| %>
          <%= link_to plot.name, universe_story_plot_path(story_id: story, id: plot), class: "badge rounded-pill text-bg-light border text-decoration-none me-1" %>
        <% end %>
      </p>
    <% else %>
      <p class="mb-0 text-body-secondary"><%= t("scenes.show.facts.plots_blank") %></p>
    <% end %>
  </div>
  <div class="col-12">
    <div class="page-eyebrow"><%= t("tropes.assignments.scene_heading") %></div>
    <%= render "shared/trope_assignments_summary", assignments: scene.scene_tropes %>
  </div>
  <div class="col-12">
    <div class="page-eyebrow"><%= t("scenes.show.facts.events") %></div>
    <% if scene.scene_events.any? %>
      <%# The Event's own label is chrome plus the author's own title, so it is
          resolved in the reader's language and interpolated into the sentence
          rather than translated: translating it inside the model would put one
          locale's chrome into the search index. The links are listed in the
          Scene's own order, and a role is the author's own words. %>
      <ul class="list-unstyled mb-0">
        <% scene.scene_events.sort_by { |link| [ link.position, link.id ] }.each do |link| %>
          <li class="mb-1">
            <%= link_to link.event.display_label, universe_event_path(id: link.event), class: "text-break" %>
            <% if link.role.present? %>
              <span class="badge rounded-pill text-bg-light border"><%= link.role %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
      <%# Only a writer can change the links, so the instruction to do so is
          hidden from a reader; the tab strip above still offers the page. %>
      <% if can_write_universe? %>
        <div class="form-text">
          <%= t("scenes.show.facts.events_hint_html",
            workspace: link_to(t("scenes.show.facts.events_workspace"),
              universe_story_scene_scene_events_path(story_id: story, scene_id: scene))) %>
        </div>
      <% end %>
    <% else %>
      <p class="mb-0 text-body-secondary"><%= t("scenes.show.facts.events_blank") %></p>
    <% end %>
  </div>
  <div class="col-12">
    <div class="page-eyebrow"><%= t("scenes.show.facts.in_world_time") %></div>
    <% in_world_time = scene_in_world_time(scene) %>
    <% if in_world_time.present? %>
      <p class="mb-0"><%= in_world_time %></p>
    <% else %>
      <p class="mb-0 text-body-secondary"><%= t("scenes.show.facts.in_world_time_blank") %></p>
    <% end %>
    <div class="form-text"><%= t("scenes.show.facts.in_world_time_hint") %></div>
  </div>
  <div class="col-12">
    <div class="page-eyebrow"><%= t("scenes.show.facts.point_of_view") %></div>
    <% if scene.pov_character.present? %>
      <p class="mb-0"><%= link_to scene.pov_character.name, universe_character_path(universe_slug: story.universe.slug, id: scene.pov_character), class: "text-break" %></p>
      <div class="form-text"><%= t("scenes.show.facts.point_of_view_hint") %></div>
    <% else %>
      <p class="mb-0 text-body-secondary"><%= t("scenes.show.facts.point_of_view_blank") %></p>
    <% end %>
  </div>
  <div class="col-12">
    <div class="page-eyebrow"><%= t("scenes.show.facts.story") %></div>
    <p class="mb-0"><%= link_to story.name, universe_story_path(id: story) %></p>
  </div>
</div>
