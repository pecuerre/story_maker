<% content_for :title, t("memberships.index.title") %>

<%= render "shared/page_header",
  title: t("memberships.index.title"),
  eyebrow: Current.universe.name,
  description: t("memberships.index.description"),
  count: @memberships.size + 1,
  count_label: "member" do %>
  <%= link_to t("memberships.index.back"), universe_path(Current.universe), class: "btn btn-outline-secondary" %>
<% end %>

<% if @membership.errors.any? %>
  <%= render "shared/error_summary", record: @membership, subject: t("memberships.subject") %>
<% end %>

<div class="row g-4">
  <div class="col-lg-5">
    <div class="surface-card p-4">
      <div class="page-eyebrow"><%= t("memberships.index.grant_eyebrow") %></div>
      <h2 class="h4"><%= t("memberships.index.grant_title") %></h2>
      <p class="text-body-secondary">
        <%= t("memberships.index.grant_description") %>
      </p>

      <%= form_with scope: :membership,
        url: universe_memberships_path(universe_slug: Current.universe.slug),
        class: "form-surface" do |form| %>
        <div class="mb-3">
          <%= form.label :email_address, t("memberships.form.email_address"), class: "form-label" %>
          <%= form.email_field :email_address, class: "form-control", required: true %>
        </div>
        <div class="mb-3">
          <%= form.label :access_level, t("memberships.form.access_level"), class: "form-label" %>
          <%= form.select :access_level,
            membership_access_level_options,
            { include_blank: t("memberships.form.choose_level") },
            class: "form-select", required: true %>
        </div>
        <%= form.submit t("memberships.form.submit"), class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>

  <div class="col-lg-7">
    <div class="content-surface">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead>
            <tr>
              <th scope="col"><%= t("memberships.index.columns.member") %></th>
              <th scope="col"><%= t("memberships.index.columns.access") %></th>
              <th scope="col" class="text-end"><%= t("memberships.index.columns.actions") %></th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>
                <div class="fw-semibold"><%= Current.universe.owner.name %></div>
                <div class="small text-body-secondary"><%= Current.universe.owner.email_address %></div>
              </td>
              <td><span class="badge text-bg-primary"><%= t("memberships.access_levels.admin") %></span></td>
              <td class="text-end"><span class="small text-body-secondary"><%= t("memberships.index.owner") %></span></td>
            </tr>

            <% @memberships.each do |membership| %>
              <% own_membership = membership.user == Current.user %>
              <tr>
                <td>
                  <div class="fw-semibold"><%= membership.user.name %></div>
                  <div class="small text-body-secondary"><%= membership.user.email_address %></div>
                </td>
                <td>
                  <span class="badge text-bg-primary"><%= t("memberships.access_levels.#{membership.access_level}") %></span>
                  <% unless own_membership %>
                    <%= form_with scope: :membership,
                      url: universe_membership_path(universe_slug: Current.universe.slug, id: membership),
                      method: :patch,
                      class: "d-flex align-items-center gap-2 ms-2" do |form| %>
                      <%= form.select :access_level,
                        membership_access_level_options,
                        { selected: membership.access_level },
                        { class: "form-select form-select-sm",
                          aria: { label: t("memberships.index.access_level_aria", name: membership.user.name) } } %>
                      <%= form.submit t("memberships.index.save"), class: "btn btn-sm btn-outline-secondary" %>
                    <% end %>
                  <% end %>
                </td>
                <td class="text-end">
                  <% if own_membership %>
                    <span class="small text-body-secondary"><%= t("memberships.index.you") %></span>
                  <% else %>
                    <%= button_to t("memberships.index.remove"), universe_membership_path(universe_slug: Current.universe.slug, id: membership),
                      method: :delete,
                      class: "btn btn-sm btn-outline-danger",
                      data: { turbo_confirm: t("memberships.index.remove_confirm", name: membership.user.name) } %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
