<nav class="navbar navbar-expand-lg fixed-top border-bottom bg-dark navbar-dark" aria-label="Primary navigation">
  <div class="container-fluid px-3 px-lg-4">
    <%= link_to "Universe Maker", root_path, class: "navbar-brand fw-bold" %>

    <button class="navbar-toggler" type="button"
      data-bs-toggle="collapse"
      data-bs-target="#primary-navigation"
      aria-controls="primary-navigation"
      aria-expanded="false"
      aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="primary-navigation">
      <ul class="navbar-nav me-auto align-items-lg-center gap-lg-1">
        <li class="nav-item dropdown">
          <button class="nav-link dropdown-toggle" type="button"
            data-bs-toggle="dropdown"
            aria-expanded="false">
            Universes
          </button>
          <ul class="dropdown-menu dropdown-menu-dark">
            <% nav_universes.each do |universe| %>
              <li>
                <%= link_to universe.name, universe_path(universe),
                  class: "dropdown-item#{' active' if Current.universe == universe}" %>
              </li>
            <% end %>
            <% if nav_universes.empty? %>
              <li><span class="dropdown-item-text text-body-secondary">No universes yet</span></li>
            <% end %>
            <li><hr class="dropdown-divider"></li>
            <li><%= link_to "All universes", universes_path, class: "dropdown-item" %></li>
            <% if Current.user.present? %>
              <li><%= link_to "New universe", new_universe_path, class: "dropdown-item" %></li>
            <% end %>
          </ul>
        </li>

        <% if Current.universe.present? %>
          <li class="nav-item dropdown">
            <button class="nav-link dropdown-toggle active" type="button"
              data-bs-toggle="dropdown"
              aria-expanded="false"
              aria-current="true">
              Universe: <span class="navbar-context"><%= Current.universe.name %></span>
            </button>
            <ul class="dropdown-menu dropdown-menu-dark">
              <li>
                <%= link_to Current.universe.name, universe_path(Current.universe), class: "dropdown-item active" %>
              </li>
              <li><hr class="dropdown-divider"></li>
              <li><%= link_to "All universes", universes_path, class: "dropdown-item" %></li>
              <% if Current.user.present? %>
                <li><%= link_to "New universe", new_universe_path, class: "dropdown-item" %></li>
              <% end %>
              <% if can_administer_universe? %>
                <li><%= link_to "Manage members", universe_memberships_path, class: "dropdown-item" %></li>
              <% end %>
            </ul>
          </li>

          <li class="nav-item dropdown">
            <button class="nav-link dropdown-toggle<%= ' active' if Current.story.present? %>" type="button"
              data-bs-toggle="dropdown"
              aria-expanded="false"<% if Current.story.present? %> aria-current="true"<% end %>>
              Story: <span class="navbar-context"><%= Current.story&.name || "Select" %></span>
            </button>
            <ul class="dropdown-menu dropdown-menu-dark">
              <% nav_stories.each do |story| %>
                <li>
                  <%= link_to story.name, universe_story_path(id: story),
                    class: "dropdown-item#{' active' if Current.story == story}" %>
                </li>
              <% end %>
              <% if nav_stories.empty? %>
                <li><span class="dropdown-item-text text-body-secondary">No stories yet</span></li>
              <% end %>
              <li><hr class="dropdown-divider"></li>
              <li><%= link_to "All stories", universe_stories_path, class: "dropdown-item" %></li>
              <% if can_write_universe? %>
                <li><%= link_to "New story", new_universe_story_path, class: "dropdown-item" %></li>
              <% end %>
            </ul>
          </li>
        <% end %>
      </ul>

      <div class="navbar-actions ms-auto mt-3 mt-lg-0">
        <% if Current.user.present? %>
          <div class="dropdown">
            <button class="btn btn-outline-light btn-sm dropdown-toggle" type="button"
              data-bs-toggle="dropdown"
              aria-expanded="false">
              Account
            </button>
            <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
              <li>
                <span class="dropdown-item-text navbar-account-label" title="<%= Current.user.email_address %>">
                  <%= Current.user.email_address %>
                </span>
              </li>
              <li><hr class="dropdown-divider"></li>
              <li>
                <%= button_to "Log out", session_path,
                  method: :delete,
                  class: "dropdown-item" %>
              </li>
            </ul>
          </div>
        <% else %>
          <%= link_to "Log in", new_session_path, class: "btn btn-outline-light btn-sm" %>
        <% end %>
      </div>
    </div>
  </div>
</nav>
