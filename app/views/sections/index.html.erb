<% content_for :title, "Sections" %>

<h1>Sections</h1>

<%= render "shared/taxonomy_tree",
	nodes: @sections,
	new_url: ->(parent = nil) { new_universe_section_path(parent_id: parent&.id) },
	create_url: universe_sections_path(),
	edit_url: ->(section) { edit_universe_section_path(id: section) },
	update_url: ->(section) { universe_section_path(id: section) },
	delete_url: ->(section) { universe_section_path(id: section) },
	model_param: "section",
	taxonomy_field: "section_tag_ids",
	modal_fields: section_taxonomy_fields(@section_tags) %>