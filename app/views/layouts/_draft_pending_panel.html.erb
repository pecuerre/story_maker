<%# The reader's own pending work, in the sidebar that already leads with a way
    # into it.
    #
    # The **Pending changes** entry beside this answers "where are they"; this
    # answers "what are they", so a reader who is told their change was remembered
    # can see the same fact on every page of the universe instead of having to open
    # the draft to find out whether anything is waiting at all.
    #
    # It is a **glance, not a second drafts page**: it is rendered on every page of the
    # universe, so its cost is every page rather than one. Two bounds keep that cost
    # fixed rather than per row. `DraftPreview::PANEL_LIMIT` caps how many rows it prints
    # and the rest is counted rather than hidden, and the rows it does print are resolved
    # together by `DraftChanges::Reader` — one query per record class rather than one per
    # change, which is finding 66's second half. A panel with no draft behind it resolves
    # nothing at all.
    #
    # It is rendered only where a draft can exist — a `direct` universe never opens
    # one, and a draft belongs to a person — and it renders at **zero** as well as
    # at any count, because the entry beside it is also how a reader with nothing
    # pending reaches the history.
    #
    # The **Pending changes** entry is a sibling `<li>` rather than a child: the
    # shared link partial is itself a list item, and a list item inside a list item
    # is invalid HTML that a parser hoists back out, which would quietly move the
    # entry outside the panel it belongs to. %>
<% preview = local_assigns.fetch(:preview) %>
<li class="draft-pending-panel">
  <p class="draft-pending-summary">
    <i class="bi bi-journal-text" aria-hidden="true"></i>
    <span><%= t("drafts.pending.count", count: preview.count) %></span>
  </p>

  <% if preview.any? %>
    <ul class="draft-pending-changes list-unstyled mb-0">
      <%# The panel's own slice is passed down so every row shares one
          `DraftChanges::Reader`: one query per record class rather than one per change,
          on every page of the universe. `DraftPreview#panel_changes` memoizes, so this
          is one array rather than one per row. %>
      <% panel_changes = preview.panel_changes %>
      <% panel_changes.each do |change| %>
        <%# Read through the panel's own changes rather than one row at a time: the
            reader resolves every record the panel shows in one query per class, and it
            answers nil for a remembered create without asking, which is what this row
            used to do by hand — a create names no record, so asking was a lookup that
            could not answer. See `DraftChanges::Reader` and finding 66. %>
        <% record = draft_change_record(change, panel_changes) %>
        <li class="draft-pending-change">
          <span class="badge rounded-pill text-bg-light border"><%= t("drafts.actions.#{change.action}") %></span>
          <span class="text-break"><%= draft_change_subject(change, record) %></span>
        </li>
      <% end %>
    </ul>

    <% if preview.hidden_change_count.positive? %>
      <p class="draft-pending-more mb-0"><%= t("drafts.pending.panel.more", count: preview.hidden_change_count) %></p>
    <% end %>
  <% else %>
    <p class="draft-pending-more mb-0"><%= t("drafts.pending.panel.empty") %></p>
  <% end %>
</li>