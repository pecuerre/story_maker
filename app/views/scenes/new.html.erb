<% content_for :title, t("scenes.new_title") %>

<%= render "shared/page_header",
  title: t("scenes.new_title"),
  eyebrow: t("shared.eyebrow.story", story: @story.name),
  description: t("scenes.new_description", story: @story.name) %>

<%= render "shared/content_tabs",
  aria_label: t("sidebar.story_workspace"),
  tabs: story_workspace_tabs(@story) %>

<%= render "form", scene: @scene, section_paths: @section_paths, event_options: @event_options %>
