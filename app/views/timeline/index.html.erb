<% content_for :title, t("sidebar.timeline") %>

<div class="timeline-wrapper" data-controller="timeline" data-timeline-edges-value="<%= @edges.to_json %>">
  <%= render "shared/page_header",
    title: t("sidebar.timeline"),
    eyebrow: t("sidebar.universe_bible"),
    count: @layers.sum(&:size),
    count_label: "event" do %>
    <% if can_write_universe? %>
      <%= link_to t("timeline.add_event"), universe_events_path, class: "btn btn-primary" %>
    <% end %>
  <% end %>

  <%# The Timeline is the second tab of the Event workspace rather than a page of
      its own, so it carries the same strip as the Events list and the sentence
      below it that the strip introduces. The strip is built by the same helper, so
      the Timeline tab is the active one here and the Events tab is active there. %>
  <%= render "shared/content_tabs",
    aria_label: t("events.tabs_aria_label"),
    intro: t("timeline.description"),
    tabs: content_workspace_tabs(:event) %>

  <% if @layers.blank? || @layers.all?(&:empty?) %>
    <%= render "shared/empty_state",
      title: t("timeline.empty_title"),
      description: can_write_universe? ? t("timeline.empty_writable_description") : t("timeline.empty_read_only_description"),
      icon: "calendar-range" %>
  <% else %>
    <div class="surface-card p-3 p-md-4">
      <div class="timeline-track" data-timeline-target="track">
        <svg class="timeline-svg" data-timeline-target="svg"></svg>
        <% @layers.each do |layer| %>
          <% next if layer.empty? %>
          <div class="timeline-layer">
            <div class="timeline-layer-marker">
              <span class="timeline-dot"></span>
            </div>
            <div class="timeline-layer-events">
              <% layer.each do |event| %>
                <button type="button"
                  class="timeline-node"
                  id="timeline-event-<%= event.id %>"
                  data-timeline-target="node"
                  data-event-id="<%= event.id %>"
                  style="background-color: <%= event.event_tags.first&.bgcolor || '#d3d3d3' %>; color: <%= event.event_tags.first&.fgcolor || '#000000' %>;"
                  aria-label="<%= event_node_aria_label(event) %>"
                  data-bs-toggle="popover"
                  data-bs-trigger="hover focus click"
                  data-bs-custom-class="custom-popover"
                  data-bs-html="true"
                  data-bs-placement="right"
                  data-bs-title="<%= event_popover_title(event) %>"
                  data-bs-content="<%= event_popover_content(event) %>">
                  <%= event.id %>
                </button>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
