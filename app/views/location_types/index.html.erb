<p style="color: green"><%= notice %></p>

<% content_for :title, "Location types" %>

<h1>Location types</h1>

<%= render "shared/taxonomy_tree",
  nodes: @location_types,
  new_url: ->(parent = nil) { new_story_location_type_path(story_slug: Current.story.slug, parent_id: parent&.id) },
  create_url: story_location_types_path(story_slug: Current.story.slug),
  edit_url: ->(location_type) { edit_story_location_type_path(story_slug: Current.story.slug, id: location_type) },
  update_url: ->(location_type) { story_location_type_path(story_slug: Current.story.slug, id: location_type) },
  delete_url: ->(location_type) { story_location_type_path(story_slug: Current.story.slug, id: location_type) },
  model_param: "location_type",
  modal_fields: [
    { name: "name", label: "Name", type: "text" },
    { name: "description", label: "Description", type: "textarea" }
  ] %>
