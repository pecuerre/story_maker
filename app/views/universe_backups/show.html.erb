<% content_for :title, t("universe_backups.show.title") %>

<%= render "shared/page_header",
  title: t("universe_backups.show.title"),
  eyebrow: t("universe_backups.show.eyebrow"),
  description: t("universe_backups.show.description") do %>
  <%= link_to universe_backup_download_path, class: "btn btn-primary" do %>
    <i class="bi bi-download" aria-hidden="true"></i>
    <span><%= t("universe_backups.show.download") %></span>
  <% end %>
<% end %>

<div class="surface-card p-4">
  <h2 class="h4"><%= t("universe_backups.show.contents_title") %></h2>
  <ul class="mb-0">
    <li><%= t("universe_backups.show.contents.data") %></li>
    <li><%= t("universe_backups.show.contents.photos") %></li>
    <li><%= t("universe_backups.show.contents.content") %></li>
  </ul>
</div>

<div class="surface-card p-4 mt-3">
  <h2 class="h4"><%= t("universe_backups.show.deferred_title") %></h2>
  <p class="mb-0"><%= t("universe_backups.show.deferred") %></p>
</div>
