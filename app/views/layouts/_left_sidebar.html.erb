<div class="py-4">

<% if Current.universe.present? %>

  <div class="card flex-column mb-4 nav">
    <div class="card-header bg-primary text-white">
      WHAT
    </div>
    <ul class="list-group list-group-flush">
      <li class="list-group-item">
        <%= link_to icon_text_count("file-text", "Stories"), "#",
          class: "nav-link px-0 link-secondary" %>
      </li>
      <li class="list-group-item">
        <%= link_to icon_text_count("file-text", "Plot"), "#",
          class: "nav-link px-0 link-secondary" %>
      </li>
      <li class="list-group-item">
        <%= link_to icon_text_count("globe", "World Building"), "#",
          class: "nav-link px-0 link-secondary" %>
      </li>
    </ul>
  </div>

  <div class="card flex-column mb-4 nav">
    <div class="card-header bg-primary text-white">
      HOW
    </div>
    <ul class="list-group list-group-flush">
      <li class="list-group-item">
        <%= link_to icon_text_count("film", "Scenes"), "#",
          class: "nav-link px-0 link-secondary" %>
      </li>
      <li class="list-group-item <%= active_if(:sections, :section_types) %>">
        <div class="d-flex align-items-center justify-content-between">
          <%= link_to icon_text_count("list-nested", "Sections", Current.universe.sections.count),
            universe_sections_path(),
            class: "nav-link px-0#{active_if(:sections)}"
          %>
          <% if visible?(:sections, :section_types) %>
            <%= link_to icon("gear"),
              universe_section_types_path(),
              class: "nav-link px-0#{active_if(:section_types)}"
            %>
          <% end %>
        </div>
      </li>
    </ul>
  </div>


  <div class="card flex-column mb-4 nav">
    <div class="card-header bg-danger text-white">
      WHO
    </div>
    <ul class="list-group list-group-flush">
      <li class="list-group-item <%= active_if(:characters, :character_types) %>">
        <div class="d-flex align-items-center justify-content-between">
          <%= link_to icon_text_count("person", "Characters", Current.universe.characters.count),
            universe_characters_path(),
            class: "nav-link px-0#{active_if(:characters)}"
          %>
          <% if visible?(:characters, :character_types) %>
            <%= link_to icon("gear"),
              universe_character_types_path(),
              class: "nav-link px-0#{active_if(:character_types)}"
            %>
          <% end %>
        </div>
      </li>
      <li class="list-group-item <%= active_if(:relations, :relation_types) %>">
        <div class="d-flex align-items-center justify-content-between">
          <%= link_to icon_text_count("people", "Relations", Current.universe.relations.count),
            universe_relations_path(),
            class: "nav-link px-0#{active_if(:relations)}"
          %>
          <% if visible?(:relations, :relation_types) %>
            <%= link_to icon("gear"),
              universe_relation_types_path(),
              class: "nav-link px-0#{active_if(:relation_types)}"
            %>
          <% end %>
        </div>
      </li>
      <li class="list-group-item">
        <%= link_to icon_text_count("person-plus", "Meetings"), "#",
          class: "nav-link px-0 link-secondary" %>
      </li>
      <li class="list-group-item">
        <%= link_to icon_text_count("chat-dots", "Dialogs"),
          "#", class: "nav-link px-0 link-secondary" %>
      </li>
    </ul>
  </div>

  <div class="card flex-column mb-4 nav">
    <div class="card-header bg-danger text-white">
      WHERE
    </div>
    <ul class="list-group list-group-flush">
      <li class="list-group-item <%= active_if(:locations, :location_types) %>">
        <div class="d-flex align-items-center justify-content-between">
          <%= link_to icon_text_count("geo-alt", "Locations", Current.universe.locations.count),
            universe_locations_path(),
            class: "nav-link px-0#{active_if(:locations)}"
          %>
          <% if visible?(:locations, :location_types) %>
            <%= link_to icon("gear"),
              universe_location_types_path(),
              class: "nav-link px-0#{active_if(:location_types)}"
            %>
          <% end %>
        </div>
      </li>
      <li class="list-group-item">
        <%= link_to icon_text_count("sign-turn-right", "Routes"), "#",
          class: "nav-link px-0 link-secondary" %>
      </li>
      <li class="list-group-item">
        <%= link_to icon_text_count("map", "Map"), "#",
          class: "nav-link px-0 link-secondary" %>
      </li>
      <li class="list-group-item">
        <%= link_to icon_text_count("rulers", "Distances"), "#",
          class: "nav-link px-0 link-secondary" %>
      </li>
      <li class="list-group-item">
        <%= link_to icon_text_count("bounding-box-circles", "Connections"), "#",
          class: "nav-link px-0 link-secondary" %>
      </li>
    </ul>
  </div>

  <div class="card flex-column mb-4 nav">
    <div class="card-header bg-danger text-white">
      WHEN
    </div>
    <ul class="list-group list-group-flush">
      <li class="list-group-item <%= active_if(:events, :event_types) %>">
        <div class="d-flex align-items-center justify-content-between">
          <%= link_to icon_text_count("calendar-event", "Events", Current.universe.events.count),
            universe_events_path(),
            class: "nav-link px-0#{active_if(:events)}"
          %>
          <% if visible?(:events, :event_types) %>
            <%= link_to icon("gear"),
              universe_event_types_path(),
              class: "nav-link px-0#{active_if(:event_types)}"
            %>
          <% end %>
        </div>
      </li>
      <li class="list-group-item <%= active_if(:timeline) %>">
        <%= link_to icon_text_count("calendar-range", "Timeline"),
          universe_timeline_path(),
          class: "nav-link px-0#{active_if(:timeline)}" %>
      </li>
    </ul>
  </div>

  <div class="card flex-column mb-4 nav">
    <div class="card-header bg-danger text-white">
      WITH
    </div>
    <ul class="list-group list-group-flush">
      <li class="list-group-item <%= active_if(:items, :item_types) %>">
        <div class="d-flex align-items-center justify-content-between">
          <%= link_to icon_text_count("box-seam", "Items", Current.universe.items.count),
            universe_items_path(),
            class: "nav-link px-0#{active_if(:items)}"
          %>
          <% if visible?(:items, :item_types) %>
            <%= link_to icon("gear"),
              universe_item_types_path(),
              class: "nav-link px-0#{active_if(:item_types)}"
            %>
          <% end %>
        </div>
      </li>
      <li class="list-group-item <%= active_if(:ownerships, :ownership_types) %>">
        <div class="d-flex align-items-center justify-content-between">
          <%= link_to icon_text_count("person-bounding-box", "Ownerships", Current.universe.ownerships.count),
            universe_ownerships_path(),
            class: "nav-link px-0#{active_if(:ownerships)}"
          %>
          <% if visible?(:ownerships, :ownership_types) %>
            <%= link_to icon("gear"),
              universe_ownership_types_path(),
              class: "nav-link px-0#{active_if(:ownership_types)}"
            %>
          <% end %>
        </div>
      </li>
    </ul>
  </div>
<% end %>

</div>