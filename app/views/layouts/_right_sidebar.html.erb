<% tag_controllers = %i[
  tags character_tags relation_tags location_tags event_tags item_tags ownership_tags section_tags scene_tags
] %>

<nav class="right-navigation" aria-label="<%= t("sidebar.tools.navigation_label") %>">
  <div class="sidebar-context sidebar-context--tools right-sidebar-intro">
    <div class="sidebar-eyebrow"><%= t("sidebar.tools.eyebrow") %></div>
    <p><%= t("sidebar.tools.intro") %></p>
  </div>

  <section class="sidebar-section sidebar-section--tools" aria-labelledby="configuration-title">
    <h3 class="sidebar-section-title" id="configuration-title"><%= t("sidebar.tools.configuration") %></h3>
    <ul class="sidebar-list">
      <%= render "shared/sidebar_link",
        icon: "tags",
        label: t("sidebar.tools.tags"),
        path: universe_tags_path,
        controllers: tag_controllers %>

      <%# Members is the admin-only half of Configuration: a guest or read-only
          member still gets Tags, so the list itself is never conditional. %>
      <% if can_administer_universe? %>
        <%= render "shared/sidebar_link",
          icon: "people",
          label: t("sidebar.tools.members"),
          path: universe_memberships_path,
          controllers: %i[ memberships ] %>
      <% end %>
    </ul>
  </section>

  <section class="sidebar-section sidebar-section--tools" aria-labelledby="collaboration-tools-title">
    <h3 class="sidebar-section-title" id="collaboration-tools-title"><%= t("sidebar.tools.collaboration") %></h3>
    <ul class="sidebar-list">
      <%# The one live block in this group, and it is a panel rather than a link:
          the reader's own pending work has to be reachable from somewhere — an
          editor who is told their change was remembered and then cannot find it
          has no way to see it, apply it, or throw it away — and it has to be
          readable from somewhere too, because the alternative is opening the draft
          to discover whether anything is waiting at all. The **Pending changes**
          link at the foot of it is the way into the full list and the history.

          Both are offered only where a draft can exist (a `direct` universe never
          opens one, and a draft belongs to a person) and neither depends on the
          reader having something pending: an entry that appears and disappears
          with a count is an entry whose absence needs explaining.

          **Review requests** below is the same group read from the other side: other
          people's work waiting for this reader to decide, rather than this reader's
          own. It is offered on `admin` alone — the whole of
          `ReviewRequestsController`'s authorization — and in every mode. %>
      <% if draft_preview.available? %>
        <%= render "layouts/draft_pending_panel", preview: draft_preview %>

        <%= render "shared/sidebar_link",
          icon: "journal-text",
          label: t("sidebar.tools.pending_changes"),
          path: universe_drafts_path,
          controllers: %i[ drafts ] %>
      <% end %>

      <%# Somebody else's submitted work, and the one entry here that answers for a
          reader rather than about them: a plain writer is not a reader of this queue,
          because the list is itself an answer to "what is waiting here". Its figure
          counts what is **waiting** rather than what the queue holds, so a decided
          universe reads zero — which is not a reason for the entry to disappear, since
          it is also how a reviewer reads who let a change through. %>
      <% if can_administer_universe? %>
        <%= render "shared/sidebar_link",
          icon: "inbox",
          label: t("sidebar.tools.review_requests"),
          path: universe_review_requests_path,
          controllers: %i[ review_requests ],
          count: pending_review_request_count,
          count_label: "request" %>
      <% end %>

      <%# What has happened in this universe, which is the third kind of answer in
          this group: not the reader's own work, not what a reviewer must decide, but
          what the universe already holds. It is gated on `admin` because the page
          names every author who has closed a draft here, and on `draft_based?`
          because a `direct` universe remembers nothing, so it has no runs to list —
          the entry would lead to a page that can only ever be empty. %>
      <% if can_administer_universe? && Current.universe.draft_based? %>
        <%= render "shared/sidebar_link",
          icon: "clock-history",
          label: t("sidebar.tools.history"),
          path: universe_history_path,
          controllers: %i[ histories ],
          count: closed_draft_count,
          count_label: "draft" %>

        <%# Who has done any of it. **This figure counts people and the one above
            counts runs**, which is the whole reason these are two entries and not one
            filtered page: a single figure cannot answer both "how many of us have
            worked here" and "how much has happened". Same two gates as the history
            beside it, for the same reasons — it names every author, and a `direct`
            universe has none. %>
        <%= render "shared/sidebar_link",
          icon: "people",
          label: t("sidebar.tools.collaborators"),
          path: universe_collaborators_path,
          controllers: %i[ collaborators ],
          count: collaborator_count,
          count_label: "collaborator" %>
      <% end %>
    </ul>
  </section>

  <section class="sidebar-section sidebar-section--tools" aria-labelledby="analytics-tools-title">
    <h3 class="sidebar-section-title" id="analytics-tools-title"><%= t("sidebar.tools.analytics") %></h3>
    <ul class="sidebar-list">
      <li>
        <%= link_to icon_text_count("bar-chart-line", t("sidebar.tools.insights")), "#",
          class: "sidebar-link sidebar-placeholder-link",
          aria: { disabled: true },
          data: { placeholder_link: true } %>
      </li>
      <li>
        <%= link_to icon_text_count("file-earmark-bar-graph", t("sidebar.tools.reports")), "#",
          class: "sidebar-link sidebar-placeholder-link",
          aria: { disabled: true },
          data: { placeholder_link: true } %>
      </li>
    </ul>
  </section>

  <section class="sidebar-section sidebar-section--tools" aria-labelledby="ai-tools-title">
    <h3 class="sidebar-section-title" id="ai-tools-title"><%= t("sidebar.tools.ai") %></h3>
    <ul class="sidebar-list">
      <li>
        <%= link_to icon_text_count("stars", t("sidebar.tools.assistant")), "#",
          class: "sidebar-link sidebar-placeholder-link",
          aria: { disabled: true },
          data: { placeholder_link: true } %>
      </li>
    </ul>
  </section>
</nav>
