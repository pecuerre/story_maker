<% content_for :title, @item_tag.name %>

<%= render "shared/record_details",
  record: @item_tag,
  eyebrow: "Configuration · Tags",
  label: "Item tag",
  facts: [
    detail_fact("Scope", "Tags are optional labels. This taxonomy belongs to the universe and is shared by every story in it."),
    detail_fact("Description", @item_tag.description, blank: "No description yet."),
    detail_fact("Color", @item_tag.bgcolor, blank: "No background color set. An untinted tag is still shown with its name.")
  ],
  back_url: universe_item_tags_path,
  back_label: "All item tags" do %>
  <%= render "shared/menu_tag_content_tabs", tag_type: "item", tag: @item_tag %>
<% end %>

<% if @item_tag.taggable %>
  <%= render "shared/include_descendants_toggle" %>

  <%= render "shared/detail_section",
    title: "Items with this tag",
    count: @tagged_records.size,
    count_label: "item",
    icon: "box-seam",
    empty_title: "No items carry this tag",
    empty_description: "Nothing uses this tag yet. Tags are optional, so items can stay untagged." do %>
    <%= render "shared/tagged_record_list",
      records: @tagged_records,
      path: ->(record) { universe_item_path(id: record) } %>
  <% end %>
<% else %>
  <%= render "shared/tagged_records_by_child_tag",
    child_tags: @child_tags,
    records_by_child_tag: @records_by_child_tag,
    tags_by_record: @tags_by_record,
    count_label: "item",
    icon: "box-seam",
    path: ->(record) { universe_item_path(id: record) } %>
<% end %>
