<% content_for :title, t("drafts.show.title") %>

<%= render "shared/page_header",
  title: t("drafts.show.title"),
  eyebrow: Current.universe.name,
  description: t(Current.universe.github? ? "drafts.show.review_description" : "drafts.show.description"),
  count: @draft.draft_changes.size,
  count_label: "change" do %>
  <%= link_to t("drafts.show.back"), universe_drafts_path, class: "btn btn-outline-secondary" %>

  <%# The only page in the application whose `show` carries mutation controls,
      because acting on a draft is what this page is for. They exist only while
      the draft can still be acted on: an applied or discarded draft is history, and a
      control that would do nothing is worse than no control.

      **Which control is primary is the universe's mode.** A `wikipedia` universe
      applies the draft here and now; a `github` universe hands it to a reviewer, so
      the same place offers a form with a field rather than a button with a
      confirmation — see `drafts/_submission` for why the submission is a form and
      not a `button_to`. The server enforces the same split, so this is where the
      rule is *read*, not where it is *decided*. %>
  <% if @draft.open? %>
    <%# A `github` universe offers no apply here at all — its decision is the handover
        below, beside the message it carries, which is not a control the header's row
        of buttons can hold. Discard stays in the header because it needs no
        explanation and is not the decision the mode is about: it is the way out of
        this draft in either mode. %>
    <% unless Current.universe.github? %>
      <%= button_to t("drafts.show.apply"), apply_universe_draft_path(id: @draft),
        class: "btn btn-primary",
        data: { turbo_confirm: t("drafts.show.apply_confirm") } %>
    <% end %>
    <%= button_to t("drafts.show.discard"), discard_universe_draft_path(id: @draft),
      class: "btn btn-outline-danger",
      data: { turbo_confirm: t("drafts.show.discard_confirm") } %>
  <% end %>
<% end %>

<%# What the applier could not read, said before the author presses anything rather
    than as a 404 afterwards. The same notice renders behind an apply that was
    refused for it, from the same `DraftIntegrity` — see `shared/_draft_damaged`. %>
<%= render "shared/draft_damaged", damaged: @damaged %>

<%# The same guide the list carries, because this page and that list are one place
    for this workflow: the list is where an author finds out something is waiting
    and this page is where they decide about it, and a guide that vanished on
    arrival would explain the workflow only to the reader who had not started it.
    See `drafts/_workflow_guide`. %>
<%= render "drafts/workflow_guide" %>

<div class="content-surface">
  <div class="list-group list-group-flush">
    <div class="list-group-item draft-summary d-flex align-items-center gap-2 flex-wrap">
      <span class="badge rounded-pill text-bg-light border"><%= t("drafts.statuses.#{@draft.status}") %></span>
      <%= t("drafts.show.remembered_at_html",
        at: time_tag(@draft.created_at, l(@draft.created_at, format: :short))) %>
    </div>

    <%# A closed draft's own history: when it stopped being actionable and what its
        run did, in one sentence per outcome. It is the same sentence the drafts
        list prints for this draft's row, read from the same helper, so the list
        and this page cannot disagree about the run (ADR 0024). %>
    <% if @draft.closed? %>
      <div class="list-group-item draft-history">
        <%= draft_history_sentence(@draft) %>
      </div>
    <% end %>

    <%# Where this draft's submission stands, from the author's side. It is here and
        not only on the reviewer's page because the author is the person waiting:
        a `github` universe can hold a draft for days, and "did anybody look at
        this?" has to be answerable without being an admin or opening somebody
        else's queue. Rendered from the stored request rather than derived from the
        draft's status, because a rejected submission leaves the draft saying
        `draft` — the rejection is the fact, and only the request carries it.
        See `drafts/_submission_status`. %>
    <% if Current.universe.github? && @review_request %>
      <%= render "drafts/submission_status", review_request: @review_request %>
    <% end %>

    <%# A draft remembers at least one change whenever the remembering path could
        finish, so an empty one is a defect the page states rather than hides —
        and an author who got here by pressing **Apply** deserves to be told it
        had nothing to write. %>
    <% if @draft.draft_changes.any? %>
      <%= render partial: "drafts/change", collection: @draft.draft_changes, as: :change %>
    <% else %>
      <div class="list-group-item">
        <%= render "shared/empty_state",
          title: t("drafts.show.empty_title"),
          description: t("drafts.show.empty_description"),
          icon: "journal-text" %>
      </div>
    <% end %>
  </div>
</div>

<%# The submission form, only where there is something to submit and only in the
    mode that has a reviewer. It is below the changes rather than in the page
    header because it is a form with a field in it, and the header is a row of
    buttons; that is the same reason a reviewer's approval moved out of its page
    header in slice 5.2. %>
<%= render "drafts/submission", draft: @draft if Current.universe.github? && @draft.draft? %>