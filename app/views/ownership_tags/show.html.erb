<% content_for :title, @ownership_tag.name %>

<%= render "shared/record_details",
  record: @ownership_tag,
  eyebrow: t("tags.show.eyebrow"),
  label: t("tags.types.ownership.record_label"),
  **tag_identity_details(@ownership_tag),
  back_url: universe_ownership_tags_path,
  back_label: t("tags.types.ownership.all_label") %>

<%= render "shared/include_descendants_toggle" %>

<%= render "shared/detail_section",
  title: t("tags.types.ownership.records_title"),
  count: @tagged_records.size,
  count_label: "ownership",
  icon: "person-check",
  empty_title: t("shared.detail_section.empty_title", determiner: t("shared.detail_section.determiners.none_masculine"), label: t("ownership", count: 1)),
  empty_description: t("tags.types.ownership.unused_description") do %>
  <%= render "shared/tagged_record_list",
    records: @tagged_records,
    path: ->(record) { universe_ownership_path(id: record) } %>
<% end %>
