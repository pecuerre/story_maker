<% content_for :title, t("locations.title") %>

<%= render "shared/taxonomy_tree",
  title: t("locations.title"),
  description: t("locations.description"),
  eyebrow: t("sidebar.universe_bible"),
  count: @hierarchy.records.length,
  count_label: "location",
  new_label: t("locations.new_label"),
  tabs_aria_label: t("locations.tabs_aria_label"),
  tabs: content_workspace_tabs(:location),
  empty_description: t("locations.empty_description"),
  read_only_empty_description: t("locations.read_only_empty_description"),
  confirm_message: ->(location) { t("locations.delete_confirm", name: location.name) },
  nodes: @locations,
  hierarchy: @hierarchy,
  filter: @list_filter,
  filter_path: universe_locations_path,
  filter_total: @location_total,
  filter_shown: @hierarchy.records.length,
  filter_count_label: "location",
  filter_tag_param: :location_tag_id,
  filter_tag_choices: @all_location_tags.map { |tag| [ tag.name, tag.id ] },
  filter_tag_name: @list_filter.location_tag&.name,
  create_url: universe_locations_path,
  update_url: ->(location) { universe_location_path(id: location) },
  model_param: "location",
  taxonomy_field: "location_tag_ids",
  details_url: ->(location) { universe_location_path(id: location) },
  modal_fields: location_taxonomy_fields(@location_tags, @location_options) %>
