<% content_for :title, @item.name %>

<%= render "shared/record_details",
  record: @item,
  eyebrow: "Universe Bible",
  label: "Item",
  facts: [
    detail_fact("Universe", link_to(Current.universe.name, universe_path(id: Current.universe))),
    detail_fact("Item tags", entity_tag_badge(@item), blank: "No tags assigned. Tags are optional."),
    detail_fact("Description", @item.description, blank: "No description yet.")
  ],
  back_url: universe_items_path,
  back_label: "All items" %>

<%= render "shared/detail_section",
  title: "Related information",
  icon: "box-seam",
  empty_title: "Nothing related yet",
  empty_description: "Who owns this item, and which events it appears in, will be listed here as the universe grows." %>
