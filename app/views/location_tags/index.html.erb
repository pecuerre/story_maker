<% content_for :title, t("tags.types.location.title") %>

<%= render "shared/taxonomy_tree",
  title: t("tags.types.location.title"),
  description: t("tags.types.location.description"),
  eyebrow: t("sidebar.universe_bible"),
  count: Current.universe.location_tags.count,
  count_label: "tag",
  new_label: t("tags.types.location.new_label"),
  tag_workspace_scope: "universe",
  tag_workspace_taxonomy: "location",
  empty_description: t("tags.types.location.empty_description"),
  read_only_empty_description: t("tags.types.location.read_only_empty_description"),
  nodes: @location_tags,
  hierarchy: @hierarchy,
  create_url: universe_location_tags_path,
  update_url: ->(location_tag) { universe_location_tag_path(id: location_tag) },
  model_param: "location_tag",
  details_url: ->(location_tag) { universe_location_tag_path(id: location_tag) },
  details_count: ->(tag) { @tagged_counts.fetch(tag.id, 0) },
  details_count_label: "location",
  modal_fields: location_tag_taxonomy_fields(@hierarchy.records) %>
