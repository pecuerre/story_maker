<% content_for :title, t("review_requests.show.title") %>

<%= render "shared/page_header",
  title: t("review_requests.show.title"),
  eyebrow: Current.universe.name,
  description: t("review_requests.show.description"),
  count: @review_request.draft.draft_changes.size,
  count_label: "change" do %>
  <%= link_to t("review_requests.show.back"), universe_review_requests_path, class: "btn btn-outline-secondary" %>
<% end %>

<%# Said before the reviewer presses anything, and again behind an approval that was
    refused for it, from the same `DraftIntegrity` — see `shared/_draft_damaged`. %>
<%= render "shared/draft_damaged", damaged: @damaged %>

<div class="content-surface">
  <div class="list-group list-group-flush">
    <div class="list-group-item review-request-summary d-flex align-items-center gap-2 flex-wrap">
      <span class="badge rounded-pill text-bg-light border"><%= t("review_requests.statuses.#{@review_request.status}") %></span>
      <%# Who submitted, and when. The author is named rather than linked: their own
          drafts page is theirs to read, and this row is about the submission. %>
      <span class="review-request-submitted-by">
        <%= t("review_requests.show.submitted_by_html",
          author: record_label(@review_request.submitted_by),
          at: time_tag(@review_request.created_at, l(@review_request.created_at, format: :short))) %>
      </span>
    </div>

    <%# What the decision said. `ReviewRequest` requires notes for a rejection and
        leaves them optional for an approval, so this line is here for whichever
        reviewer wrote something — and the author reads it on their own draft's page,
        beside the status of the submission it belongs to. %>
    <% if @review_request.review_notes.present? %>
      <div class="list-group-item review-request-notes">
        <%= t("review_requests.index.notes", notes: @review_request.review_notes) %>
      </div>
    <% end %>

    <%# The author's own sentence, above the changes rather than below them: it is
        the context for reading the diffs, so it is the first thing said after the
        summary. Optional by design — a handover with nothing to add is still a
        handover — so the block is absent rather than empty. %>
    <% if @review_request.submission_message.present? %>
      <div class="list-group-item review-request-submission-message">
        <span class="review-request-message-label"><%= t("review_requests.show.submission_message_label") %></span>
        <%= simple_format(@review_request.submission_message, class: "mb-0") %>
      </div>
    <% end %>

    <%# A withdrawn submission is history: the author discarded the draft it was
        about, so there is nothing to approve and nothing to reject. It says that is
        what happened, because a queue row that simply stopped appearing would leave
        a reviewer unable to tell a withdrawal from a mistake. The moment is the **draft's**
        # `closed_at` rather than this row's `created_at`, which is when it was submitted —
        # `withdraw!` closes the draft in the same transaction, so that is the one column
        # that says when it stopped being actionable. %>
    <% if @review_request.withdrawn? %>
      <div class="list-group-item review-request-withdrawn">
        <%= t("review_requests.show.withdrawn_html",
          at: time_tag(@review_request.draft.closed_at, l(@review_request.draft.closed_at, format: :short))) %>
      </div>
    <% end %>

    <%# The changes, through the draft's own partial: a reviewer reads a remembered
        value — a tag id list, a photo, a scope column — exactly as its author reads
        it, because this is the same partial and therefore the same reading of one
        change. %>
    <% if @review_request.draft.draft_changes.any? %>
      <%= render partial: "drafts/change", collection: @review_request.draft.draft_changes, as: :change %>
    <% else %>
      <div class="list-group-item">
        <%= render "shared/empty_state",
          title: t("review_requests.show.empty_title"),
          description: t("review_requests.show.empty_description"),
          icon: "journal-text" %>
      </div>
    <% end %>
  </div>
</div>

<% if @review_request.pending? %>
  <%# The decision is offered only while there is one to make. A decided request is
      history, and a control that would refuse rather than act is worse than no
      control: the answer it would give is a redirect with a reason, which the reader
      has to read to learn what the badge already said. %>
  <%# Two forms rather than one control and one form, because an approval carries
      notes too: a reviewer's note is for the author, and a note they can only leave
      by rejecting would say the opposite of what most approvals mean. The notes are
      the same column both ways and the same wording is not — only a rejection has to
      say why — so the two fields are told apart by their own ids rather than sharing
      one binding. %>
  <section class="surface-card p-4 mt-3 review-request-decisions">
    <%= form_with(url: approve_universe_review_request_path(id: @review_request), method: :post,
      class: "review-request-approval mb-4",
      data: { turbo_confirm: t("review_requests.show.apply_confirm") }) do %>
      <%= label_tag "approve_notes", t("review_requests.show.apply_notes"), class: "form-label" %>
      <%= text_area_tag "review_request[review_notes]", review_notes_field, rows: 3,
        id: "approve_notes", class: "form-control" %>
      <p class="page-description"><%= t("review_requests.show.apply_notes_hint") %></p>

      <div class="page-actions d-flex align-items-center flex-wrap gap-2 mt-3">
        <%= submit_tag t("review_requests.show.apply"), class: "btn btn-primary" %>
      </div>
    <% end %>

    <%# The rejection posts to its own action and never to this page's, and one
        without notes re-renders here with the reason rather than redirecting — a
        redirect would discard what the reviewer typed, which is the rule every other
        form in the application follows. %>
    <div class="review-request-rejection">
      <h2 class="h5"><%= t("review_requests.show.reject") %></h2>
      <p class="page-description"><%= t("review_requests.show.reject_notes_hint") %></p>

      <%= form_with(model: @review_request, scope: :review_request, method: :post,
        url: reject_universe_review_request_path(id: @review_request)) do |form| %>
        <% if @review_request.errors.any? %>
          <%= render "shared/error_summary", record: @review_request %>
        <% end %>

        <%= form.label :review_notes, t("review_requests.show.reject_notes"), class: "form-label" %>
        <%= form.text_area :review_notes, rows: 3, class: "form-control" %>

        <div class="page-actions d-flex align-items-center flex-wrap gap-2 mt-3">
          <%= form.submit t("review_requests.show.reject_submit"), class: "btn btn-outline-danger" %>
        </div>
      <% end %>
    </div>
  </section>
<% end %>