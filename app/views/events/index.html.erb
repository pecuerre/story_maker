<% content_for :title, t("events.title") %>
<%# The list has two empty states because it has two audiences: a writer is told
    to add the first event, and a guest or read-only member is only told what an
    event is. Both are chrome, so both are keys. A remembered create counts as
    something to show, or a writer who has added an event in a universe that
    remembers changes would be told they have none.

    A *filtered* list that matched nothing is a third case and never says
    "no events yet": the universe has events, the filters did not match them,
    and offering "add the first one" beside that message would answer the wrong
    question. %>

<% narrowed = @list_filter.narrowed? %>
<% empty_description = can_write_universe? ? t("events.empty_writable_description") : t("events.empty_read_only_description") %>
<%# A remembered Event create belongs to this universe's list, but **not to a
    filtered one**: it names no record, so it cannot match a text, a tag, or a
    date range. A reader who only *sorted* the list still sees their own pending
    work, because a sort selects nothing. %>
<% pending_creates = narrowed ? [] : draft_pending_creates_for(Event) %>

<div
  <% if can_write_universe? %>data-controller="modal-form"<% end %>
  data-modal-form-model-param-value="event"
  data-modal-form-response-value="json"
  data-modal-form-create-title-value="<%= t("events.new_title") %>">
  <%= render "shared/page_header",
    title: t("events.title"),
    eyebrow: t("sidebar.universe_bible"),
    count: @events.size,
    count_label: "event" do %>
    <% if can_write_universe? %>
      <button type="button" class="btn btn-primary"
        data-action="modal-form#open"
        data-modal-form-url="<%= universe_events_path %>"
        data-modal-form-method="post"
        data-modal-form-title="<%= t("events.new_title") %>"
        data-modal-form-values-value="{}">
        <i class="bi bi-plus-lg" aria-hidden="true"></i>
        <span><%= t("events.add") %></span>
      </button>
    <% end %>
  <% end %>

  <%= render "shared/content_tabs",
    aria_label: t("events.tabs_aria_label"),
    intro: t("events.description"),
    tabs: content_workspace_tabs(:event) %>

  <%= render "events/filter",
    filter: @list_filter,
    total: @event_total,
    shown: @events.size %>

  <% if @events.any? || pending_creates.any? %>
    <div class="content-surface entity-list">
      <div class="list-group list-group-flush">
        <% @events.each do |event| %>
          <div class="list-group-item entity-row d-flex align-items-center gap-3">
            <div class="entity-copy flex-grow-1">
              <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="entity-title"><%= event.display_label %></span>
                <%= entity_tag_badge(event) %>
                <%= render "shared/draft_pending_badge", record: event %>
              </div>
              <% if event.description.present? %>
                <div class="entity-description"><%= event.description %></div>
              <% end %>
            </div>

            <%= record_details_link universe_event_path(id: event), record: event %>

            <%= render "shared/row_actions",
              record: event,
              label: t("event", count: 1),
              record_name: event.display_label,
              confirm_text: t("events.delete_confirm", name: event.display_label),
              edit_url: universe_event_path(id: event),
              delete_url: universe_event_path(id: event),
              delete_via: :json,
              values: event_fields_json(event) %>
          </div>
        <% end %>

        <%= render partial: "shared/draft_pending_rows", collection: pending_creates, as: :record %>
      </div>
    </div>
  <% elsif narrowed %>
    <%# A filter that matched nothing is not an universe without events, so it
        says which filters produced nothing, repeats them, and offers the way
        back. %>
    <div class="content-surface p-3 p-md-4">
      <%= render "shared/empty_state",
        title: t("events.no_match_title"),
        description: t("events.no_match_description",
          universe: Current.universe.name, total: count_with_label(@event_total, "event")),
        icon: "filter" do %>
        <span class="d-block mb-3">
          <% event_filter_summaries(@list_filter).each do |summary| %>
            <span class="badge rounded-pill text-bg-light border me-1"><%= summary %></span>
          <% end %>
        </span>
        <%= link_to t("events.filter.clear"), universe_events_path, class: "btn btn-primary" %>
      <% end %>
    </div>
  <% else %>
    <%= render "shared/empty_state",
      title: t("events.empty_title"),
      description: empty_description,
      icon: "calendar-event" %>
  <% end %>

  <% if can_write_universe? %>
    <div class="modal fade" tabindex="-1"
    aria-labelledby="event-modal-title"
    aria-hidden="true"
    data-modal-form-target="modal">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title fs-5" id="event-modal-title" data-modal-form-target="title"><%= t("events.new_title") %></h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t("shared.form.close") %>"></button>
        </div>
        <%= form_with scope: :event,
          url: universe_events_path,
          method: :post,
          data: { modal_form_target: "form", action: "modal-form#save" } do |form| %>
          <div class="modal-body">
            <%= render "shared/modal_errors" %>
            <p class="text-body-secondary small">
              <%= t("events.form.hint") %>
            </p>
            <div class="mb-3">
              <%= form.label :title, t("events.form.title"), class: "form-label" %>
              <%= form.text_field :title, class: "form-control" %>
            </div>
            <%= render "shared/photo_field", param: "event" %>
            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <%= form.label :start_datetime, t("events.form.start_datetime"), class: "form-label" %>
                <%# `step: 1` matches `ApplicationHelper::DATETIME_LOCAL_FORMAT`, which
                    serializes the stored seconds into the trigger that prefills this
                    control: a whole-minute step could not hold them and would drop
                    them on save. %>
                <%= form.datetime_local_field :start_datetime, class: "form-control", step: 1 %>
              </div>
              <div class="col-md-6">
                <%= form.label :end_datetime, t("events.form.end_datetime"), class: "form-label" %>
                <%= form.datetime_local_field :end_datetime, class: "form-control", step: 1 %>
              </div>
            </div>
            <div class="mb-3">
              <%= form.label :description, t("events.form.description"), class: "form-label" %>
              <%= form.text_area :description, class: "form-control", rows: 3 %>
            </div>
            <div class="mb-3">
              <%= form.label :event_tag_ids, t("events.form.tags_label"), class: "form-label" %>
              <%= form.collection_select :event_tag_ids, @assignable_event_tags, :id, :name,
                {},
                { class: "form-select", multiple: true, data: { controller: "tom-select" } } %>
            </div>
            <%# The three temporal references carry event ids, so the option values
                are ids in every language and only the labels beside them move.
                `modal-form-exclude-self` is what keeps the modal from offering
                the event being edited as one of its own references: the server
                still sends every universe event, because one modal form serves
                every row and the row is only known in the browser. `Event`'s
                `cannot_reference_self` and three database check constraints
                remain the authority; this is the browser not offering a choice
                the server would refuse. See docs/delivery_history.md. %>
            <div class="row g-3">
              <div class="col-md-4">
                <%= form.label :before_event_id, t("events.form.before_event"), class: "form-label" %>
                <%= form.collection_select :before_event_id, @events_for_select, :id, :display_label,
                  { include_blank: t("shared.none") },
                  { class: "form-select", data: { modal_form_exclude_self: true } } %>
              </div>
              <div class="col-md-4">
                <%= form.label :after_event_id, t("events.form.after_event"), class: "form-label" %>
                <%= form.collection_select :after_event_id, @events_for_select, :id, :display_label,
                  { include_blank: t("shared.none") },
                  { class: "form-select", data: { modal_form_exclude_self: true } } %>
              </div>
              <div class="col-md-4">
                <%= form.label :simultaneous_event_id, t("events.form.simultaneous_event"), class: "form-label" %>
                <%= form.collection_select :simultaneous_event_id, @events_for_select, :id, :display_label,
                  { include_blank: t("shared.none") },
                  { class: "form-select", data: { modal_form_exclude_self: true } } %>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t("shared.form.cancel") %></button>
            <%= form.submit t("events.save"), class: "btn btn-primary", data: { modal_form_target: "submit" } %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  <% end %>
</div>
