<% content_for :title, t("canon_rules.title") %>
<%# The list has three empty states: a writer is told to add the first rule, a
    guest or read-only member is only told what a rule is, and a *filtered* list
    that matched nothing says which filters produced nothing rather than "no
    canon rules yet". %>
<% narrowed = @list_filter.narrowed? %>
<% empty_description = can_write_universe? ? t("canon_rules.empty_writable_description") : t("canon_rules.empty_read_only_description") %>
<%# A remembered create belongs to this universe's list, but **not to a filtered
    one**: it names no record, so it cannot match a text, type, or owner filter.
    A reader who only *sorted* the list still sees their own pending work,
    because a sort selects nothing. %>
<% pending_creates = narrowed ? [] : draft_pending_creates_for(CanonRule) %>
<% rejected = @canon_rule&.errors&.any? ? @canon_rule : nil %>
<% add_values = rejected&.new_record? ? canon_rule_fields_json(rejected) : "{}" %>

<div
  <% if can_write_universe? %>data-controller="modal-form"<% end %>
  data-modal-form-model-param-value="canon_rule"
  data-modal-form-response-value="html"
  data-modal-form-create-title-value="<%= t("canon_rules.new_title") %>">
  <%= render "shared/page_header", title: t("canon_rules.title"), eyebrow: t("canon_rules.eyebrow"),
    description: t("canon_rules.description"),
    count: @canon_rules.size, count_label: "canon_rule" do %>
    <% if can_write_universe? %>
      <button type="button" class="btn btn-primary" data-action="modal-form#open"
        data-modal-form-url="<%= universe_canon_rules_path(**@list_filter.query_params) %>" data-modal-form-method="post"
        data-modal-form-title="<%= t("canon_rules.new_title") %>" data-modal-form-values-value="<%= add_values %>">
        <i class="bi bi-plus-lg" aria-hidden="true"></i> <span><%= t("canon_rules.add") %></span>
      </button>
    <% end %>
  <% end %>

  <% if rejected %><%= render "shared/error_summary", record: rejected, subject: t("canon_rules.errors.subject") %><% end %>

  <%= render "canon_rules/filter",
    filter: @list_filter,
    total: @canon_rule_total,
    shown: @canon_rules.size %>
  <% if @canon_rules.any? || pending_creates.any? %>
    <div class="content-surface entity-list"><div class="list-group list-group-flush">
      <% @canon_rules.each do |rule| %>
        <div class="list-group-item entity-row d-flex align-items-center gap-3">
          <div class="entity-copy flex-grow-1">
            <div class="d-flex align-items-center gap-2 flex-wrap">
              <%# The ledger id leads the row: it is how prose and the interchange
                  source cite the rule, so it is the first thing a reader scans
                  rather than a footnote after the statement. %>
              <code class="canon-rule-id"><%= canon_rule_id(rule) %></code>
              <span class="entity-title"><%= rule.display_string %></span>
              <% if rule.canon_type.present? %>
                <span class="badge rounded-pill text-bg-light border"><%= canon_type_label(rule) %></span>
              <% end %>
              <% if rule.category.present? %>
                <span class="badge rounded-pill text-bg-light border"><%= rule.category %></span>
              <% end %>
              <%= render "shared/draft_pending_badge", record: rule %>
            </div>
            <div class="entity-description">
              <%# Prose is plain text with its references reduced to labels: the
                  row already carries its own Details link, so a link inside a
                  two-line preview would compete with it. %>
              <span><%= canon_rule_prose(rule.statement) %></span>
              <span> · </span>
              <% if rule.universe_wide? %>
                <span class="badge rounded-pill text-bg-light border"><%= t("canon_rules.scope.universe") %></span>
              <% else %>
                <span class="badge rounded-pill text-bg-light border"><%= t("canon_rules.scope.story") %></span>
                <%= link_to rule.story.name, universe_story_path(id: rule.story) %>
              <% end %>
              <% if rule.source.present? %><span> · <%= canon_rule_prose(rule.source) %></span><% end %>
            </div>
          </div>
          <%= record_details_link universe_canon_rule_path(id: rule), record: rule %>
          <%= render "shared/row_actions", record: rule, label: t("canon_rule", count: 1),
            record_name: rule.display_string,
            edit_url: universe_canon_rule_path(id: rule, **@list_filter.query_params),
            delete_url: universe_canon_rule_path(id: rule, **@list_filter.query_params),
            values: (rejected&.persisted? && rejected.id == rule.id) ? canon_rule_fields_json(rejected) : canon_rule_fields_json(rule) %>
        </div>
      <% end %>
      <%= render partial: "shared/draft_pending_rows", collection: pending_creates, as: :record %>
    </div></div>
  <% elsif narrowed %>
    <%# A filter that matched nothing is not a universe without canon, so it says
        which filters produced nothing, repeats them, and offers the way back. %>
    <div class="content-surface p-3 p-md-4">
      <%= render "shared/empty_state", title: t("canon_rules.no_match_title"),
        description: t("canon_rules.no_match_description",
          universe: Current.universe.name, total: count_with_label(@canon_rule_total, "canon_rule")),
        icon: "filter" do %>
        <span class="d-block mb-3">
          <% canon_rule_filter_summaries(@list_filter).each do |summary| %>
            <span class="badge rounded-pill text-bg-light border me-1"><%= summary %></span>
          <% end %>
        </span>
        <%= link_to t("canon_rules.filter.clear"), universe_canon_rules_path, class: "btn btn-primary" %>
      <% end %>
    </div>
  <% else %>
    <%= render "shared/empty_state", title: t("canon_rules.empty_title"),
      description: empty_description,
      icon: "journal-check" %>
  <% end %>

  <% if can_write_universe? %>
    <%= render "canon_rules/editor_modal",
      form_url: universe_canon_rules_path(**@list_filter.query_params),
      form_method: :post,
      title: t("canon_rules.new_title"),
      rejected: rejected %>
  <% end %>
</div>
