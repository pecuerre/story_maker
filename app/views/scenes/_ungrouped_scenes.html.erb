<%# The ungrouped end of the Section-grouping workspace.
    A Section is a group, not a story record with a scenes list of its own, so
    the scenes inside a Section are listed on that Section's own page. Only the
    scenes that belong to no Section are listed here, next to the move form that
    groups one of them. This is a second organization view, not a second source
    of order: within the group the scenes stay in canonical narrative order, and
    grouping never changes a scene's position. %>
<% scenes = local_assigns.fetch(:scenes) %>
<% section_paths = local_assigns.fetch(:section_paths) %>
<% story = local_assigns.fetch(:story) %>
<% editable = local_assigns.fetch(:editable) %>
<% ungrouped = scenes.reject { |scene| scene.section_id.present? } %>
<% grouped = scenes.size - ungrouped.size %>
<%# This list is the **Ungrouped** end of the workspace, so a remembered Scene
    create appears here only when it remembers no section: one that names a parent
    would be listed on that Section's own page once it existed, and listing it here
    as well would put the same future record in two places. Its `section_id` is a
    column, so the payload carries it and the record says which. %>
<% pending = draft_pending_creates_for(Scene).reject { |scene| scene.section_id.present? } %>

<div class="content-surface scene-grouping mt-4">
  <div class="p-3 p-md-4 border-bottom">
    <h2 class="h5 mb-1"><%= t("scenes.grouping.title") %></h2>
    <%# The paragraph is one sentence with a link in it, so it is an `_html` key
        with the scenes-list link as the interpolation. The variant that also
        states how many scenes are grouped is a second key rather than a clause
        spliced into the first, because the two clauses do not keep their order
        in every language. %>
    <p class="text-body-secondary mb-0">
      <% if grouped.positive? %>
        <%= t("scenes.grouping.description_with_grouped_html",
          total: count_with_label(grouped, "scene"), story: story.name,
          scenes_list: link_to(t("scenes.form.scenes_list_link"), universe_story_scenes_path(story_id: story))) %>
      <% else %>
        <%= t("scenes.grouping.description_html",
          scenes_list: link_to(t("scenes.form.scenes_list_link"), universe_story_scenes_path(story_id: story))) %>
      <% end %>
    </p>

    <% if scenes.empty? %>
      <%# Nothing to move yet; the empty state below carries the only action. %>
    <% elsif ungrouped.empty? %>
      <%# Everything is grouped, so there is no ungrouped scene to offer. %>
    <% elsif editable %>
      <%# One selector-driven form keeps a single accessible move path for
          grouping, and it only offers the scenes this surface actually lists:
          the form moves a scene out of Ungrouped, and a scene that is already
          grouped is read and regrouped from its own section's page, where its
          editor carries the Section selector. Offering grouped scenes here would
          contradict the section this form lives in. %>
      <%= form_with url: group_universe_story_scenes_path(story_id: story),
        method: :patch,
        class: "row g-2 align-items-end mt-3 scene-grouping-form" do %>
        <div class="col-12 col-md">
          <label class="form-label" for="scene_grouping_scene_id"><%= t("scenes.grouping.move_scene_label") %></label>
          <select class="form-select" name="scene_id" id="scene_grouping_scene_id">
            <% ungrouped.each do |scene| %>
              <option value="<%= scene.id %>">
                <%= "#{scene.position + 1}. #{scene.name}" %>
              </option>
            <% end %>
          </select>
        </div>
        <div class="col-12 col-md">
          <label class="form-label" for="scene_grouping_section_id"><%= t("scenes.grouping.move_to_label") %></label>
          <select class="form-select" name="section_id" id="scene_grouping_section_id">
            <% section_paths.grouping_options.each do |label, value| %>
              <option value="<%= value %>"><%= label %></option>
            <% end %>
          </select>
        </div>
        <div class="col-12 col-md-auto">
          <%= submit_tag t("scenes.grouping.submit"), class: "btn btn-primary", name: nil %>
        </div>
      <% end %>
    <% end %>
  </div>

  <% if scenes.empty? && pending.empty? %>
    <div class="p-3 p-md-4">
      <%= render "shared/empty_state",
        title: t("scenes.grouping.empty_title"),
        description: t("scenes.grouping.empty_description"),
        icon: "film" do %>
        <% if editable %>
          <%= link_to t("scenes.grouping.add_first"), new_universe_story_scene_path(story_id: story), class: "btn btn-primary" %>
        <% end %>
      <% end %>
    </div>
  <% elsif ungrouped.empty? && pending.empty? %>
    <div class="p-3 p-md-4">
      <p class="text-body-secondary mb-0"><%= t("scenes.grouping.all_grouped", story: story.name) %></p>
    </div>
  <% else %>
    <div class="list-group list-group-flush">
      <div class="list-group-item">
        <%# The badge states what the list holds instead of a bare number, because
            this list is a subset of the story and the bare figure is ambiguous
            next to the story's own scene count. Its own pluralized label lives
            here rather than at the root with the record-type nouns, because
            "ungrouped scene" is a state of a scene and not a record type. A
            remembered create counts in it: it is a scene this workspace will hold
            once the draft is applied, and leaving it out would make the figure
            disagree with the rows underneath it. %>
        <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
          <span class="badge rounded-pill text-bg-light border">
            <%= t("scenes.grouping.count", count: ungrouped.size + pending.size) %>
          </span>
        </div>
        <%# The narrative-position pill carries the order, so the list stays
            unordered rather than being an ordered list with its own markers
            suppressed. This list is one Scene's subset, so the badge announces
            the position without a total. A remembered create has no position
            until the applier gives it one, so its row states the record and
            nothing about where it would land in the sequence. %>
        <ul class="list-unstyled mb-0">
          <% ungrouped.each do |scene| %>
            <li class="d-flex align-items-center gap-2 py-1">
              <span class="badge rounded-pill text-bg-light border"
                aria-label="<%= t("shared.scene_position_aria_short", position: scene.position + 1) %>"><%= scene.position + 1 %></span>
              <%= link_to scene.name, universe_story_scene_path(story_id: story, id: scene), class: "text-break" %>
              <%= render "shared/draft_pending_badge", state: draft_pending_state(scene) %>
            </li>
          <% end %>
          <% pending.each do |scene| %>
            <li class="d-flex align-items-center gap-2 py-1 draft-pending-row">
              <%# A remembered Scene create that carries no name is titled by the
                  type it would create, the same answer every other pending row
                  gives and the one a Scene with no title cannot give itself. %>
              <span class="text-break"><%= draft_pending_record_label(scene) %></span>
              <%= render "shared/draft_pending_badge", state: draft_pending_state(scene) %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>
</div>