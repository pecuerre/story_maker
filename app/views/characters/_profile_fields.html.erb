<div class="mb-3">
  <%= form.label :pronouns, t("characters.form.pronouns"), class: "form-label" %>
  <%= form.text_field :pronouns, class: "form-control" %>
</div>
<div class="mb-3">
  <%= form.label :aliases, t("characters.form.aliases"), class: "form-label" %>
  <%= form.text_area :aliases, class: "form-control", rows: 2 %>
  <div class="form-text"><%= t("characters.form.aliases_hint") %></div>
</div>
<div class="mb-3">
  <%= form.label :summary, t("characters.form.summary"), class: "form-label" %>
  <%= form.text_area :summary, class: "form-control", rows: 3 %>
  <div class="form-text"><%= t("characters.form.summary_hint") %></div>
</div>
<div class="mb-3">
  <%= form.label :description, t("characters.form.description"), class: "form-label" %>
  <%= form.text_area :description, class: "form-control font-monospace", rows: 14 %>
  <div class="form-text"><%= t("characters.form.description_hint") %></div>
  <div class="form-text"><%= t("characters.form.description_reference_hint") %></div>
</div>
<div class="mb-3">
  <%= form.label :faction_ids, t("characters.form.factions_label"), class: "form-label" %>
  <%= form.collection_select :faction_ids, factions, :id, :name, {},
    { class: "form-select", multiple: true, data: { controller: "tom-select" } } %>
</div>
