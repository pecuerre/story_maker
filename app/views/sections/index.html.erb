<% content_for :title, t("sections.index.title") %>

<%= render "shared/taxonomy_tree",
  title: t("sections.index.title"),
  description: t("sections.index.description"),
  eyebrow: t("sections.eyebrow", story: @story.name),
  count: @story.sections.count,
  count_label: "section",
  new_label: t("sections.index.new_label"),
  tabs_aria_label: t("sidebar.story_workspace"),
  tabs: [
    { label: t("sidebar.sections"), path: universe_story_sections_path(story_id: @story), controller: :sections },
    { label: t("sidebar.scenes"), path: universe_story_scenes_path(story_id: @story), controller: :scenes }
  ],
  empty_description: t("sections.index.empty_description"),
  read_only_empty_description: t("sections.index.read_only_empty_description"),
  confirm_message: ->(section) { t("sections.index.delete_confirm", name: section.name) },
  nodes: @sections,
  new_url: ->(parent = nil) { new_universe_story_section_path(story_id: @story, parent_id: parent&.id) },
  create_url: universe_story_sections_path(story_id: @story),
  edit_url: ->(section) { edit_universe_story_section_path(story_id: @story, id: section) },
  update_url: ->(section) { universe_story_section_path(story_id: @story, id: section) },
  delete_url: ->(section) { universe_story_section_path(story_id: @story, id: section) },
  model_param: "section",
  taxonomy_field: "section_tag_ids",
  details_url: ->(section) { universe_story_section_path(story_id: @story, id: section) },
  details_count: ->(section) { @scene_counts.fetch(section.id, 0) },
  details_count_label: "scene",
  modal_fields: section_taxonomy_fields(@section_tags, @section_options) %>

<%= render "scenes/ungrouped_scenes",
  story: @story,
  scenes: @scenes,
  section_paths: @section_paths,
  editable: can_write_universe? %>
