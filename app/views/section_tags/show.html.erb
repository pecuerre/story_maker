<% content_for :title, @section_tag.name %>

<%= render "shared/record_details",
  record: @section_tag,
  eyebrow: t("shared.eyebrow.story", story: @story.name),
  label: t("tags.types.section.record_label"),
  **tag_identity_details(@section_tag),
  back_url: universe_story_section_tags_path(story_id: @story),
  back_label: t("tags.types.section.all_label") %>

<%= render "shared/include_descendants_toggle" %>

<%# The empty title is the shared sentence with the record type resolved at
    `count: 1`: the verb takes one noun in either language, so a plural cannot
    follow it. %>
<%= render "shared/detail_section",
  title: t("tags.types.section.records_title"),
  count: @tagged_records.size,
  count_label: "section",
  icon: "list-nested",
  empty_title: t("shared.detail_section.empty_title", determiner: t("shared.detail_section.determiners.none_feminine"), label: t("section", count: 1)),
  empty_description: t("tags.types.section.unused_description") do %>
  <%= render "shared/tagged_record_list",
    records: @tagged_records,
    path: ->(record) { universe_story_section_path(story_id: @story, id: record) } %>
<% end %>