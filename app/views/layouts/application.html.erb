<!DOCTYPE html>
<%# The chosen theme is server-rendered onto the root element, so the very first
    paint is already in the right palette instead of flashing the default one.
    The language is rendered the same way, for the same reason plus one more: a
    screen reader, a browser's hyphenation, and `lang`-dependent CSS all read
    this attribute, so it has to be right on the first paint rather than patched
    in by a script after load. %>
<html lang="<%= AppLocale.html_lang_for(current_locale) %>" data-bs-theme="<%= current_theme %>">
  <head>
    <title><%= content_for(:title) || t("app.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t("app.name") %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="um-page-canvas">
    <a class="visually-hidden-focusable skip-link" href="#main-content"><%= t("layouts.skip_to_content") %></a>

    <%= render "layouts/navbar" %>

    <% if Current.universe.present? %>
      <div class="workspace-shell">
        <aside class="workspace-sidebar offcanvas-lg offcanvas-start"
          tabindex="-1"
          id="workspace-navigation"
          aria-labelledby="workspace-navigation-title">
          <div class="offcanvas-header border-bottom">
            <h2 class="offcanvas-title h5 mb-0" id="workspace-navigation-title"><%= t("layouts.workspace_navigation") %></h2>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="<%= t("layouts.close_navigation") %>"></button>
          </div>
          <div class="offcanvas-body p-0">
            <%= render "layouts/left_sidebar" %>
          </div>
        </aside>

        <main class="workspace-main" id="main-content">
          <div class="mobile-workspace-bar d-xl-none">
            <div class="mobile-workspace-actions">
              <button class="btn btn-outline-primary btn-sm d-lg-none d-inline-flex align-items-center gap-2"
                type="button"
                data-bs-toggle="offcanvas"
                data-bs-target="#workspace-navigation"
                aria-controls="workspace-navigation">
                <i class="bi bi-list" aria-hidden="true"></i>
                <%= t("layouts.menu") %>
              </button>
              <button class="btn btn-outline-secondary btn-sm d-xl-none d-inline-flex align-items-center gap-2"
                type="button"
                data-bs-toggle="offcanvas"
                data-bs-target="#workspace-tools-navigation"
                aria-controls="workspace-tools-navigation">
                <i class="bi bi-stars" aria-hidden="true"></i>
                <%= t("layouts.tools") %>
              </button>
            </div>
            <span class="mobile-workspace-context">
              <%= Current.universe.name %><% if Current.story %> · <%= Current.story.name %><% end %>
            </span>
          </div>

          <div class="page-shell">
            <%= render "shared/mutation_status" %>
            <% if !can_write_universe? %>
              <div class="alert alert-info access-notice" role="status">
                <% if Current.user.present? %>
                  <%= t("layouts.read_only_notice_html", emphasis: t("layouts.read_only") ) %>
                <% else %>
                  <%= t("layouts.guest_notice_html", login_link: link_to(t("layouts.log_in"), new_session_path) ) %>
                <% end %>
              </div>
            <% end %>
            <%= yield %>
          </div>
        </main>

        <aside class="right-sidebar offcanvas-xl offcanvas-end"
          tabindex="-1"
          id="workspace-tools-navigation"
          aria-labelledby="workspace-tools-navigation-title">
          <div class="offcanvas-header border-bottom">
            <h2 class="offcanvas-title h5 mb-0" id="workspace-tools-navigation-title"><%= t("layouts.universe_tools") %></h2>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="<%= t("layouts.close_tools") %>"></button>
          </div>
          <div class="offcanvas-body p-0">
            <%= render "layouts/right_sidebar" %>
          </div>
        </aside>
      </div>
    <% else %>
      <main class="workspace-main workspace-main--full" id="main-content">
        <div class="page-shell">
          <%= render "shared/mutation_status" %>
          <%= yield %>
        </div>
      </main>
    <% end %>
    <%= render "shared/flash" %>
  </body>
</html>
