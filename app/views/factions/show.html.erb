<% content_for :title, @faction.name %>
<%# A Faction with no description keeps the identity card exactly as every
    other record's card is: the wide prose block exists only when there is prose
    to read. %>
<% description_facts = if @faction.description.present?
  [ detail_fact(t("factions.show.facts.description"), markdown_description_html(@faction)) ]
else
  []
end %>

<%= render "shared/record_details",
  record: @faction,
  eyebrow: t("sidebar.universe_bible"),
  label: t("factions.show.label"),
  description: summary_html(@faction),
  facts: [
    detail_fact(t("factions.show.facts.universe"), link_to(Current.universe.name, universe_path(id: Current.universe))),
    detail_fact(t("factions.show.facts.tags"), entity_tag_badge(@faction), blank: t("factions.show.facts.tags_blank"))
  ],
  wide_facts: description_facts,
  back_url: universe_factions_path,
  back_label: t("factions.show.back_label"),
  actions: discussion_control(@faction) do %>
  <%= render "shared/content_tabs",
    aria_label: t("factions.tabs_aria_label"),
    tabs: content_workspace_tabs(:faction) %>
<% end %>

<%= render "factions/characters", characters: @characters %>
