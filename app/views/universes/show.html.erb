<% content_for :title, @universe.name %>
<%# The stories of this universe are listed here instead of behind a second
    click: entering a universe is the point where the next story is chosen. The
    top bar links straight to this page, so it is the landing page for both
    switching stories and starting a new one, and this same ordered story list
    (memoized once per request) is that picker. The header's "All stories" page
    stays for the full list with its own actions. %>
<% stories = nav_stories %>

<%= render "shared/page_header",
  title: @universe.name,
  eyebrow: t("universes.show.eyebrow"),
  description: t("universes.show.description") do %>
  <% if can_write_universe? %>
    <%= link_to new_universe_story_path, class: "btn btn-primary" do %>
      <i class="bi bi-plus-lg" aria-hidden="true"></i>
      <span><%= t("universes.show.new_story") %></span>
    <% end %>
  <% end %>
  <%= link_to t("sidebar.all_stories"), universe_stories_path, class: "btn btn-outline-secondary" %>
  <% if can_administer_universe? %>
    <%= link_to t("sidebar.tools.members"), universe_memberships_path, class: "btn btn-outline-secondary" %>
    <div class="dropdown">
      <button class="btn btn-outline-secondary dropdown-toggle" type="button"
        data-bs-toggle="dropdown" aria-expanded="false" aria-label="<%= t("universes.show.actions_aria") %>">
        <i class="bi bi-three-dots" aria-hidden="true"></i>
      </button>
      <ul class="dropdown-menu dropdown-menu-end">
        <li><%= link_to t("universes.edit"), edit_universe_path(@universe), class: "dropdown-item" %></li>
        <li><hr class="dropdown-divider"></li>
        <li>
          <%= button_to t("universes.delete"), universe_path(@universe),
            method: :delete,
            class: "dropdown-item text-danger",
            data: { turbo_confirm: t("universes.delete_confirm", name: @universe.name) } %>
        </li>
      </ul>
    </div>
  <% end %>
<% end %>

<%# The stories sit above the Universe Bible card, each spanning the whole
    page width, so the story list reads first and both cards keep a full-width
    measure instead of sharing one row. %>
<div class="d-flex flex-column gap-3">
  <section class="surface-card p-4" aria-labelledby="universe-stories-title">
    <div class="page-eyebrow"><%= t("universes.show.stories_eyebrow") %></div>
    <h2 class="h4 mb-3" id="universe-stories-title"><%= count_with_label(stories.size, "story") %></h2>

    <% if stories.any? %>
      <div class="list-group list-group-flush">
        <% stories.each do |story| %>
          <div class="list-group-item entity-row px-0 d-flex align-items-center gap-3">
            <div class="entity-copy flex-grow-1">
              <div class="d-flex align-items-center gap-2 flex-wrap">
                <%= link_to story.name, universe_story_path(id: story), class: "entity-title text-break" %>
                <% if Current.story == story %>
                  <span class="badge text-bg-primary"><%= t("universes.show.current_badge") %></span>
                <% end %>
              </div>
              <% if story.description.present? %>
                <div class="entity-description"><%= story.description %></div>
              <% end %>
            </div>
            <%= link_to t("universes.show.open_story"), universe_story_path(id: story),
              class: "btn btn-sm btn-outline-primary flex-shrink-0",
              aria: { label: t("universes.show.open_story_aria", name: story.name) } %>
          </div>
        <% end %>
      </div>
    <% else %>
      <%= render "shared/empty_state",
        title: t("universes.show.empty_title"),
        description: can_write_universe? ?
          t("universes.show.empty_writable_description") :
          t("universes.show.empty_read_only_description"),
        icon: "books" %>
    <% end %>
  </section>

  <%# The photo occupies the card's own row when there is one, with the
      universe's own summary beside it. With no photo the summary takes the
      whole card, which is how this page looked before. %>
  <div class="surface-card p-4">
    <% if @universe.photo %>
      <div class="row g-4 align-items-start">
        <div class="col-12 col-sm-5 col-lg-4">
          <%= render "shared/record_photo", photo: @universe.photo, name: @universe.name %>
        </div>
        <div class="col-12 col-sm-7 col-lg-8">
          <div class="page-eyebrow"><%= t("sidebar.universe_bible") %></div>
          <h2 class="h4"><%= t("universes.show.bible_heading") %></h2>
          <p class="text-body-secondary"><%= t("universes.show.bible_description") %></p>
          <div class="d-flex flex-wrap gap-2">
            <%= link_to t("sidebar.characters"), universe_characters_path, class: "btn btn-outline-secondary btn-sm" %>
            <%= link_to t("sidebar.locations"), universe_locations_path, class: "btn btn-outline-secondary btn-sm" %>
            <%= link_to t("sidebar.events"), universe_events_path, class: "btn btn-outline-secondary btn-sm" %>
            <%= link_to t("sidebar.timeline"), universe_timeline_path, class: "btn btn-outline-secondary btn-sm" %>
          </div>
        </div>
      </div>
    <% else %>
      <div class="page-eyebrow"><%= t("sidebar.universe_bible") %></div>
      <h2 class="h4"><%= t("universes.show.bible_heading") %></h2>
      <p class="text-body-secondary"><%= t("universes.show.bible_description") %></p>
      <div class="d-flex flex-wrap gap-2">
        <%= link_to t("sidebar.characters"), universe_characters_path, class: "btn btn-outline-secondary btn-sm" %>
        <%= link_to t("sidebar.locations"), universe_locations_path, class: "btn btn-outline-secondary btn-sm" %>
        <%= link_to t("sidebar.events"), universe_events_path, class: "btn btn-outline-secondary btn-sm" %>
        <%= link_to t("sidebar.timeline"), universe_timeline_path, class: "btn btn-outline-secondary btn-sm" %>
      </div>
    <% end %>
  </div>
</div>
