<% content_for :title, @story.name %>

<%= render "shared/page_header",
  title: @story.name,
  eyebrow: t("sidebar.story_workspace"),
  description: @story.description.presence || t("stories.show.default_description"),
  count: @sections.size,
  count_label: "section" do %>
  <%# The overview has one context-aware primary action rather than one link per
      workspace. An empty Story that offers a starting structure leads to that
      card, so the header and the body recommend the same first step; an empty
      Story without one, and one that already has structure, leads to the
      workspace its next task lives in. The other destinations stay in the
      structure card below, and the appearance grid opens from the cast card,
      so the header does not repeat the same three body links. %>
  <% if @story_structure_available && can_write_universe? %>
    <% primary_label = t("stories.structures.heading") %>
    <% primary_path = "#story-start-structure" %>
  <% elsif @story_structure_empty %>
    <% primary_label = t("stories.show.open_sections") %>
    <% primary_path = universe_story_sections_path(story_id: @story) %>
  <% else %>
    <% primary_label = t("stories.show.open_scenes") %>
    <% primary_path = universe_story_scenes_path(story_id: @story) %>
  <% end %>
  <%= link_to primary_label, primary_path, class: "btn btn-primary" %>
  <% if can_write_universe? %>
    <%= link_to t("stories.edit"), edit_universe_story_path(id: @story), class: "btn btn-outline-secondary" %>

    <%= discussion_control(@story) %>

    <div class="dropdown">
      <button class="btn btn-outline-secondary dropdown-toggle" type="button"
        data-bs-toggle="dropdown" aria-expanded="false" aria-label="<%= t("stories.show.actions_aria") %>">
        <i class="bi bi-three-dots" aria-hidden="true"></i>
      </button>
      <ul class="dropdown-menu dropdown-menu-end">
        <li><%= link_to t("sidebar.all_stories"), universe_stories_path, class: "dropdown-item" %></li>
        <li><hr class="dropdown-divider"></li>
        <li>
          <%= button_to t("stories.delete"), universe_story_path(id: @story),
            method: :delete,
            class: "dropdown-item text-danger",
            data: { turbo_confirm: t("stories.delete_confirm", name: @story.name) } %>
        </li>
      </ul>
    </div>
  <% end %>
<% end %>

<div class="row g-3">
  <%# The first-session guide names both ways to start an empty Story: a
      starting structure or a manually built Section and Scene. It is offered to
      a writer only, because a read-only member cannot build, and it disappears
      with the rest of the empty state as soon as the Story has structure. %>
  <% if @story_structure_empty && can_write_universe? %>
    <div class="col-12">
      <%= render "stories/starting_guide", story: @story, structure_available: @story_structure_available %>
    </div>
  <% end %>

  <%# A template is a starting shape, so it is offered only on an empty Story in
      a direct universe. Choosing one creates ordinary Sections and Scenes; the
      card disappears as soon as the Story has either. %>
  <% if @story_structure_available && can_write_universe? %>
    <div class="col-12">
      <div class="surface-card p-4" id="story-start-structure">
        <div class="page-eyebrow"><%= t("stories.structures.eyebrow") %></div>
        <h2 class="h4"><%= t("stories.structures.heading") %></h2>
        <p class="text-body-secondary"><%= t("stories.structures.description") %></p>

        <%= form_with url: apply_structure_universe_story_path(id: @story), method: :post do |form| %>
          <fieldset>
            <legend class="form-label"><%= t("stories.structures.choose") %></legend>
            <% @story_structure_options.each do |entry| %>
              <div class="form-check mb-3">
                <%= form.radio_button :structure_slug, entry.slug, class: "form-check-input",
                  id: "structure_#{entry.slug}", required: true,
                  aria: { describedby: "structure_#{entry.slug}_description" } %>
                <label class="form-check-label" for="structure_<%= entry.slug %>">
                  <span class="fw-semibold"><%= t(entry.name_key) %></span>
                </label>
                <div class="text-body-secondary small" id="structure_<%= entry.slug %>_description">
                  <%= t(entry.description_key) %>
                </div>
                <details class="mt-2">
                  <summary class="small"><%= t("stories.structures.preview") %></summary>
                  <ul class="list-unstyled ms-3 mt-2 mb-0 small">
                    <% entry.acts.each do |act| %>
                      <li class="mb-2">
                        <span class="fw-semibold"><%= t(act.name_key) %></span>
                        <ul class="mb-0">
                          <% act.beats.each do |beat| %>
                            <li>
                              <%= t(beat.name_key) %>
                              <div class="text-body-secondary"><%= t(beat.description_key) %></div>
                            </li>
                          <% end %>
                        </ul>
                      </li>
                    <% end %>
                  </ul>
                </details>
              </div>
            <% end %>
          </fieldset>
          <%= form.submit t("stories.structures.submit"), class: "btn btn-outline-secondary" %>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="col-md-6">
    <div class="surface-card h-100 p-3">
      <%# The Story's photo sits in the left column of the structure card, the
          same place it takes on every record whose page has an identity card.
          With no photo the card reads exactly as it did before photos existed. %>
      <% structure = capture do %>
        <div class="page-eyebrow"><%= t("stories.show.structure_eyebrow") %></div>
        <h2 class="h4"><%= t("stories.show.structure_heading") %></h2>
        <p class="text-body-secondary"><%= t("stories.show.structure_description") %></p>
        <ul class="list-unstyled structure-links mb-0">
          <%# Each row is one destination and the number its page will list, so the
              card states the structure once instead of three equal outline
              buttons followed by the same facts as a separate list. The visible
              count is a bare figure beside its own label; the link's accessible
              name carries the full count phrase. %>
          <li>
            <%= link_to universe_story_sections_path(story_id: @story), class: "structure-link",
              aria: { label: "#{t("stories.show.sections")}, #{count_with_label(@sections.size, "section")}" } do %>
              <span><%= t("stories.show.sections") %></span>
              <span class="structure-link-count" aria-hidden="true"><%= @sections.size %></span>
            <% end %>
          </li>
          <li>
            <%= link_to universe_story_plots_path(story_id: @story), class: "structure-link",
              aria: { label: "#{t("stories.show.plots")}, #{count_with_label(@story.menu_plot_count, "plot")}" } do %>
              <span><%= t("stories.show.plots") %></span>
              <span class="structure-link-count" aria-hidden="true"><%= @story.menu_plot_count %></span>
            <% end %>
          </li>
          <li>
            <%= link_to universe_story_scenes_path(story_id: @story), class: "structure-link",
              aria: { label: "#{t("stories.show.scenes")}, #{count_with_label(@story.menu_scene_count, "scene")}" } do %>
              <span><%= t("stories.show.scenes") %></span>
              <span class="structure-link-count" aria-hidden="true"><%= @story.menu_scene_count %></span>
            <% end %>
          </li>
          <li class="structure-fact">
            <span><%= t("stories.show.words") %></span>
            <span class="structure-link-count"><%= count_with_label(@word_counts.total, "word") %></span>
          </li>
        </ul>

        <%# A draft-based universe cannot remember a batch of creates whose Scenes
            point at Sections the draft has not created yet, so the starting-shape
            control is not offered there. The reason is stated rather than left as
            a missing feature. %>
        <% if @story_structure_empty && can_write_universe? && !Current.universe.direct? %>
          <p class="text-body-secondary small mt-3 mb-0"><%= t("stories.structures.draft_unavailable") %></p>
        <% end %>
      <% end %>

      <% if @story.photo %>
        <div class="row g-4 align-items-start">
          <div class="col-12 col-sm-5 col-lg-4">
            <%= render "shared/record_photo", photo: @story.photo, name: @story.name %>
          </div>
          <div class="col-12 col-sm-7 col-lg-8"><%= structure %></div>
        </div>
      <% else %>
        <%= structure %>
      <% end %>
    </div>
  </div>

  <div class="col-md-6">
    <div class="surface-card h-100 p-3">
      <div class="page-eyebrow"><%= t("tropes.assignments.story_eyebrow") %></div>
      <h2 class="h4"><%= t("tropes.assignments.story_heading") %></h2>
      <%= render "shared/trope_assignments_summary", assignments: @story_tropes %>
      <% if can_write_universe? %>
        <%= link_to t("tropes.assignments.edit_story"), edit_universe_story_path(id: @story), class: "btn btn-sm btn-outline-secondary mt-3" %>
      <% end %>
    </div>
  </div>

  <div class="col-12">
    <div class="surface-card p-3">
      <div class="page-eyebrow"><%= t("stories.show.cast_eyebrow") %></div>
      <h2 class="h4"><%= t("stories.show.cast_heading") %></h2>

      <% if @character_scene_counts.any? %>
        <p class="text-body-secondary">
          <%= t("stories.show.cast_description") %>
        </p>
        <%= render "stories/character_scene_chart", counts: @character_scene_counts %>
      <% elsif @character_scene_counts.scenes? %>
        <%= render "shared/empty_state",
          title: t("stories.show.cast_none_characters_title", story: @story.name),
          description: t("stories.show.cast_none_characters_description"),
          icon: "person" %>
      <% else %>
        <%= render "shared/empty_state",
          title: t("stories.show.cast_none_scenes_title"),
          description: t("stories.show.cast_none_scenes_description"),
          icon: "film" %>
      <% end %>
      <%= link_to t("stories.show.open_appearances"), universe_story_appearances_path(story_id: @story), class: "btn btn-sm btn-outline-secondary mt-3" %>
    </div>
  </div>

  <div class="col-md-6">
    <div class="surface-card h-100 p-3">
      <div class="page-eyebrow"><%= t("stories.show.sections_eyebrow") %></div>
      <h2 class="h4"><%= t("stories.show.sections_heading") %></h2>
      <% if @sections.any? %>
        <ul class="list-unstyled">
          <% roots = @sections.select { |section| section.parent_id.nil? } %>
          <% roots.each do |section| %>
            <li class="mb-2">
              <%= link_to section.name, universe_story_section_path(story_id: @story, id: section), class: "text-decoration-none" %>
              <% children = @sections.select { |child| child.parent_id == section.id } %>
              <% if children.any? %>
                <ul class="list-unstyled ms-4 ps-3 mt-1">
                  <% children.each do |child| %>
                    <li>
                      <%= link_to child.name, universe_story_section_path(story_id: @story, id: child), class: "text-decoration-none text-body-secondary" %>
                    </li>
                  <% end %>
                </ul>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <%= render "shared/empty_state",
          title: t("stories.show.sections_none_title"),
          description: t("stories.show.sections_none_description"),
          icon: "diagram-3" do %>
          <%# While the whole Story is empty the header owns the first step, and the
              structure card already links to Sections, so this empty card does not
              repeat it. A Story with Scenes but no Sections keeps the link, because
              its primary action is writing. %>
          <% if can_write_universe? && !@story_structure_empty %>
            <%= link_to t("stories.show.open_sections"), universe_story_sections_path(story_id: @story), class: "btn btn-primary" %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="col-md-6">
    <div class="surface-card h-100 p-3">
      <div class="page-eyebrow"><%= t("stories.show.recent_eyebrow") %></div>
      <h2 class="h4"><%= t("stories.show.recent_heading") %></h2>
      <% if @recent_sections.any? %>
        <ul class="list-group list-group-flush">
          <% @recent_sections.each do |section| %>
            <li class="list-group-item d-flex align-items-center gap-2">
              <%= link_to section.name, universe_story_section_path(story_id: @story, id: section), class: "text-break flex-grow-1 text-decoration-none" %>
              <span class="badge rounded-pill text-bg-light border"><%= section.position + 1 %></span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <%= render "shared/empty_state",
          title: t("stories.show.recent_none_title"),
          description: t("stories.show.recent_none_description"),
          icon: "clock-history" %>
      <% end %>
    </div>
  </div>

  <div class="col-md-6">
    <div class="surface-card h-100 p-3">
      <div class="page-eyebrow"><%= t("stories.show.bible_eyebrow") %></div>
      <h2 class="h4"><%= t("stories.show.bible_heading") %></h2>
      <p class="text-body-secondary"><%= t("stories.show.bible_description", universe: Current.universe.name) %></p>
      <div class="row g-2">
        <div class="col-sm-6">
          <%= link_to universe_characters_path, class: "quick-link" do %>
            <i class="bi bi-people" aria-hidden="true"></i><%= t("sidebar.characters") %>
          <% end %>
        </div>
        <div class="col-sm-6">
          <%= link_to universe_locations_path, class: "quick-link" do %>
            <i class="bi bi-geo-alt" aria-hidden="true"></i><%= t("sidebar.locations") %>
          <% end %>
        </div>
        <div class="col-sm-6">
          <%= link_to universe_events_path, class: "quick-link" do %>
            <i class="bi bi-calendar-event" aria-hidden="true"></i><%= t("sidebar.events") %>
          <% end %>
        </div>
        <div class="col-sm-6">
          <%= link_to universe_timeline_path, class: "quick-link" do %>
            <i class="bi bi-calendar-range" aria-hidden="true"></i><%= t("sidebar.timeline") %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
