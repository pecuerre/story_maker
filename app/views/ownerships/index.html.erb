<% content_for :title, t("ownerships.title") %>
<% empty_description = can_write_universe? ? t("ownerships.empty_writable_description") : t("ownerships.empty_read_only_description") %>
<%# A rejected submission re-renders this index with the invalid record, so the
    entered values are serialized into the trigger that reopens the editor
    instead of being thrown away: the Add trigger for a rejected create, and only
    the row that was being edited for a rejected update. %>
<% rejected = @ownership&.errors&.any? ? @ownership : nil %>
<% add_values = rejected&.new_record? ? ownership_fields_json(rejected) : "{}" %>

<div
  <% if can_write_universe? %>data-controller="modal-form"<% end %>
  data-modal-form-model-param-value="ownership"
  data-modal-form-response-value="html"
  data-modal-form-create-title-value="<%= t("ownerships.new_title") %>">
  <%= render "shared/page_header",
    title: t("ownerships.title"),
    eyebrow: t("ownerships.eyebrow"),
    count: @ownerships.size,
    count_label: "ownership" do %>
    <% if can_write_universe? %>
      <button type="button" class="btn btn-primary"
        data-action="modal-form#open"
        data-modal-form-url="<%= universe_ownerships_path %>"
        data-modal-form-method="post"
        data-modal-form-title="<%= t("ownerships.new_title") %>"
        data-modal-form-values-value="<%= add_values %>">
        <i class="bi bi-plus-lg" aria-hidden="true"></i>
        <span><%= t("ownerships.add") %></span>
      </button>
    <% end %>
  <% end %>

  <% if rejected %>
    <%= render "shared/error_summary", record: rejected, subject: t("ownerships.errors.subject") %>
  <% end %>

  <%# This strip is passed inline rather than built by `content_workspace_tabs`,
      because that helper appends the universe's pinned Item tags and this page
      has never shown them. Adding them is a navigation change and not a
      translation; the labels are the Item workspace's own, so a reader cannot
      tell the two constructions apart. %>
  <%= render "shared/content_tabs",
    aria_label: t("items.tabs_aria_label"),
    intro: t("ownerships.description"),
    tabs: [
      { label: t("items.tabs.items"), path: universe_items_path, controller: :items },
      { label: t("items.tabs.ownerships"), path: universe_ownerships_path, controller: :ownerships }
    ] %>

  <% if @ownerships.any? %>
    <div class="content-surface entity-list">
      <div class="list-group list-group-flush">
        <% @ownerships.each do |ownership| %>
          <%# See `relations/index`: the same sentence for the same row action. %>
          <div class="list-group-item entity-row d-flex align-items-center gap-3">
            <div class="entity-copy flex-grow-1">
              <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="entity-title"><%= ownership.item.name %></span>
                <%= entity_tag_badge(ownership) %>
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                <span class="entity-title"><%= ownership.character.name %></span>
              </div>
              <% if ownership.description.present? %>
                <div class="entity-description"><%= ownership.description %></div>
              <% end %>
            </div>

            <%= record_details_link universe_ownership_path(id: ownership), record: ownership %>

            <%= render "shared/row_actions",
              record: ownership,
              label: t("ownership", count: 1),
              record_name: t("ownerships.endpoints", first: ownership.character.name,
                second: ownership.item.name),
              edit_url: universe_ownership_path(id: ownership),
              delete_url: universe_ownership_path(id: ownership),
              values: (rejected&.persisted? && rejected.id == ownership.id) ? ownership_fields_json(rejected) : ownership_fields_json(ownership) %>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <%= render "shared/empty_state",
      title: t("ownerships.empty_title"),
      description: empty_description,
      icon: "person-bounding-box" %>
  <% end %>

  <% if can_write_universe? %>
    <div class="modal fade" tabindex="-1"
    aria-labelledby="ownership-modal-title"
    aria-hidden="true"
    data-modal-form-target="modal">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title fs-5" id="ownership-modal-title" data-modal-form-target="title"><%= t("ownerships.new_title") %></h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t("shared.form.close") %>"></button>
        </div>
        <%= form_with scope: :ownership,
          url: universe_ownerships_path,
          method: :post,
          data: { modal_form_target: "form" } do |form| %>
          <div class="modal-body">
            <%# The editor carries the same summary as the page, so reopening it
                after a rejection still explains the refusal. %>
            <% if rejected %>
              <%= render "shared/error_summary", record: rejected, subject: t("ownerships.errors.subject") %>
            <% end %>
            <div class="mb-3">
              <%= form.label :name, t("ownerships.form.name"), class: "form-label" %>
              <%# Optional, and it is what the record's label and the composite
                  slug prefer when it is set, so the field says so instead of
                  implying it is required. %>
              <%= form.text_field :name, class: "form-control" %>
              <div class="form-text"><%= t("ownerships.form.name_hint") %></div>
            </div>
            <%= render "shared/photo_field", param: "ownership" %>
            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <%= form.label :item_id, t("ownerships.item"), class: "form-label" %>
                <%= form.collection_select :item_id, @items, :id, :name,
                  { prompt: t("ownerships.select_item") },
                  { class: "form-select", required: true } %>
              </div>
              <div class="col-md-6">
                <%= form.label :character_id, t("ownerships.character"), class: "form-label" %>
                <%= form.collection_select :character_id, @characters, :id, :name,
                  { prompt: t("ownerships.select_character") },
                  { class: "form-select", required: true } %>
              </div>
            </div>
            <div class="mb-3">
              <%= form.label :ownership_tag_ids, t("ownerships.form.tags_label"), class: "form-label" %>
              <%= form.collection_select :ownership_tag_ids, @ownership_tags, :id, :name,
                {},
                { class: "form-select", multiple: true, data: { controller: "tom-select" } } %>
            </div>
            <div class="mb-3">
              <%= form.label :description, t("ownerships.form.description"), class: "form-label" %>
              <%= form.text_area :description, class: "form-control", rows: 4 %>
            </div>
            <div class="row g-3">
              <div class="col-md-6">
                <%= form.label :from_date, t("ownerships.from"), class: "form-label" %>
                <%# `step: 1` matches `ApplicationHelper::DATETIME_LOCAL_FORMAT`, which
                    serializes the stored seconds into the trigger that prefills this
                    control: a whole-minute step could not hold them and would drop
                    them on save. %>
                <%= form.datetime_local_field :from_date, class: "form-control", step: 1 %>
              </div>
              <div class="col-md-6">
                <%= form.label :to_date, t("ownerships.to"), class: "form-label" %>
                <%= form.datetime_local_field :to_date, class: "form-control", step: 1 %>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t("shared.form.cancel") %></button>
            <%= form.submit t("ownerships.save"), class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  <% end %>
</div>
