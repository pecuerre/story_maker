<%# `draft_change` is not a message: it is the datum `shared/draft_remembered`
    # renders in the page's flow, where it stays for the whole page rather than
    # for a toast's four seconds. Skipping the key here is what keeps the same
    # entry from being printed twice in two different places. %>
<% if flash.any? %>
  <div class="flash-stack" aria-live="polite" data-controller="flash-toast">
    <% flash.each do |type, message| %>
      <% next if type.to_s == "draft_change" %>
      <% next if message.blank? %>
      <% alert_class = type.to_s == "notice" ? "success" : (type.to_s == "alert" ? "danger" : "secondary") %>
      <div class="alert alert-<%= alert_class %> alert-dismissible fade show flash-toast"
        role="alert"
        data-flash-toast-type="<%= alert_class %>"
        data-flash-toast-delay="<%= alert_class == "success" ? 4000 : 10000 %>">
        <%= message %>
        <button type="button" class="btn-close" data-flash-toast-close aria-label="<%= t("shared.flash.close") %>"></button>
      </div>
    <% end %>
  </div>
<% end %>