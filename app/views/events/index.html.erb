<% content_for :title, "Events" %>
<% empty_description = can_write_universe? ? "Add events with dates or relationships to each other, then open the Timeline to see how they connect." : "Events in this universe will appear here once they have been added." %>

<div
  <% if can_write_universe? %>data-controller="modal-form"<% end %>
  data-modal-form-model-param-value="event"
  data-modal-form-create-title-value="New event">
  <%= render "shared/page_header",
    title: "Events",
    eyebrow: "Universe Bible",
    description: "Record moments that shape the universe and provide the structure for its timeline.",
    count: @events.size,
    count_label: "event" do %>
    <% if can_write_universe? %>
      <button type="button" class="btn btn-primary"
        data-action="modal-form#open"
        data-modal-form-url="<%= universe_events_path %>"
        data-modal-form-method="post"
        data-modal-form-title="New event"
        data-modal-form-values-value="{}">
        <i class="bi bi-plus-lg" aria-hidden="true"></i>
        <span>Add event</span>
      </button>
    <% end %>
  <% end %>

  <%= render "shared/content_tabs",
    aria_label: "Event workspace",
    tabs: [
      { label: "Events", path: universe_events_path, controller: :events },
      { label: "Event tags", path: universe_event_tags_path, controller: :event_tags }
    ] %>

  <% if @events.any? %>
    <div class="content-surface entity-list">
      <div class="list-group list-group-flush">
        <% @events.each do |event| %>
          <div class="list-group-item entity-row d-flex align-items-center gap-3">
            <div class="entity-copy flex-grow-1">
              <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="entity-title"><%= event.display_string %></span>
                <%= entity_tag_badge(event) %>
              </div>
              <% if event.description.present? %>
                <div class="entity-description"><%= event.description %></div>
              <% end %>
            </div>

            <%= render "shared/row_actions",
              record: event,
              label: "event",
              record_name: event.display_string,
              edit_url: universe_event_path(id: event),
              delete_url: universe_event_path(id: event),
              values: event_fields_json(event) %>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <%= render "shared/empty_state",
      title: "No events yet",
      description: empty_description,
      icon: "calendar-event" %>
  <% end %>

  <% if can_write_universe? %>
    <div class="modal fade" tabindex="-1"
    aria-labelledby="event-modal-title"
    aria-hidden="true"
    data-modal-form-target="modal">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title fs-5" id="event-modal-title" data-modal-form-target="title">New event</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <%= form_with scope: :event,
          url: universe_events_path,
          method: :post,
          data: { modal_form_target: "form" } do |form| %>
          <div class="modal-body">
            <p class="text-body-secondary small">
              An event needs at least a title, a start or end date, or a relationship to another event below.
            </p>
            <div class="mb-3">
              <%= form.label :title, class: "form-label" %>
              <%= form.text_field :title, class: "form-control" %>
            </div>
            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <%= form.label :start_datetime, "Start date/time", class: "form-label" %>
                <%= form.datetime_local_field :start_datetime, class: "form-control" %>
              </div>
              <div class="col-md-6">
                <%= form.label :end_datetime, "End date/time", class: "form-label" %>
                <%= form.datetime_local_field :end_datetime, class: "form-control" %>
              </div>
            </div>
            <div class="mb-3">
              <%= form.label :description, class: "form-label" %>
              <%= form.text_area :description, class: "form-control", rows: 3 %>
            </div>
            <div class="mb-3">
              <%= form.label :event_tag_ids, "Event tags", class: "form-label" %>
              <%= form.collection_select :event_tag_ids, @event_tags, :id, :name,
                {},
                { class: "form-select", multiple: true, data: { controller: "tom-select" } } %>
            </div>
            <div class="row g-3">
              <div class="col-md-4">
                <%= form.label :before_event_id, "Happens before", class: "form-label" %>
                <%= form.collection_select :before_event_id, @events_for_select, :id, :display_string,
                  { include_blank: "None" },
                  { class: "form-select" } %>
              </div>
              <div class="col-md-4">
                <%= form.label :after_event_id, "Happens after", class: "form-label" %>
                <%= form.collection_select :after_event_id, @events_for_select, :id, :display_string,
                  { include_blank: "None" },
                  { class: "form-select" } %>
              </div>
              <div class="col-md-4">
                <%= form.label :simultaneous_event_id, "Same time as", class: "form-label" %>
                <%= form.collection_select :simultaneous_event_id, @events_for_select, :id, :display_string,
                  { include_blank: "None" },
                  { class: "form-select" } %>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <%= form.submit "Save event", class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  <% end %>
</div>
