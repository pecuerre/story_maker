<p style="color: green"><%= notice %></p>

<% content_for :title, "Section types" %>

<h1>Section types</h1>

<%= render "shared/taxonomy_tree",
	nodes: @section_types,
	new_url: ->(parent = nil) { new_story_section_type_path(story_slug: Current.story.slug, parent_id: parent&.id) },
	edit_url: ->(section_type) { edit_story_section_type_path(story_slug: Current.story.slug, id: section_type) },
	update_url: ->(section_type) { story_section_type_path(story_slug: Current.story.slug, id: section_type) },
	delete_url: ->(section_type) { story_section_type_path(story_slug: Current.story.slug, id: section_type) },
	model_param: "section_type" %>
