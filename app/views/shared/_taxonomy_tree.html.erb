<% nodes = local_assigns.fetch(:nodes) %>
<%# `hierarchy` is required, not defaulted: the tree descends through it at every
    level, so a caller that forgot it would render a flat list of roots with no
    error anywhere. `HierarchyIndex` is what turns one query into that descent. %>
<% hierarchy = local_assigns.fetch(:hierarchy) %>
<% create_url = local_assigns.fetch(:create_url) %>
<% update_url = local_assigns.fetch(:update_url) %>
<% model_param = local_assigns.fetch(:model_param) %>
<% modal_fields = local_assigns.fetch(:modal_fields, []) %>
<% taxonomy_field = local_assigns[:taxonomy_field] %>
<% confirm_message = local_assigns[:confirm_message] %>
<% details_url = local_assigns[:details_url] %>
<% details_count = local_assigns[:details_count] %>
<% details_count_label = local_assigns.fetch(:details_count_label, "item") %>
<%# A caller always passes `title`, `count_label`, and `new_label`; the
    fallbacks below are a guard for a new call site, and are English because a
    class name humanized is not a translatable string. Passing the three
    locals is what keeps a taxonomy page out of this fallback. %>
<% title = local_assigns.fetch(:title, model_param.humanize) %>
<% count = local_assigns[:count] %>
<% count_label = local_assigns[:count_label] || model_param.humanize.downcase.pluralize %>
<% new_label = local_assigns[:new_label] || "Add #{model_param.humanize.downcase}" %>
<% editable = local_assigns.fetch(:editable) { can_write_universe?(universe_for_record(nodes.first) || Current.universe) } %>
<%# A remembered create belongs in the taxonomy that would have held it, and this
    partial is the only place that knows which taxonomy it is drawing. The answer
    is resolved once here because the same one is needed twice below: to decide
    whether the tree is empty, and to render the rows. %>
<% pending_creates = draft_pending_taxonomy_creates(model_param) %>
<% empty_description = if editable
  local_assigns[:empty_description] || t("shared.taxonomy_tree.empty_description")
else
  local_assigns[:read_only_empty_description] || t("shared.taxonomy_tree.read_only_empty_description")
end %>

<div class="taxonomy-tree"
  <% if editable %>data-controller="taxonomy-tree"<% end %>
  data-taxonomy-tree-model-param-value="<%= model_param %>"
  <% if editable %>
    data-taxonomy-tree-create-url-value="<%= create_url %>"
    data-taxonomy-tree-modal-fields-value="<%= modal_fields.to_json %>"
  <% end %>
  data-taxonomy-tree-editable-value="<%= editable %>"
  <% if editable && taxonomy_field %>data-taxonomy-tree-field-name-value="<%= taxonomy_field %>"<% end %>>

  <%= render "shared/page_header",
    title: title,
    eyebrow: local_assigns[:eyebrow],
    count: count,
    count_label: count_label do %>
    <% if local_assigns[:secondary_url].present? %>
      <%= link_to local_assigns.fetch(:secondary_label), local_assigns.fetch(:secondary_url),
        class: "btn btn-outline-secondary" %>
    <% end %>
    <% if editable %>
      <%= button_tag type: "button",
        class: "btn btn-primary",
        data: { action: "taxonomy-tree#add" } do %>
        <i class="bi bi-plus-lg" aria-hidden="true"></i>
        <span><%= new_label %></span>
      <% end %>
    <% end %>
  <% end %>

  <%# The taxonomy's own sentence belongs below its navigation rather than in the
      page header, for the reason `shared/_content_intro` gives. It is rendered here
      rather than handed to the navigation partial because a tree has three ways of
      being reached — the tag workspace's own two strips, a record workspace's tab
      strip, or no navigation at all — and one place after all of them is what keeps
      them reading the same way. %>
  <% if local_assigns[:tag_workspace_scope].present? %>
    <%= render "shared/tag_workspace_navigation",
      scope: local_assigns.fetch(:tag_workspace_scope),
      taxonomy: local_assigns[:tag_workspace_taxonomy] %>
  <% elsif local_assigns[:tabs].present? %>
    <%= render "shared/content_tabs",
      aria_label: local_assigns.fetch(:tabs_aria_label),
      tabs: local_assigns.fetch(:tabs) %>
  <% end %>

  <%= render "shared/content_intro", intro: local_assigns[:description] %>

  <div class="taxonomy-surface">
    <% if editable %>
      <p class="taxonomy-hint">
        <%= t("shared.taxonomy_tree.hint") %>
      </p>
      <p class="visually-hidden" data-taxonomy-tree-status aria-live="polite"></p>
    <% end %>

    <% if nodes.empty? && pending_creates.empty? %>
      <div class="p-3 p-md-4" data-taxonomy-tree-empty>
        <%= render "shared/empty_state",
          title: t("taxonomies.#{model_param}.none_yet"),
          description: empty_description,
          icon: "diagram-3" %>
      </div>
    <% end %>

    <ul class="taxonomy-list list-unstyled mb-0"
      <% if editable %>data-action="dragover->taxonomy-tree#allowDrop drop->taxonomy-tree#drop"<% end %>
      data-drop-parent-id="">
      <% nodes.each do |node| %>
        <%= render "shared/taxonomy_node",
          node: node,
          hierarchy: hierarchy,
          update_url: update_url,
          model_param: model_param,
          modal_fields: modal_fields,
          taxonomy_field: taxonomy_field,
          confirm_message: confirm_message,
          details_url: details_url,
          details_count: details_count,
          details_count_label: details_count_label,
          editable: editable %>
      <% end %>

      <%# After the real roots, and read-only: a remembered create has no id, so it
          has no place in the sequence the tree orders and nothing to drag. %>
      <%= render partial: "shared/draft_pending_nodes", collection: pending_creates, as: :record %>
    </ul>
  </div>
</div>
