<% content_for :title, t("characters.title") %>
<%# The list has two empty states because it has two audiences: a writer is told
    to add the first character, and a guest or read-only member is only told what a
    character is. Both are chrome, so both are keys. %>
<% empty_description = can_write_universe? ? t("characters.empty_writable_description") : t("characters.empty_read_only_description") %>

<div
  <% if can_write_universe? %>data-controller="modal-form"<% end %>
  data-modal-form-model-param-value="character"
  data-modal-form-response-value="json"
  data-modal-form-create-title-value="<%= t("characters.new_title") %>">
  <%= render "shared/page_header",
    title: t("characters.title"),
    eyebrow: t("sidebar.universe_bible"),
    count: @characters.size,
    count_label: "character" do %>
    <% if can_write_universe? %>
      <button type="button" class="btn btn-primary"
        data-action="modal-form#open"
        data-modal-form-url="<%= universe_characters_path %>"
        data-modal-form-method="post"
        data-modal-form-title="<%= t("characters.new_title") %>"
        data-modal-form-values-value="{}">
        <i class="bi bi-plus-lg" aria-hidden="true"></i>
        <span><%= t("characters.add") %></span>
      </button>
    <% end %>
  <% end %>

  <%= render "shared/content_tabs",
    aria_label: t("characters.tabs_aria_label"),
    intro: t("characters.description"),
    tabs: content_workspace_tabs(:character) %>

  <% if @characters.any? %>
    <div class="content-surface entity-list">
      <div class="list-group list-group-flush">
        <% @characters.each do |character| %>
          <div class="list-group-item entity-row d-flex align-items-center gap-3">
            <div class="entity-copy flex-grow-1">
              <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="entity-title"><%= character.name %></span>
                <%= entity_tag_badge(character) %>
              </div>
              <% if character.description.present? %>
                <div class="entity-description"><%= character.description %></div>
              <% end %>
            </div>

            <%= record_details_link universe_character_path(id: character), record: character %>

            <%# `label` titles the edit menu entry, so it is the record type's own
                name rather than a finished phrase. %>
            <%= render "shared/row_actions",
              record: character,
              label: t("character", count: 1),
              record_name: character.name,
              confirm_text: t("characters.delete_confirm", name: character.name),
              edit_url: universe_character_path(id: character),
              delete_url: universe_character_path(id: character),
              delete_via: :json,
              values: character_fields_json(character) %>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <%= render "shared/empty_state",
      title: t("characters.empty_title"),
      description: empty_description,
      icon: "person" %>
  <% end %>

  <% if can_write_universe? %>
    <div class="modal fade" tabindex="-1"
    aria-labelledby="character-modal-title"
    aria-hidden="true"
    data-modal-form-target="modal">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title fs-5" id="character-modal-title" data-modal-form-target="title"><%= t("characters.new_title") %></h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t("shared.form.close") %>"></button>
        </div>
        <%= form_with scope: :character,
          url: universe_characters_path,
          method: :post,
          data: { modal_form_target: "form", action: "modal-form#save" } do |form| %>
          <div class="modal-body">
            <%= render "shared/modal_errors" %>
            <div class="mb-3">
              <%= form.label :name, t("characters.form.name"), class: "form-label" %>
              <%= form.text_field :name, class: "form-control", required: true %>
            </div>
            <%= render "shared/photo_field", param: "character" %>
            <div class="mb-3">
              <%= form.label :character_tag_ids, t("characters.form.tags_label"), class: "form-label" %>
              <%= form.collection_select :character_tag_ids, @character_tags, :id, :name,
                {},
                { class: "form-select", multiple: true, data: { controller: "tom-select" } } %>
            </div>
            <div>
              <%= form.label :description, t("characters.form.description"), class: "form-label" %>
              <%= form.text_area :description, class: "form-control", rows: 4 %>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t("shared.form.cancel") %></button>
            <%= form.submit t("characters.save"), class: "btn btn-primary", data: { modal_form_target: "submit" } %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  <% end %>
</div>
