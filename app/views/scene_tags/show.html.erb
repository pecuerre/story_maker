<% content_for :title, @scene_tag.name %>

<%= render "shared/record_details",
  record: @scene_tag,
  eyebrow: t("shared.eyebrow.story", story: @story.name),
  label: t("tags.types.scene.record_label"),
  facts: [
    detail_fact(t("tags.show.scope"), t("tags.show.scope_story_description")),
    detail_fact(t("tags.show.description"), @scene_tag.description, blank: t("tags.show.description_blank")),
    detail_fact(t("tags.show.color"), @scene_tag.bgcolor)
  ],
  back_url: universe_story_scene_tags_path(story_id: @story),
  back_label: t("tags.types.scene.all_label") %>

<%= render "shared/include_descendants_toggle" %>

<%# The empty title is the shared sentence with the record type resolved at
    `count: 1`: the verb takes one noun in either language, so a plural cannot
    follow it. %>
<%= render "shared/detail_section",
  title: t("tags.types.scene.records_title"),
  count: @tagged_records.size,
  count_label: "scene",
  icon: "film",
  empty_title: t("shared.detail_section.empty_title", determiner: t("shared.detail_section.determiners.none_feminine"), label: t("scene", count: 1)),
  empty_description: t("tags.types.scene.unused_description") do %>
  <%= render "shared/tagged_record_list",
    records: @tagged_records,
    path: ->(record) { universe_story_scene_path(story_id: @story, id: record) } %>
<% end %>