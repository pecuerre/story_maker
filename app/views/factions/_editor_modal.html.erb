<%# The Faction editor. The Factions workspace renders it once for its Add button
    and every row's edit trigger; the record's own details page renders it
    because its Edit control opens this same form, so the fields, the error
    region, and the JSON mutation contract stay one editor rather than a second
    form that could drift. The fields read name, tags, photo, short summary,
    description.

    Local contract:
      tags - the assignable Faction Tags for this request %>
<div class="modal fade" tabindex="-1" aria-labelledby="faction-modal-title" aria-hidden="true"
  data-modal-form-target="modal">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title fs-5" id="faction-modal-title" data-modal-form-target="title"><%= t("factions.new_title") %></h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t("shared.form.close") %>"></button>
      </div>
      <%= form_with scope: :faction, url: universe_factions_path, method: :post,
        data: { modal_form_target: "form", action: "modal-form#save" } do |form| %>
        <div class="modal-body">
          <%= render "shared/modal_errors" %>
          <div class="mb-3">
            <%= form.label :name, t("factions.form.name"), class: "form-label" %>
            <%= form.text_field :name, class: "form-control", required: true %>
          </div>
          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <%= form.label :bgcolor, t("factions.form.bgcolor"), class: "form-label" %>
              <%= form.color_field :bgcolor, value: "#d3d3d3", class: "form-control form-control-color" %>
              <div class="form-text"><%= t("factions.form.bgcolor_hint") %></div>
            </div>
            <div class="col-md-6">
              <%= form.label :fgcolor, t("factions.form.fgcolor"), class: "form-label" %>
              <%= form.color_field :fgcolor, value: "#000000", class: "form-control form-control-color" %>
              <div class="form-text"><%= t("factions.form.fgcolor_hint") %></div>
            </div>
          </div>
          <div class="mb-3">
            <%= form.label :faction_tag_ids, t("factions.form.tags_label"), class: "form-label" %>
            <%= form.collection_select :faction_tag_ids, tags, :id, :name, {},
              { class: "form-select", multiple: true, data: { controller: "tom-select" } } %>
          </div>
          <%= render "shared/photo_field", param: "faction" %>
          <div class="mb-3">
            <%= form.label :summary, t("factions.form.summary"), class: "form-label" %>
            <%= form.text_area :summary, class: "form-control", rows: 3 %>
            <div class="form-text"><%= t("factions.form.summary_hint") %></div>
          </div>
          <div class="mb-3">
            <%= form.label :description, t("factions.form.description"), class: "form-label" %>
            <%= form.text_area :description, class: "form-control font-monospace", rows: 14 %>
            <div class="form-text"><%= t("factions.form.description_hint") %></div>
            <div class="form-text"><%= t("factions.form.description_reference_hint") %></div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t("shared.form.cancel") %></button>
          <%= form.submit t("factions.save"), class: "btn btn-primary", data: { modal_form_target: "submit" } %>
        </div>
      <% end %>
    </div>
  </div>
</div>
