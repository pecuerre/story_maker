<%# The browser tab names the record; the page itself keeps the workspace's
    "Edit universe" title, so the header still reads the same on every universe. %>
<% content_for :title, t("universes.edit_document_title", name: @universe.name) %>

<%= render "shared/page_header",
  title: t("universes.edit"),
  eyebrow: @universe.name,
  description: t("universes.edit_description") %>

<%= render "form", universe: @universe %>
