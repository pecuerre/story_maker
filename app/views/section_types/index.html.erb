<% content_for :title, "Section types" %>

<h1>Section types</h1>

<%= render "shared/taxonomy_tree",
	nodes: @section_types,
	new_url: ->(parent = nil) { new_universe_section_type_path(parent_id: parent&.id) },
	create_url: universe_section_types_path(),
	edit_url: ->(section_type) { edit_universe_section_type_path(id: section_type) },
	update_url: ->(section_type) { universe_section_type_path(id: section_type) },
	delete_url: ->(section_type) { universe_section_type_path(id: section_type) },
	model_param: "section_type",
	modal_fields: section_type_taxonomy_fields(Current.universe.section_types.order(:position, :id)) %>
