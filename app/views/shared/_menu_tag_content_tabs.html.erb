<% tag = local_assigns.fetch(:tag) %>
<% tag_type = local_assigns.fetch(:tag_type).to_s %>

<% if tag.show_in_menu && params[:from] == "workspace" %>
  <%# `type` is the workspace's own name, so it is read from the root record-type
      noun rather than from a humanized class name: "Character" is an English
      accident of the model, "personaje" is what a Spanish reader needs. %>
  <%= render "shared/content_tabs",
    aria_label: t("shared.menu_tag_content_tabs.aria_label", type: t(tag_type, count: 1)),
    tabs: content_workspace_tabs(tag_type, active_tag: tag) %>
<% end %>
