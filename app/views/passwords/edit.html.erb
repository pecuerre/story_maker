<% content_for :title, "Update password" %>

<div class="auth-shell">
  <%= render "shared/page_header",
    title: "Update your password",
    description: "Choose a new password for your account." %>

  <%= form_with url: password_path(params[:token]), method: :put, class: "form-surface" do |form| %>
    <div class="mb-3">
      <%= form.label :password, "New password", class: "form-label" %>
      <%= form.password_field :password,
        class: "form-control",
        required: true,
        autofocus: true,
        autocomplete: "new-password",
        maxlength: 72 %>
    </div>

    <div>
      <%= form.label :password_confirmation, "Confirm new password", class: "form-label" %>
      <%= form.password_field :password_confirmation,
        class: "form-control",
        required: true,
        autocomplete: "new-password",
        maxlength: 72 %>
    </div>

    <div class="form-actions">
      <%= form.submit "Save password", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
