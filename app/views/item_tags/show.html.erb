<% content_for :title, @item_tag.name %>

<%= render "shared/record_details",
  record: @item_tag,
  eyebrow: t("tags.show.eyebrow"),
  label: t("tags.types.item.record_label"),
  facts: [
    detail_fact(t("tags.show.scope"), t("tags.show.scope_universe_description")),
    detail_fact(t("tags.show.description"), @item_tag.description, blank: t("tags.show.description_blank")),
    detail_fact(t("tags.show.color"), @item_tag.bgcolor)
  ],
  back_url: universe_item_tags_path,
  back_label: t("tags.types.item.all_label") do %>
  <%= render "shared/menu_tag_content_tabs", tag_type: "item", tag: @item_tag %>
<% end %>

<%# The section's empty title is the shared sentence with the record type in its
    plural, so the two branches below — a taggable tag lists the records directly,
    a grouping tag lists one section per child tag — read identically when empty. %>
<% empty_title = t("shared.detail_section.empty_title", label: t("item", count: 1)) %>

<% if @item_tag.taggable %>
  <%= render "shared/include_descendants_toggle" %>

  <%= render "shared/detail_section",
    title: t("tags.types.item.records_title"),
    count: @tagged_records.size,
    count_label: "item",
    icon: "box-seam",
    empty_title: empty_title,
    empty_description: t("tags.types.item.unused_description") do %>
    <%= render "shared/tagged_record_list",
      records: @tagged_records,
      path: ->(record) { universe_item_path(id: record) } %>
  <% end %>
<% else %>
  <%= render "shared/tagged_records_by_child_tag",
    child_tags: @child_tags,
    records_by_child_tag: @records_by_child_tag,
    tags_by_record: @tags_by_record,
    count_label: "item",
    icon: "box-seam",
    path: ->(record) { universe_item_path(id: record) } %>
<% end %>
