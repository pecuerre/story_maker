<%# The browser tab names the record; the page itself keeps the workspace's
    "Edit story" title. %>
<% content_for :title, t("stories.edit_document_title", name: @story.name) %>

<%= render "shared/page_header",
  title: t("stories.edit"),
  eyebrow: @story.name,
  description: t("stories.edit_description") %>

<%= render "form", story: @story %>
