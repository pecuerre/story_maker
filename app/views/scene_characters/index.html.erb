<% content_for :title, "Characters in #{@scene.name}" %>
<% editable = can_write_universe? %>

<%# The editor's wrapper has to contain the modal *and* every control that opens
    it, which is why the page header is inside it rather than beside it. %>
<div
  <% if editable %>data-controller="modal-form"<% end %>
  data-modal-form-model-param-value="scene_character"
  data-modal-form-response-value="json"
  data-modal-form-create-title-value="Add character">
  <%= render "shared/page_header",
    title: "Characters",
    eyebrow: "Scene: #{@scene.name}",
    description: "Everyone who takes part in this scene. A participant is stored here with an optional role; a character who only speaks in a dialogue is derived from that dialogue, so the two are shown side by side and counted once.",
    count: @participants.count,
    count_label: "character" do %>
    <%= link_to "Scene details", universe_story_scene_path(story_id: @story, id: @scene), class: "btn btn-outline-secondary" %>
    <% if editable %>
      <button type="button" class="btn btn-primary"
        data-action="modal-form#open"
        data-modal-form-url="<%= universe_story_scene_scene_characters_path(story_id: @story, scene_id: @scene) %>"
        data-modal-form-method="post"
        data-modal-form-title="Add character"
        data-modal-form-values-value="{}">
        <i class="bi bi-plus-lg" aria-hidden="true"></i>
        <span>Add character</span>
      </button>
    <% end %>
  <% end %>

  <%= render "scenes/workspace_tabs" %>

  <%# Only the stored links are editable. A derived speaker has no link of its
      own, so its row explains where the participation comes from instead of
      offering a control that would edit nothing. %>
  <% if @participants.any? %>
    <div class="content-surface entity-list">
      <div class="list-group list-group-flush">
        <% @participants.entries.each do |entry| %>
          <div class="list-group-item entity-row d-flex align-items-start gap-3">
            <div class="entity-copy flex-grow-1">
              <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="entity-title"><%= entry.character.name %></span>
                <% scene_character_participation_badges(entry).each do |badge| %>
                  <span class="badge rounded-pill text-bg-light border"><%= badge %></span>
                <% end %>
              </div>
              <div class="entity-description">
                <% if entry.explicitly_linked? %>
                  Role: <%= scene_character_role_label(entry) %>
                <% end %>
              </div>
              <% if entry.speaks? %>
                <div class="form-text">
                  Speaks in <%= scene_character_speaking_in(entry).to_sentence %>.
                </div>
              <% end %>
            </div>

            <div class="entity-row-actions d-flex align-items-center gap-2 flex-wrap justify-content-end">
              <%= record_details_link universe_character_path(id: entry.character), record: entry.character %>

              <% if editable && entry.explicitly_linked? %>
                <div class="dropdown row-actions">
                  <button class="btn btn-sm btn-light border dropdown-toggle" type="button"
                    id="<%= dom_id(entry.link) %>-actions"
                    data-bs-toggle="dropdown"
                    aria-expanded="false"
                    aria-label="Actions for <%= entry.character.name %> in <%= @scene.name %>">
                    <i class="bi bi-three-dots" aria-hidden="true"></i>
                  </button>
                  <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="<%= dom_id(entry.link) %>-actions">
                    <li>
                      <button type="button" class="dropdown-item"
                        data-action="modal-form#open"
                        data-modal-form-url="<%= universe_story_scene_scene_character_path(story_id: @story, scene_id: @scene, id: entry.link) %>"
                        data-modal-form-method="patch"
                        data-modal-form-title="Edit role"
                        data-modal-form-values-value="<%= scene_character_fields_json(entry.link) %>">
                        <i class="bi bi-pencil me-2" aria-hidden="true"></i>Edit role
                      </button>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                      <button type="button" class="dropdown-item text-danger"
                        data-action="modal-form#destroy"
                        data-modal-form-url="<%= universe_story_scene_scene_character_path(story_id: @story, scene_id: @scene, id: entry.link) %>"
                        data-modal-form-confirm="Remove <%= entry.character.name %> from <%= @scene.name %>? The character stays in the universe, and anyone who speaks in a dialogue is unaffected.">
                        <i class="bi bi-trash me-2" aria-hidden="true"></i>Remove
                      </button>
                    </li>
                  </ul>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <%= render "shared/empty_state",
      title: "No characters in this scene yet",
      description: "Add a character to record that they take part, with an optional role such as “setting,” “enters,” or “objective.” A character who only speaks in a dialogue appears here too, without a separate record.",
      icon: "person" %>
  <% end %>

  <% if editable %>
    <div class="modal fade" tabindex="-1"
      aria-labelledby="scene-character-modal-title"
      aria-hidden="true"
      data-modal-form-target="modal">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h2 class="modal-title fs-5" id="scene-character-modal-title" data-modal-form-target="title">Add character</h2>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <%= form_with scope: :scene_character,
            url: universe_story_scene_scene_characters_path(story_id: @story, scene_id: @scene),
            method: :post,
            data: { modal_form_target: "form", action: "modal-form#save" } do |form| %>
            <div class="modal-body">
              <%= render "shared/modal_errors" %>

              <div class="mb-3">
                <%= form.label :character_id, "Character", class: "form-label" %>
                <%= form.select :character_id, scene_character_choices(@character_options),
                  { include_blank: "Choose a character" },
                  class: "form-select", required: true %>
                <div class="form-text">
                  A character belongs to the universe and is shared by every story in it. A character can
                  only be in a scene once; choosing one that already is is reported here, in this window.
                </div>
              </div>

              <div>
                <%= form.label :role, "Role", class: "form-label" %>
                <%= form.text_field :role, class: "form-control" %>
                <div class="form-text">
                  Optional, in your own words: “setting,” “enters,” “carries,” “objective.” Leave it blank if
                  you do not want to say. Nothing here is interpreted by the application.
                </div>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
              <%= form.submit "Save character", class: "btn btn-primary", data: { modal_form_target: "submit" } %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>
