<% content_for :title, t("tags.types.section.title") %>

<%= render "shared/taxonomy_tree",
  title: t("tags.types.section.title"),
  description: t("tags.types.section.description"),
  eyebrow: t("shared.eyebrow.story", story: @story.name),
  count: @story.section_tags.count,
  count_label: "tag",
  new_label: t("tags.types.section.new_label"),
  tag_workspace_scope: "story",
  tag_workspace_taxonomy: "section",
  empty_description: t("tags.types.section.empty_description"),
  read_only_empty_description: t("tags.types.section.read_only_empty_description"),
  nodes: @section_tags,
  create_url: universe_story_section_tags_path(story_id: @story),
  update_url: ->(section_tag) { universe_story_section_tag_path(story_id: @story, id: section_tag) },
  model_param: "section_tag",
  details_url: ->(section_tag) { universe_story_section_tag_path(story_id: @story, id: section_tag) },
  details_count: ->(tag) { @tagged_counts.fetch(tag.id, 0) },
  details_count_label: "section",
  modal_fields: section_tag_taxonomy_fields(@story.section_tags.order(:position, :id)) %>