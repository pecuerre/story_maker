<% content_for :title, t("story_exports.title") %>

<%= render "shared/page_header",
  title: t("story_exports.title"),
  eyebrow: t("shared.eyebrow.story", story: @story.name),
  description: t("story_exports.description", story: @story.name) do %>
  <%= link_to t("story_exports.back_to_story"), universe_story_path(id: @story), class: "btn btn-outline-secondary" %>
<% end %>

<div class="row g-3">
  <div class="col-12">
    <%# The printable document. Its own notes sit inside this card: they
        describe this output, not the page as a whole. A second format is a
        second section below, and every format reads the same Story. %>
    <section class="surface-card p-4" aria-labelledby="printable-html-title">
      <div class="page-eyebrow"><%= t("story_exports.printable.eyebrow") %></div>
      <h2 class="h5" id="printable-html-title"><%= t("story_exports.printable.heading") %></h2>
      <p class="text-body-secondary"><%= t("story_exports.printable.description") %></p>

      <%# The document opens in a new tab so the reader keeps the export
          options beside it; Turbo leaves a `_blank` form to the browser. %>
      <%= form_with url: universe_story_export_manuscript_path(story_id: @story), method: :get, html: { target: "_blank" } do %>
        <fieldset class="mb-4">
          <legend class="form-label"><%= t("story_exports.printable.scope_legend") %></legend>
          <% Manuscript::SCOPES.each do |scope| %>
            <div class="form-check mb-3">
              <%= radio_button_tag :scope, scope, scope == @scope,
                id: "scope_#{scope}",
                class: "form-check-input",
                aria: { describedby: "scope_#{scope}_description" } %>
              <%= label_tag "scope_#{scope}", t("story_exports.scopes.#{scope}.label"),
                class: "form-check-label fw-semibold" %>
              <p class="form-text mb-0" id="scope_<%= scope %>_description">
                <%= t("story_exports.scopes.#{scope}.description") %>
              </p>
            </div>
          <% end %>
        </fieldset>

        <div class="form-check mb-4">
          <%= check_box_tag :final_only, "1", false,
            id: "final_only",
            class: "form-check-input",
            aria: { describedby: "final_only_description" } %>
          <%= label_tag :final_only, t("story_exports.printable.final_only"),
            class: "form-check-label fw-semibold" %>
          <p class="form-text mb-0" id="final_only_description">
            <%= t("story_exports.printable.final_only_description") %>
          </p>
        </div>

        <%= submit_tag t("story_exports.printable.submit"), name: nil, class: "btn btn-primary" %>
      <% end %>

      <div class="border-top mt-4 pt-4" id="export-notes">
        <h3 class="h6" id="export-notes-title"><%= t("story_exports.notes.heading") %></h3>
        <p class="text-body-secondary"><%= t("story_exports.notes.print") %></p>
        <p class="text-body-secondary mb-0"><%= t("story_exports.notes.pending") %></p>
      </div>
    </section>
  </div>

  <div class="col-12">
    <%# The same assembled Universe in the directory layout the import reads.
        The download is Universe-wide even though this page is Story-scoped,
        because the importer replaces a Universe rather than one Story. %>
    <section class="surface-card p-4" aria-labelledby="interchange-export-title">
      <div class="page-eyebrow"><%= t("story_exports.interchange.eyebrow") %></div>
      <h2 class="h5" id="interchange-export-title"><%= t("story_exports.interchange.heading") %></h2>
      <p class="text-body-secondary"><%= t("story_exports.interchange.description") %></p>
      <p class="text-body-secondary"><%= t("story_exports.interchange.detail") %></p>

      <%= link_to t("story_exports.interchange.download"),
        universe_story_export_interchange_path(story_id: @story),
        class: "btn btn-primary" %>

      <p class="form-text mt-3 mb-0"><%= t("story_exports.interchange.note") %></p>
    </section>
  </div>
</div>
