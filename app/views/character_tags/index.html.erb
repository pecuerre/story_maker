<% content_for :title, t("tags.types.character.title") %>

<%= render "shared/taxonomy_tree",
  title: t("tags.types.character.title"),
  description: t("tags.types.character.description"),
  eyebrow: t("sidebar.universe_bible"),
  count: Current.universe.character_tags.count,
  count_label: "tag",
  new_label: t("tags.types.character.new_label"),
  tag_workspace_scope: "universe",
  tag_workspace_taxonomy: "character",
  empty_description: t("tags.types.character.empty_description"),
  read_only_empty_description: t("tags.types.character.read_only_empty_description"),
  nodes: @character_tags,
  hierarchy: @hierarchy,
  create_url: universe_character_tags_path,
  update_url: ->(character_tag) { universe_character_tag_path(id: character_tag) },
  model_param: "character_tag",
  details_url: ->(character_tag) { universe_character_tag_path(id: character_tag) },
  details_count: ->(tag) { @tagged_counts.fetch(tag.id, 0) },
  details_count_label: "character",
  modal_fields: character_tag_taxonomy_fields(@hierarchy.records) %>
