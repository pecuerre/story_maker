<% content_for :title, "Item types" %>

<h1>Item types</h1>

<%= render "shared/taxonomy_tree",
  nodes: @item_types,
  new_url: ->(parent = nil) { new_universe_item_type_path(parent_id: parent&.id) },
  create_url: universe_item_types_path(),
  edit_url: ->(item_type) { edit_universe_item_type_path(id: item_type) },
  update_url: ->(item_type) { universe_item_type_path(id: item_type) },
  delete_url: ->(item_type) { universe_item_type_path(id: item_type) },
  model_param: "item_type",
  modal_fields: item_type_taxonomy_fields(Current.universe.item_types.order(:position, :id)) %>