<% menu_counts = Current.universe.menu_counts %>
<% section_count = Current.story&.menu_section_count %>
<% tag_controllers = %i[section_tags character_tags location_tags item_tags event_tags relation_tags ownership_tags] %>

<div class="sidebar-context">
  <div class="sidebar-eyebrow">Current universe</div>
  <h2 class="sidebar-universe-name"><%= Current.universe.name %></h2>
  <% if Current.story.present? %>
    <p class="sidebar-story-name">Story: <%= Current.story.name %></p>
  <% end %>
</div>

<nav class="workspace-navigation" aria-label="Universe and story navigation">
  <section class="sidebar-section" aria-labelledby="story-workspace-title">
    <h3 class="sidebar-section-title" id="story-workspace-title">Story workspace</h3>
    <ul class="sidebar-list">
      <% if Current.story.present? %>
        <%= render "shared/sidebar_link",
          icon: "house",
          label: "Story overview",
          path: universe_story_path(id: Current.story),
          controllers: %i[ stories ] %>

        <%= render "shared/sidebar_link",
          icon: "list-nested",
          label: "Sections",
          count: section_count,
          path: universe_story_sections_path(story_id: Current.story),
          controllers: %i[ sections ] %>
      <% else %>
        <%= render "shared/sidebar_link",
          icon: "books",
          label: "All stories",
          path: universe_stories_path,
          controllers: %i[ stories ] %>
      <% end %>

      <%= render "shared/sidebar_link",
        icon: "film",
        label: "Scenes",
        path: "#",
        controllers: [],
        placeholder: true %>
    </ul>

    <% unless Current.story.present? %>
      <p class="sidebar-hint">Select a story to work on its sections and story-specific structure.</p>
    <% end %>
  </section>

  <section class="sidebar-section" aria-labelledby="universe-bible-title">
    <h3 class="sidebar-section-title" id="universe-bible-title">Universe Bible</h3>
    <ul class="sidebar-list">
      <%= render "shared/sidebar_link",
        icon: "person",
        label: "Characters",
        count: menu_counts[:characters],
        path: universe_characters_path,
        controllers: %i[ characters ] %>

      <%= render "shared/sidebar_link",
        icon: "geo-alt",
        label: "Locations",
        count: menu_counts[:locations],
        path: universe_locations_path,
        controllers: %i[ locations ] %>

      <%= render "shared/sidebar_link",
        icon: "calendar-event",
        label: "Events",
        count: menu_counts[:events],
        path: universe_events_path,
        controllers: %i[ events ] %>

      <%= render "shared/sidebar_link",
        icon: "calendar-range",
        label: "Timeline",
        path: universe_timeline_path,
        controllers: %i[ timeline ] %>

      <%= render "shared/sidebar_link",
        icon: "box-seam",
        label: "Items",
        count: menu_counts[:items],
        path: universe_items_path,
        controllers: %i[ items ] %>
    </ul>
  </section>

  <section class="sidebar-section" aria-labelledby="configuration-title">
    <h3 class="sidebar-section-title" id="configuration-title">Configuration</h3>
    <p class="sidebar-hint">Choose a taxonomy to organize your records.</p>

    <div class="dropdown sidebar-dropdown">
      <%= button_tag type: "button",
        id: "tag-navigation-menu-label",
        class: "sidebar-link sidebar-dropdown-toggle#{active_if(*tag_controllers)}",
        data: { bs_toggle: "dropdown" },
        aria: { expanded: "false", controls: "tag-navigation-menu", haspopup: "true" }.merge(aria_current_for(*tag_controllers)) do %>
        <i class="bi bi-tags" aria-hidden="true"></i>
        <span class="sidebar-link-content">
          <span class="sidebar-link-label">Tags</span>
        </span>
        <i class="bi bi-chevron-down sidebar-dropdown-chevron" aria-hidden="true"></i>
      <% end %>

      <ul class="dropdown-menu sidebar-tag-menu" id="tag-navigation-menu" aria-labelledby="tag-navigation-menu-label">
        <% if Current.story.present? %>
          <li><h6 class="dropdown-header">Story tags</h6></li>
          <li>
            <%= link_to "Section tags", universe_story_section_tags_path(story_id: Current.story),
              class: "dropdown-item#{active_if(:section_tags)}",
              aria: aria_current_for(:section_tags) %>
          </li>
        <% end %>

        <li><h6 class="dropdown-header">Universe tags</h6></li>
        <li>
          <%= link_to "Character tags", universe_character_tags_path,
            class: "dropdown-item#{active_if(:character_tags)}",
            aria: aria_current_for(:character_tags) %>
        </li>
        <li>
          <%= link_to "Location tags", universe_location_tags_path,
            class: "dropdown-item#{active_if(:location_tags)}",
            aria: aria_current_for(:location_tags) %>
        </li>
        <li>
          <%= link_to "Item tags", universe_item_tags_path,
            class: "dropdown-item#{active_if(:item_tags)}",
            aria: aria_current_for(:item_tags) %>
        </li>
        <li>
          <%= link_to "Event tags", universe_event_tags_path,
            class: "dropdown-item#{active_if(:event_tags)}",
            aria: aria_current_for(:event_tags) %>
        </li>
        <li>
          <%= link_to "Relation tags", universe_relation_tags_path,
            class: "dropdown-item#{active_if(:relation_tags)}",
            aria: aria_current_for(:relation_tags) %>
        </li>
        <li>
          <%= link_to "Ownership tags", universe_ownership_tags_path,
            class: "dropdown-item#{active_if(:ownership_tags)}",
            aria: aria_current_for(:ownership_tags) %>
        </li>
      </ul>
    </div>
  </section>
</nav>
