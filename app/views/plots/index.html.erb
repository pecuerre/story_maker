<% content_for :title, t("plots.title") %>
<% editable = can_write_universe? %>
<% pending_creates = editable ? draft_pending_creates_for(Plot, story: @story) : [] %>

<div
  <% if editable %>data-controller="modal-form"<% end %>
  data-modal-form-model-param-value="plot"
  data-modal-form-response-value="json"
  data-modal-form-create-title-value="<%= t("plots.new_title") %>">
  <%= render "shared/page_header",
    title: t("plots.title"),
    eyebrow: t("shared.eyebrow.story", story: @story.name),
    description: t("plots.description", story: @story.name),
    count: @plots.size,
    count_label: "plot" do %>
    <% if editable %>
      <button type="button" class="btn btn-primary"
        data-action="modal-form#open"
        data-modal-form-url="<%= universe_story_plots_path(story_id: @story) %>"
        data-modal-form-method="post"
        data-modal-form-title="<%= t("plots.new_title") %>"
        data-modal-form-values-value="{}">
        <i class="bi bi-plus-lg" aria-hidden="true"></i>
        <span><%= t("plots.add") %></span>
      </button>
    <% end %>
  <% end %>

  <%= render "shared/content_tabs",
    aria_label: t("sidebar.story_workspace"),
    tabs: [
      { label: t("sidebar.sections"), path: universe_story_sections_path(story_id: @story), controller: :sections },
      { label: t("sidebar.plots"), path: universe_story_plots_path(story_id: @story), controller: :plots },
      { label: t("sidebar.scenes"), path: universe_story_scenes_path(story_id: @story), controller: :scenes }
    ] %>

  <% if @plots.any? || pending_creates.any? %>
    <div class="content-surface entity-list">
      <div class="list-group list-group-flush">
        <% @plots.each do |plot| %>
          <div class="list-group-item entity-row d-flex align-items-center gap-3">
            <div class="entity-copy flex-grow-1">
              <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="entity-title"><%= plot.name %></span>
                <span class="badge rounded-pill text-bg-light border"
                  aria-label="<%= count_with_label(@scene_counts.fetch(plot.id, 0), "scene") %>">
                  <%= count_with_label(@scene_counts.fetch(plot.id, 0), "scene") %>
                </span>
                <%= render "shared/draft_pending_badge", record: plot %>
              </div>
              <% if plot.description.present? %>
                <div class="entity-description"><%= plot.description %></div>
              <% end %>
            </div>

            <%= record_details_link universe_story_plot_path(story_id: @story, id: plot), record: plot %>
            <%= render "shared/row_actions",
              record: plot,
              label: t("plots.singular"),
              confirm_text: t("plots.delete_confirm", name: plot.name),
              edit_url: universe_story_plot_path(story_id: @story, id: plot),
              delete_url: universe_story_plot_path(story_id: @story, id: plot),
              delete_via: :json,
              values: plot_fields_json(plot) %>
          </div>
        <% end %>

        <%= render partial: "shared/draft_pending_rows", collection: pending_creates, as: :record %>
      </div>
    </div>
  <% else %>
    <%= render "shared/empty_state",
      title: t("plots.empty_title"),
      description: editable ? t("plots.empty_writable_description") : t("plots.empty_read_only_description"),
      icon: "diagram-3" do %>
      <% if editable %>
        <button type="button" class="btn btn-primary"
          data-action="modal-form#open"
          data-modal-form-url="<%= universe_story_plots_path(story_id: @story) %>"
          data-modal-form-method="post"
          data-modal-form-title="<%= t("plots.new_title") %>"
          data-modal-form-values-value="{}"><%= t("plots.add") %></button>
      <% end %>
    <% end %>
  <% end %>

  <% if editable %>
    <div class="modal fade" tabindex="-1" aria-labelledby="plot-modal-title" aria-hidden="true"
      data-modal-form-target="modal">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <div class="modal-header">
            <h2 class="modal-title fs-5" id="plot-modal-title" data-modal-form-target="title"><%= t("plots.new_title") %></h2>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t("shared.form.close") %>"></button>
          </div>
          <%= form_with scope: :plot, url: universe_story_plots_path(story_id: @story), method: :post,
            data: { modal_form_target: "form", action: "modal-form#save" } do |form| %>
            <div class="modal-body">
              <%= render "shared/modal_errors" %>
              <div class="mb-3">
                <%= form.label :name, t("plots.form.name"), class: "form-label" %>
                <%= form.text_field :name, class: "form-control", required: true, autofocus: true %>
              </div>
              <div class="mb-3">
                <%= form.label :description, t("plots.form.description"), class: "form-label" %>
                <%= form.text_area :description, class: "form-control", rows: 3 %>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t("shared.form.cancel") %></button>
              <%= form.submit t("plots.save"), class: "btn btn-primary", data: { modal_form_target: "submit" } %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>
