<% content_for :title, @item.name %>
<%# An Item with no description keeps the identity card exactly as every other
    record's card is: the wide prose block exists only when there is prose to
    read. The description is Markdown, so its `##` sections and its
    `[[kind:slug]]` links are rendered by the shared dialect. %>
<% description_facts = if @item.description.present?
  [ detail_fact(t("items.show.facts.description"), markdown_description_html(@item)) ]
else
  []
end %>

<%= render "shared/record_details",
  record: @item,
  eyebrow: t("sidebar.universe_bible"),
  label: t("items.show.label"),
  description: "",
  facts: [
    detail_fact(t("items.show.facts.universe"), link_to(Current.universe.name, universe_path(id: Current.universe))),
    detail_fact(t("items.show.facts.tags"), entity_tag_badge(@item), blank: t("items.show.facts.tags_blank")),
    detail_fact(t("items.show.facts.current_owners"), item_current_owners(@item),
      blank: t("items.show.facts.current_owners_blank")),
    detail_fact(t("items.show.facts.historical_owners"), item_historical_owners(@item),
      blank: t("items.show.facts.historical_owners_blank"))
  ],
  wide_facts: description_facts,
  back_url: universe_items_path,
  back_label: t("items.show.back_label"),
  actions: discussion_control(@item) %>

<%= render "scene_appearances/section", record: @item %>
