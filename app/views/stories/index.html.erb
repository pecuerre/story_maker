<% content_for :title, "Stories" %>
<% empty_description = can_write_universe? ? "A story holds the plot and sections of this universe, while its world-building records remain shared across stories." : "Stories in this universe will appear here once they have been added." %>

<%= render "shared/page_header",
  title: "Stories",
  eyebrow: Current.universe.name,
  description: "Each story owns its plot and sections while sharing the characters, locations, events, and items in this universe.",
  count: @stories.size,
  count_label: "story" do %>
  <% if can_write_universe? %>
    <%= link_to new_universe_story_path, class: "btn btn-primary" do %>
      <i class="bi bi-plus-lg" aria-hidden="true"></i>
      <span>New story</span>
    <% end %>
  <% end %>
<% end %>

<% if @stories.any? %>
  <div class="row g-3">
    <% @stories.each do |story| %>
      <div class="col-md-6 col-xl-4">
        <article class="card surface-card story-card h-100">
          <div class="card-body p-4">
            <div class="d-flex align-items-start justify-content-between gap-3 mb-2">
              <h2 class="h5 story-card-title mb-0">
                <%= link_to story.name, universe_story_path(id: story) %>
              </h2>
              <% if Current.story == story %>
                <span class="badge text-bg-primary">Current</span>
              <% end %>
            </div>

            <% if story.description.present? %>
              <p class="text-body-secondary"><%= story.description %></p>
            <% else %>
              <p class="text-body-secondary">No description yet.</p>
            <% end %>

            <div class="small text-body-secondary mb-3">
              <%= pluralize(story.sections.size, "section") %>
            </div>
          </div>

          <div class="card-footer bg-body border-top-0 d-flex align-items-center gap-2">
            <%= link_to "Open story", universe_story_path(id: story), class: "btn btn-sm btn-primary" %>
            <%= link_to "Sections", universe_story_sections_path(story_id: story), class: "btn btn-sm btn-outline-secondary" %>

            <% if can_write_universe? %>
              <div class="dropdown row-actions ms-auto">
                <button class="btn btn-sm btn-light border dropdown-toggle" type="button"
                  id="<%= dom_id(story) %>-actions"
                  data-bs-toggle="dropdown"
                  aria-expanded="false"
                  aria-label="Actions for <%= story.name %>">
                  <i class="bi bi-three-dots" aria-hidden="true"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="<%= dom_id(story) %>-actions">
                  <li><%= link_to "Edit story", edit_universe_story_path(id: story), class: "dropdown-item" %></li>
                  <li><hr class="dropdown-divider"></li>
                  <li>
                    <%= button_to "Delete story", universe_story_path(id: story),
                      method: :delete,
                      class: "dropdown-item text-danger",
                      data: { turbo_confirm: "Delete #{story.name} and all of its sections?" } %>
                  </li>
                </ul>
              </div>
            <% end %>
          </div>
        </article>
      </div>
    <% end %>
  </div>
<% else %>
  <%= render "shared/empty_state",
    title: "No stories yet",
    description: empty_description,
    icon: "books" %>
<% end %>
