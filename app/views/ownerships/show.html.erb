<% content_for :title, @ownership.display_string %>

<%= render "shared/record_details",
  record: @ownership,
  eyebrow: t("sidebar.universe_bible"),
  label: t("ownerships.show.label"),
  facts: [
    detail_fact(t("ownerships.show.facts.item"), link_to(@ownership.item.name, universe_item_path(id: @ownership.item))),
    detail_fact(t("ownerships.show.facts.owner"), link_to(@ownership.character.name, universe_character_path(id: @ownership.character))),
    detail_fact(t("ownerships.show.facts.tags"), entity_tag_badge(@ownership), blank: t("ownerships.show.facts.tags_blank")),
    detail_fact(t("ownerships.show.facts.in_world_dates"), in_world_range(@ownership.from_date, @ownership.to_date)),
    detail_fact(t("ownerships.show.facts.description"), @ownership.description, blank: t("ownerships.show.facts.description_blank"))
  ],
  back_url: universe_ownerships_path,
  back_label: t("ownerships.show.back_label") %>

<%= render "shared/detail_section",
  title: t("ownerships.show.related.title"),
  icon: "person-check",
  empty_title: t("ownerships.show.related.empty_title"),
  empty_description: t("ownerships.show.related.empty_description") %>
