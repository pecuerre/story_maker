<% content_for :title, t("relations.title") %>
<% empty_description = can_write_universe? ? t("relations.empty_writable_description") : t("relations.empty_read_only_description") %>
<% narrowed = @list_filter.narrowed? %>
<%# A rejected submission is an unsaved record on this page, and it must not be
    mistaken for a remembered create: this is the one list where an unsaved record
    already appears, and the pending rows below are built from the reader's own
    draft. `draft_pending_creates_for` reads only that draft, so the two cannot
    be confused by a reader or by the badge.

    A *filtered* list shows no pending rows at all: a remembered create names no
    record, so it cannot match a text or tag filter. A reader who only *sorted*
    the list still sees their own pending work, because a sort selects nothing. %>
<% pending_creates = narrowed ? [] : draft_pending_creates_for(Relation) %>
<%# A rejected submission re-renders this index with the invalid record, so the
    entered values are serialized into the trigger that reopens the editor
    instead of being thrown away: the Add trigger for a rejected create, and only
    the row that was being edited for a rejected update. %>
<% rejected = @relation&.errors&.any? ? @relation : nil %>
<% add_values = rejected&.new_record? ? relation_fields_json(rejected) : "{}" %>

<div
  <% if can_write_universe? %>data-controller="modal-form"<% end %>
  data-modal-form-model-param-value="relation"
  data-modal-form-response-value="html"
  data-modal-form-create-title-value="<%= t("relations.new_title") %>">
  <%= render "shared/page_header",
    title: t("relations.title"),
    eyebrow: t("relations.eyebrow"),
    count: @relations.size,
    count_label: "relation" do %>
    <% if can_write_universe? %>
      <button type="button" class="btn btn-primary"
        data-action="modal-form#open"
        data-modal-form-url="<%= universe_relations_path(**@list_filter.query_params) %>"
        data-modal-form-method="post"
        data-modal-form-title="<%= t("relations.new_title") %>"
        data-modal-form-values-value="<%= add_values %>">
        <i class="bi bi-plus-lg" aria-hidden="true"></i>
        <span><%= t("relations.add") %></span>
      </button>
    <% end %>
  <% end %>

  <% if rejected %>
    <%= render "shared/error_summary", record: rejected, subject: t("relations.errors.subject") %>
  <% end %>

  <%= render "shared/content_tabs",
    aria_label: t("characters.tabs_aria_label"),
    intro: t("relations.description"),
    tabs: content_workspace_tabs(:character) %>

  <%= render "relations/filter",
    filter: @list_filter,
    total: @relation_total,
    shown: @relations.size %>

  <% if @relations.any? || pending_creates.any? %>
    <div class="content-surface entity-list">
      <div class="list-group list-group-flush">
        <% @relations.each do |relation| %>
          <%# The row draws the two names either side of an arrow, but the delete
              confirmation has to name them in a sentence, so the "and" is a
              sentence of its own rather than an English frame around two pieces
              of author data. %>
          <div class="list-group-item entity-row d-flex align-items-center gap-3">
            <div class="entity-copy flex-grow-1">
              <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="entity-title"><%= relation_row_sentence(relation) %></span>
                <%= render "shared/draft_pending_badge", record: relation %>
              </div>
              <% if relation.from_date.present? || relation.to_date.present? %>
                <div class="entity-description"><%= in_world_range(relation.from_date, relation.to_date) %></div>
              <% end %>
              <% if relation.description.present? %>
                <div class="entity-description"><%= relation.description %></div>
              <% end %>
            </div>

            <%= record_details_link universe_relation_path(id: relation), record: relation %>

            <%= render "shared/row_actions",
              record: relation,
              label: t("relation", count: 1),
              record_name: t("relations.endpoints", first: relation.character1.name,
                second: relation.character2.name),
              edit_url: universe_relation_path(id: relation, **@list_filter.query_params),
              delete_url: universe_relation_path(id: relation, **@list_filter.query_params),
              values: (rejected&.persisted? && rejected.id == relation.id) ? relation_fields_json(rejected) : relation_fields_json(relation) %>
          </div>
        <% end %>

        <%= render partial: "shared/draft_pending_rows", collection: pending_creates, as: :record %>
      </div>
    </div>
  <% elsif narrowed %>
    <%# A filter that matched nothing is not a universe without relations, so it
        says which filters produced nothing, repeats them, and offers the way
        back. %>
    <div class="content-surface p-3 p-md-4">
      <%= render "shared/empty_state",
        title: t("relations.no_match_title"),
        description: t("relations.no_match_description",
          universe: Current.universe.name, total: count_with_label(@relation_total, "relation")),
        icon: "filter" do %>
        <span class="d-block mb-3">
          <% relation_filter_summaries(@list_filter).each do |summary| %>
            <span class="badge rounded-pill text-bg-light border me-1"><%= summary %></span>
          <% end %>
        </span>
        <%= link_to t("relations.filter.clear"), universe_relations_path, class: "btn btn-primary" %>
      <% end %>
    </div>
  <% else %>
    <%= render "shared/empty_state",
      title: t("relations.empty_title"),
      description: empty_description,
      icon: "people" %>
  <% end %>

  <% if can_write_universe? %>
    <div class="modal fade" tabindex="-1"
    aria-labelledby="relation-modal-title"
    aria-hidden="true"
    data-modal-form-target="modal">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title fs-5" id="relation-modal-title" data-modal-form-target="title"><%= t("relations.new_title") %></h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t("shared.form.close") %>"></button>
        </div>
        <%= form_with scope: :relation, url: universe_relations_path(**@list_filter.query_params),
          method: :post, data: { modal_form_target: "form" } do |form| %>
          <div class="modal-body">
            <%# The editor carries the same summary as the page, so reopening it
                after a rejection still explains the refusal. %>
            <% if rejected %>
              <%= render "shared/error_summary", record: rejected, subject: t("relations.errors.subject") %>
            <% end %>
            <div class="mb-3">
              <%= form.label :name, t("relations.form.name"), class: "form-label" %>
              <%# Optional, and it is what the record's label and the composite
                  slug prefer when it is set, so the field says so instead of
                  implying it is required. %>
              <%= form.text_field :name, class: "form-control" %>
              <div class="form-text"><%= t("relations.form.name_hint") %></div>
            </div>
            <%= render "shared/photo_field", param: "relation" %>
            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <%= form.label :character1_id, t("relations.character1"), class: "form-label" %>
                <%= form.collection_select :character1_id, @characters, :id, :name,
                  { prompt: t("relations.select_character") },
                  { class: "form-select", required: true } %>
              </div>
              <div class="col-md-6">
                <%= form.label :character2_id, t("relations.character2"), class: "form-label" %>
                <%= form.collection_select :character2_id, @characters, :id, :name,
                  { prompt: t("relations.select_character") },
                  { class: "form-select", required: true } %>
              </div>
            </div>
            <div class="mb-3">
              <%= form.label :relation_tag_ids, t("relations.form.tags_label"), class: "form-label" %>
              <%= form.collection_select :relation_tag_ids, @assignable_relation_tags, :id, :name,
                {},
                { class: "form-select", multiple: true, data: { controller: "tom-select" } } %>
            </div>
            <div class="mb-3">
              <%= form.label :description, t("relations.form.description"), class: "form-label" %>
              <%= form.text_area :description, class: "form-control", rows: 4 %>
            </div>
            <div class="row g-3">
              <div class="col-md-6">
                <%= form.label :from_date, t("relations.from"), class: "form-label" %>
                <%# `step: 1` matches `ApplicationHelper::DATETIME_LOCAL_FORMAT`, which
                    serializes the stored seconds into the trigger that prefills this
                    control: a whole-minute step could not hold them and would drop
                    them on save. %>
                <%= form.datetime_local_field :from_date, class: "form-control", step: 1 %>
              </div>
              <div class="col-md-6">
                <%= form.label :to_date, t("relations.to"), class: "form-label" %>
                <%= form.datetime_local_field :to_date, class: "form-control", step: 1 %>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t("shared.form.cancel") %></button>
            <%= form.submit t("relations.save"), class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  <% end %>
</div>
