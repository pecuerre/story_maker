<% content_for :title, t("routes.title") %>
<% rejected = @route&.errors&.any? ? @route : nil %>
<% pending_creates = draft_pending_creates_for(Route) %>
<% add_values = rejected&.new_record? ? route_fields_json(rejected) : "{}" %>

<div
  <% if can_write_universe? %>data-controller="modal-form"<% end %>
  data-modal-form-model-param-value="route"
  data-modal-form-response-value="html"
  data-modal-form-create-title-value="<%= t("routes.new_title") %>">
  <%= render "shared/page_header", title: t("routes.title"), eyebrow: t("routes.eyebrow"),
    count: @routes.size, count_label: "route" do %>
    <% if can_write_universe? %>
      <button type="button" class="btn btn-primary" data-action="modal-form#open"
        data-modal-form-url="<%= universe_routes_path %>" data-modal-form-method="post"
        data-modal-form-title="<%= t("routes.new_title") %>" data-modal-form-values-value="<%= add_values %>">
        <i class="bi bi-plus-lg" aria-hidden="true"></i> <span><%= t("routes.add") %></span>
      </button>
    <% end %>
  <% end %>

  <% if rejected %><%= render "shared/error_summary", record: rejected, subject: t("routes.errors.subject") %><% end %>
  <% if @routes.any? || pending_creates.any? %>
    <div class="content-surface entity-list"><div class="list-group list-group-flush">
      <% @routes.each do |route| %>
        <div class="list-group-item entity-row d-flex align-items-center gap-3">
          <div class="entity-copy flex-grow-1">
            <div class="d-flex align-items-center gap-2 flex-wrap">
              <span class="entity-title"><%= route.display_string %></span>
              <%= render "shared/draft_pending_badge", record: route %>
            </div>
            <div class="entity-description">
              <%= link_to route.from_location.name, universe_location_path(id: route.from_location) %>
              <span aria-hidden="true">→</span>
              <%= link_to route.to_location.name, universe_location_path(id: route.to_location) %>
              <% if route.distance.present? || route.duration.present? %>
                <span> · <%= [route.distance, route.duration].compact_blank.join(" · ") %></span>
              <% end %>
            </div>
            <% if route.description.present? %><div class="entity-description"><%= route.description %></div><% end %>
          </div>
          <%= record_details_link universe_route_path(id: route), record: route %>
          <%= render "shared/row_actions", record: route, label: t("route", count: 1),
            record_name: route.display_string, edit_url: universe_route_path(id: route),
            delete_url: universe_route_path(id: route),
            values: (rejected&.persisted? && rejected.id == route.id) ? route_fields_json(rejected) : route_fields_json(route) %>
        </div>
      <% end %>
      <%= render partial: "shared/draft_pending_rows", collection: pending_creates, as: :record %>
    </div></div>
  <% else %>
    <%= render "shared/empty_state", title: t("routes.empty_title"),
      description: can_write_universe? ? t("routes.empty_writable_description") : t("routes.empty_read_only_description"),
      icon: "signpost-2" %>
  <% end %>

  <% if can_write_universe? %>
    <div class="modal fade" tabindex="-1" aria-labelledby="route-modal-title" aria-hidden="true" data-modal-form-target="modal">
      <div class="modal-dialog modal-lg"><div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title fs-5" id="route-modal-title" data-modal-form-target="title"><%= t("routes.new_title") %></h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t("shared.form.close") %>"></button>
        </div>
        <%= form_with scope: :route, url: universe_routes_path, method: :post, data: { modal_form_target: "form" } do |form| %>
          <div class="modal-body">
            <% if rejected %><%= render "shared/error_summary", record: rejected, subject: t("routes.errors.subject") %><% end %>
            <div class="mb-3"><%= form.label :name, t("routes.form.name"), class: "form-label" %>
              <%= form.text_field :name, class: "form-control" %><div class="form-text"><%= t("routes.form.name_hint") %></div></div>
            <%= render "shared/photo_field", param: "route" %>
            <div class="row g-3 mb-3">
              <div class="col-md-6"><%= form.label :from_location_id, t("routes.form.from_location"), class: "form-label" %>
                <%= form.collection_select :from_location_id, @locations, :id, :name, { prompt: t("routes.form.select_location") }, { class: "form-select", required: true } %></div>
              <div class="col-md-6"><%= form.label :to_location_id, t("routes.form.to_location"), class: "form-label" %>
                <%= form.collection_select :to_location_id, @locations, :id, :name, { prompt: t("routes.form.select_location") }, { class: "form-select", required: true } %></div>
            </div>
            <div class="row g-3 mb-3">
              <div class="col-md-6"><%= form.label :distance, t("routes.form.distance"), class: "form-label" %><%= form.text_field :distance, class: "form-control" %></div>
              <div class="col-md-6"><%= form.label :duration, t("routes.form.duration"), class: "form-label" %><%= form.text_field :duration, class: "form-control" %></div>
            </div>
            <div class="mb-3"><%= form.label :description, t("routes.form.description"), class: "form-label" %><%= form.text_area :description, class: "form-control", rows: 4 %></div>
          </div>
          <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t("shared.form.cancel") %></button><%= form.submit t("routes.save"), class: "btn btn-primary" %></div>
        <% end %>
      </div></div>
    </div>
  <% end %>
</div>
