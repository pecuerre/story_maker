<% content_for :title, @scene.name %>

<%= render "shared/page_header",
  title: @scene.name,
  eyebrow: t("shared.eyebrow.story", story: @story.name),
  description: t("scenes.show.description",
    position: @scene.position + 1, total: @scene_total, story: @story.name) do %>
  <%= link_to t("scenes.show.all_scenes"), universe_story_scenes_path(story_id: @story), class: "btn btn-outline-secondary" %>
  <%= discussion_control(@scene) %>
  <% if can_write_universe? %>
    <%= link_to t("scenes.edit_title"), edit_universe_story_scene_path(story_id: @story, id: @scene), class: "btn btn-primary" %>
  <% end %>
<% end %>

<%= render "scenes/workspace_tabs" %>

<%# Scene Details is the canonical, inspectable destination: the same content is
    shown to writers and read-only viewers, and only writers get the editor link. %>
<div class="surface-card p-4">
  <%# The photo sits in the left column of the same row as the identity facts,
      exactly as it does on every `shared/_record_details` page. With no photo
      the facts keep the whole card, which is how this page looked before. %>
  <% if @scene.photo %>
    <div class="row g-4 align-items-start">
      <div class="col-12 col-sm-5 col-md-4 col-lg-3">
        <%= render "shared/record_photo", photo: @scene.photo, name: @scene.name %>
      </div>
      <div class="col-12 col-sm-7 col-md-8 col-lg-9">
        <%= render "scenes/show_identity", scene: @scene, story: @story %>
      </div>
    </div>
  <% else %>
    <%= render "scenes/show_identity", scene: @scene, story: @story %>
  <% end %>
</div>

<%# Elements stay under Scene Details in this version: the scene above carries
    its identity and references, and the ordered prose blocks belong to the same
    page rather than to a second one. %>
<%= render "scenes/elements" %>