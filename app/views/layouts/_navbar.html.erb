<nav class="navbar navbar-expand-lg fixed-top border-bottom bg-dark navbar-dark" aria-label="<%= t("layouts.primary_navigation") %>">
  <div class="container-fluid px-3 px-lg-4">
    <%# The brand is the landing page: it lists the universes the visitor may
        open and is the only place a new universe is created. %>
    <%= link_to t("app.name"), root_path, class: "navbar-brand fw-bold" %>

    <button class="navbar-toggler" type="button"
      data-bs-toggle="collapse"
      data-bs-target="#primary-navigation"
      aria-controls="primary-navigation"
      aria-expanded="false"
      aria-label="<%= t("layouts.toggle_navigation") %>">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="primary-navigation">
      <ul class="navbar-nav me-auto align-items-lg-center gap-lg-1">
        <%# The top bar only states the current scope and links to that scope's
            own page. Changing universes and creating one happen on the landing
            page the brand links to, and changing stories happens on the universe
            page, so there is no switcher dropdown here. %>
        <% if Current.universe.present? %>
          <% on_universe_page = controller_name == "universes" && action_name == "show" %>
          <li class="nav-item">
            <%= link_to universe_path(Current.universe),
              class: "nav-link#{' active' if on_universe_page}",
              aria: (on_universe_page ? { current: "page" } : {}) do %>
              <%= t("layouts.scope.universe") %> <span class="navbar-context"><%= Current.universe.name %></span>
            <% end %>
          </li>
        <% end %>

        <% if Current.story.present? %>
          <% on_story_page = controller_name == "stories" && action_name == "show" %>
          <li class="nav-item">
            <%= link_to universe_story_path(id: Current.story),
              class: "nav-link#{' active' if on_story_page}",
              aria: (on_story_page ? { current: "page" } : {}) do %>
              <%= t("layouts.scope.story") %> <span class="navbar-context"><%= Current.story.name %></span>
            <% end %>
          </li>
        <% end %>
      </ul>

      <%# The search box sits between the scope links and the actions, and grows
          into the space they leave. It is one form: submitting it opens the
          results page, and the dropdown is only the enhancement of that. %>
      <%= render "shared/search_bar" %>

      <%# One menu: the account dropdown is the top bar's only action. Settings is
          platform-level, so it lives inside the same menu rather than beside it,
          and a guest sees the same menu with Log in as its first entry. %>
      <div class="navbar-actions ms-auto mt-3 mt-lg-0 d-flex align-items-center gap-2">
        <% on_settings_page = controller_name == "settings" %>
        <div class="dropdown">
          <button class="btn btn-outline-light btn-sm dropdown-toggle<%= ' active' if on_settings_page %>",
            type="button",
            data-bs-toggle="dropdown",
            aria-expanded="false"<% if on_settings_page %> aria-current="page"<% end %>>
            <%= t("layouts.account") %>
          </button>
          <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
            <% if Current.user.present? %>
              <li>
                <span class="dropdown-item-text navbar-account-label" title="<%= Current.user.email_address %>">
                  <%= Current.user.email_address %>
                </span>
              </li>
              <li><hr class="dropdown-divider"></li>
            <% else %>
              <li>
                <%= link_to t("layouts.log_in"), new_session_path, class: "dropdown-item" %>
              </li>
            <% end %>
            <li>
              <%= link_to settings_path, class: "dropdown-item d-inline-flex align-items-center gap-2" do %>
                <i class="bi bi-gear" aria-hidden="true"></i>
                <%= t("layouts.settings") %>
              <% end %>
            </li>
            <% if Current.user.present? %>
              <li><hr class="dropdown-divider"></li>
              <li>
                <%= button_to t("layouts.log_out"), session_path,
                  method: :delete,
                  class: "dropdown-item" %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  </div>
</nav>
