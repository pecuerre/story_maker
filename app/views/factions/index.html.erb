<% content_for :title, t("factions.title") %>
<% empty_description = can_write_universe? ? t("factions.empty_writable_description") : t("factions.empty_read_only_description") %>
<% pending_creates = draft_pending_creates_for(Faction) %>

<div
  <% if can_write_universe? %>data-controller="modal-form"<% end %>
  data-modal-form-model-param-value="faction"
  data-modal-form-response-value="json"
  data-modal-form-create-title-value="<%= t("factions.new_title") %>">
  <%= render "shared/page_header",
    title: t("factions.title"),
    eyebrow: t("sidebar.universe_bible"),
    count: @factions.size,
    count_label: "faction" do %>
    <% if can_write_universe? %>
      <button type="button" class="btn btn-primary"
        data-action="modal-form#open"
        data-modal-form-url="<%= universe_factions_path %>"
        data-modal-form-method="post"
        data-modal-form-title="<%= t("factions.new_title") %>"
        data-modal-form-values-value="{}">
        <i class="bi bi-plus-lg" aria-hidden="true"></i>
        <span><%= t("factions.add") %></span>
      </button>
    <% end %>
  <% end %>

  <%= render "shared/content_tabs",
    aria_label: t("factions.tabs_aria_label"),
    intro: t("factions.description"),
    tabs: content_workspace_tabs(:faction) %>

  <% if @factions.any? || pending_creates.any? %>
    <div class="content-surface entity-list">
      <div class="list-group list-group-flush">
        <% @factions.each do |faction| %>
          <div class="list-group-item entity-row d-flex align-items-center gap-3">
            <div class="entity-copy flex-grow-1">
              <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="entity-title"><%= faction.name %></span>
                <%= entity_tag_badge(faction) %>
                <%= render "shared/draft_pending_badge", record: faction %>
              </div>
              <% if faction.summary.present? %>
                <div class="entity-description"><%= summary_text(faction) %></div>
              <% end %>
            </div>
            <%= record_details_link universe_faction_path(id: faction), record: faction %>
            <%= render "shared/row_actions",
              record: faction,
              label: t("faction", count: 1),
              record_name: faction.name,
              confirm_text: t("factions.delete_confirm", name: faction.name),
              edit_url: universe_faction_path(id: faction),
              delete_url: universe_faction_path(id: faction),
              delete_via: :json,
              values: faction_fields_json(faction) %>
          </div>
        <% end %>
        <%= render partial: "shared/draft_pending_rows", collection: pending_creates, as: :record %>
      </div>
    </div>
  <% else %>
    <%= render "shared/empty_state",
      title: t("factions.empty_title"),
      description: empty_description,
      icon: "people-fill" %>
  <% end %>

  <% if can_write_universe? %>
    <%= render "factions/editor_modal", tags: @assignable_faction_tags %>
  <% end %>
</div>
