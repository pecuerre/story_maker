<% content_for :title, t("characters.title") %>
<%# The list has two empty states because it has two audiences: a writer is told
    to add the first character, and a guest or read-only member is only told what a
    character is. Both are chrome, so both are keys. A remembered create counts as
    something to show, or a writer who has added a character in a universe that
    remembers changes would be told they have none.

    A *filtered* list that matched nothing is a third case and never says
    "no characters yet": the universe has characters, the filters did not match
    them, and offering "add the first one" beside that message would answer a
    question nobody asked. %>
<% narrowed = @list_filter.narrowed? %>
<% empty_description = can_write_universe? ? t("characters.empty_writable_description") : t("characters.empty_read_only_description") %>
<%# A remembered Character create belongs to this universe's list, but **not to a
    filtered one**: it names no record, so it cannot match a text or tag filter.
    A reader who only *sorted* the list still sees their own pending work,
    because a sort selects nothing. %>
<% pending_creates = narrowed ? [] : draft_pending_creates_for(Character) %>

<div
  <% if can_write_universe? %>data-controller="modal-form"<% end %>
  data-modal-form-model-param-value="character"
  data-modal-form-response-value="json"
  data-modal-form-create-title-value="<%= t("characters.new_title") %>">
  <%= render "shared/page_header",
    title: t("characters.title"),
    eyebrow: t("sidebar.universe_bible"),
    count: @characters.size,
    count_label: "character" do %>
    <% if can_write_universe? %>
      <button type="button" class="btn btn-primary"
        data-action="modal-form#open"
        data-modal-form-url="<%= universe_characters_path %>"
        data-modal-form-method="post"
        data-modal-form-title="<%= t("characters.new_title") %>"
        data-modal-form-values-value="{}">
        <i class="bi bi-plus-lg" aria-hidden="true"></i>
        <span><%= t("characters.add") %></span>
      </button>
    <% end %>
  <% end %>

  <%= render "shared/content_tabs",
    aria_label: t("characters.tabs_aria_label"),
    intro: t("characters.description"),
    tabs: content_workspace_tabs(:character) %>

  <%= render "characters/filter",
    filter: @list_filter,
    total: @character_total,
    shown: @characters.size %>

  <% if @characters.any? || pending_creates.any? %>
    <div class="content-surface entity-list">
      <div class="list-group list-group-flush">
        <% @characters.each do |character| %>
          <div class="list-group-item entity-row d-flex align-items-center gap-3">
            <div class="entity-copy flex-grow-1">
              <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="entity-title"><%= character.name %></span>
                <%= entity_tag_badge(character) %>
                <%= render "shared/draft_pending_badge", record: character %>
                <% relation_count = character.relations_as_character1.size + character.relations_as_character2.size %>
                <%= record_count_badge(relation_count, "relation") if relation_count.positive? %>
                <% ownership_count = character.ownerships.size %>
                <%= record_count_badge(ownership_count, "ownership") if ownership_count.positive? %>
              </div>
              <% if character.at_a_glance.present? %>
                <div class="entity-description"><%= character.at_a_glance %></div>
              <% end %>
            </div>

            <%= record_details_link universe_character_path(id: character), record: character %>

            <%# `label` titles the edit menu entry, so it is the record type's own
                name rather than a finished phrase. %>
            <%= render "shared/row_actions",
              record: character,
              label: t("character", count: 1),
              record_name: character.name,
              confirm_text: t("characters.delete_confirm", name: character.name),
              edit_url: universe_character_path(id: character),
              delete_url: universe_character_path(id: character),
              delete_via: :json,
              values: character_fields_json(character) %>
          </div>
        <% end %>

        <%= render partial: "shared/draft_pending_rows", collection: pending_creates, as: :record %>
      </div>
    </div>
  <% elsif narrowed %>
    <%# A filter that matched nothing is not a universe without characters, so it
        says which filters produced nothing, repeats them, and offers the way
        back. %>
    <div class="content-surface p-3 p-md-4">
      <%= render "shared/empty_state",
        title: t("characters.no_match_title"),
        description: t("characters.no_match_description",
          universe: Current.universe.name, total: count_with_label(@character_total, "character")),
        icon: "filter" do %>
        <span class="d-block mb-3">
          <% character_filter_summaries(@list_filter).each do |summary| %>
            <span class="badge rounded-pill text-bg-light border me-1"><%= summary %></span>
          <% end %>
        </span>
        <%= link_to t("characters.filter.clear"), universe_characters_path, class: "btn btn-primary" %>
      <% end %>
    </div>
  <% else %>
    <%= render "shared/empty_state",
      title: t("characters.empty_title"),
      description: empty_description,
      icon: "person" %>
  <% end %>

  <% if can_write_universe? %>
    <div class="modal fade" tabindex="-1"
    aria-labelledby="character-modal-title"
    aria-hidden="true"
    data-modal-form-target="modal">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title fs-5" id="character-modal-title" data-modal-form-target="title"><%= t("characters.new_title") %></h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t("shared.form.close") %>"></button>
        </div>
        <%= form_with scope: :character,
          url: universe_characters_path,
          method: :post,
          data: { modal_form_target: "form", action: "modal-form#save" } do |form| %>
          <div class="modal-body">
            <%= render "shared/modal_errors" %>
            <div class="mb-3">
              <%= form.label :name, t("characters.form.name"), class: "form-label" %>
              <%= form.text_field :name, class: "form-control", required: true %>
            </div>
            <%= render "shared/photo_field", param: "character" %>
            <div class="mb-3">
              <%= form.label :character_tag_ids, t("characters.form.tags_label"), class: "form-label" %>
              <%= form.collection_select :character_tag_ids, @assignable_character_tags, :id, :name,
                {},
                { class: "form-select", multiple: true, data: { controller: "tom-select" } } %>
            </div>
            <%= render "profile_fields", form: form, factions: @factions %>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t("shared.form.cancel") %></button>
            <%= form.submit t("characters.save"), class: "btn btn-primary", data: { modal_form_target: "submit" } %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  <% end %>
</div>
