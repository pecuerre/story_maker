<% content_for :title, "Relations" %>
<% empty_description = can_write_universe? ? "Connect two characters to describe their relationship. Relation tags are optional but can make these connections easier to scan." : "Character relationships in this universe will appear here once they have been added." %>

<div
  <% if can_write_universe? %>data-controller="modal-form"<% end %>
  data-modal-form-model-param-value="relation"
  data-modal-form-create-title-value="New relation">
  <%= render "shared/page_header",
    title: "Relations",
    eyebrow: "Characters",
    description: "Connect characters and record how their relationships change over time.",
    count: @relations.size,
    count_label: "relation" do %>
    <% if can_write_universe? %>
      <button type="button" class="btn btn-primary"
        data-action="modal-form#open"
        data-modal-form-url="<%= universe_relations_path %>"
        data-modal-form-method="post"
        data-modal-form-title="New relation"
        data-modal-form-values-value="{}">
        <i class="bi bi-plus-lg" aria-hidden="true"></i>
        <span>Add relation</span>
      </button>
    <% end %>
  <% end %>

  <%= render "shared/content_tabs",
    aria_label: "Character workspace",
    tabs: [
      { label: "Characters", path: universe_characters_path, controller: :characters },
      { label: "Relations", path: universe_relations_path, controller: :relations }
    ] %>

  <% if @relations.any? %>
    <div class="content-surface entity-list">
      <div class="list-group list-group-flush">
        <% @relations.each do |relation| %>
          <% relation_name = "#{relation.character1.name} and #{relation.character2.name}" %>
          <div class="list-group-item entity-row d-flex align-items-center gap-3">
            <div class="entity-copy flex-grow-1">
              <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="entity-title"><%= relation.character1.name %></span>
                <%= entity_tag_badge(relation) %>
                <i class="bi bi-arrow-right text-body-secondary" aria-hidden="true"></i>
                <span class="entity-title"><%= relation.character2.name %></span>
              </div>
              <% if relation.description.present? %>
                <div class="entity-description"><%= relation.description %></div>
              <% end %>
            </div>

            <%= render "shared/row_actions",
              record: relation,
              label: "relation",
              record_name: relation_name,
              edit_url: universe_relation_path(id: relation),
              delete_url: universe_relation_path(id: relation),
              values: relation_fields_json(relation) %>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <%= render "shared/empty_state",
      title: "No relations yet",
      description: empty_description,
      icon: "people" %>
  <% end %>

  <% if can_write_universe? %>
    <div class="modal fade" tabindex="-1"
    aria-labelledby="relation-modal-title"
    aria-hidden="true"
    data-modal-form-target="modal">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title fs-5" id="relation-modal-title" data-modal-form-target="title">New relation</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <%= form_with scope: :relation, url: universe_relations_path,
          method: :post, data: { modal_form_target: "form" } do |form| %>
          <div class="modal-body">
            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <%= form.label :character1_id, "Character 1", class: "form-label" %>
                <%= form.collection_select :character1_id, @characters, :id, :name,
                  { prompt: "Select a character" },
                  { class: "form-select", required: true } %>
              </div>
              <div class="col-md-6">
                <%= form.label :character2_id, "Character 2", class: "form-label" %>
                <%= form.collection_select :character2_id, @characters, :id, :name,
                  { prompt: "Select a character" },
                  { class: "form-select", required: true } %>
              </div>
            </div>
            <div class="mb-3">
              <%= form.label :relation_tag_ids, "Relation tags", class: "form-label" %>
              <%= form.collection_select :relation_tag_ids, @relation_tags, :id, :name,
                {},
                { class: "form-select", multiple: true, data: { controller: "tom-select" } } %>
            </div>
            <div class="mb-3">
              <%= form.label :description, class: "form-label" %>
              <%= form.text_area :description, class: "form-control", rows: 4 %>
            </div>
            <div class="row g-3">
              <div class="col-md-6">
                <%= form.label :from_date, "From", class: "form-label" %>
                <%= form.datetime_local_field :from_date, class: "form-control" %>
              </div>
              <div class="col-md-6">
                <%= form.label :to_date, "To", class: "form-label" %>
                <%= form.datetime_local_field :to_date, class: "form-control" %>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <%= form.submit "Save relation", class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  <% end %>
</div>
