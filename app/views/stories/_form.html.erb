<%= form_with model: story,
  url: story.persisted? ? universe_story_path(id: story) : universe_stories_path,
  class: "form-surface" do |form| %>
  <% if story.errors.any? %>
    <%= render "shared/error_summary", record: story, subject: t("story", count: 1) %>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, class: "form-control", required: true, autofocus: true %>
  </div>

  <%= render "shared/photo_field", param: "story", current_url: record_photo_url(story) %>

  <div>
    <%= form.label :description, class: "form-label" %>
    <%= form.text_area :description, class: "form-control", rows: 5 %>
  </div>

  <div class="form-actions">
    <%# The default submit label comes from Rails' English-only
        `helpers.submit.*`, so the label is named here. %>
    <%= form.submit(story.persisted? ? t("stories.form.submit_update") : t("stories.form.submit_create"),
      class: "btn btn-primary") %>
    <%= link_to t("shared.form.cancel"), story.persisted? ? universe_story_path(id: story) : universe_stories_path,
      class: "btn btn-link" %>
  </div>
<% end %>
