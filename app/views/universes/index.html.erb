<% content_for :title, "Universes" %>
<% empty_title = Current.user.present? ? "Create your first universe" : "No public universes yet" %>
<% empty_description = Current.user.present? ? "A universe holds the world, characters, locations, events, and items shared by its stories." : "Sign in to create a universe, or check back when a public universe is available." %>

<%= render "shared/page_header",
  title: "Universes",
  description: "Choose a world to work in. Each universe contains its own stories and shared world-building records.",
  count: @universes.size,
  count_label: "universe" do %>
  <% if Current.user.present? %>
    <%= link_to new_universe_path, class: "btn btn-primary" do %>
      <i class="bi bi-plus-lg" aria-hidden="true"></i>
      <span>New universe</span>
    <% end %>
  <% end %>
<% end %>

<% if @universes.any? %>
  <div class="content-surface">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead>
          <tr>
            <th scope="col">Universe</th>
            <th scope="col">Visibility</th>
            <th scope="col" class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @universes.each do |universe| %>
            <tr>
              <td>
                <%= link_to universe.name, universe_path(universe), class: "fw-semibold" %>
              </td>
              <td>
                <% if universe.private? %>
                  <span class="badge text-bg-warning-subtle text-warning-emphasis">
                    <span class="status-dot status-dot--private" aria-hidden="true"></span>Private
                  </span>
                <% else %>
                  <span class="badge text-bg-success-subtle text-success-emphasis">
                    <span class="status-dot" aria-hidden="true"></span>Public
                  </span>
                <% end %>
              </td>
              <td class="text-end">
                <div class="dropdown row-actions">
                  <button class="btn btn-sm btn-light border dropdown-toggle" type="button"
                    id="<%= dom_id(universe) %>-actions"
                    data-bs-toggle="dropdown"
                    aria-expanded="false"
                    aria-label="Actions for <%= universe.name %>">
                    <i class="bi bi-three-dots" aria-hidden="true"></i>
                  </button>
                  <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="<%= dom_id(universe) %>-actions">
                    <li><%= link_to "Open universe", universe_path(universe), class: "dropdown-item" %></li>
                    <% if can_administer_universe?(universe) %>
                      <li><%= link_to "Manage members", universe_memberships_path(universe_slug: universe.slug), class: "dropdown-item" %></li>
                      <li><%= link_to "Edit universe", edit_universe_path(universe), class: "dropdown-item" %></li>
                      <li><hr class="dropdown-divider"></li>
                      <li>
                        <%= button_to "Delete universe", universe_path(universe),
                          method: :delete,
                          class: "dropdown-item text-danger",
                          data: { turbo_confirm: "Delete #{universe.name} and all of its content?" } %>
                      </li>
                    <% end %>
                  </ul>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% else %>
  <%= render "shared/empty_state",
    title: empty_title,
    description: empty_description,
    icon: "globe2" %>
<% end %>
