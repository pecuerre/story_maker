<% content_for :title, t("tags.title") %>

<% tag_config = tag_workspace_config(scope: @tag_scope, taxonomy: @tag_type) %>
<%# The eyebrow is the same string as the active scope tab beside it, so one key
    names both. %>
<% scope_label = @tag_scope == "story" ? t("tags.scope.story") : t("tags.scope.universe") %>

<%= render "shared/tag_workspace_navigation",
  scope: @tag_scope,
  taxonomy: @tag_type %>

<% if tag_config.present? %>
  <%= render "shared/taxonomy_tree",
    title: t("tags.title"),
    eyebrow: scope_label,
    description: tag_config.fetch(:description),
    count: tag_config.fetch(:count),
    count_label: "tag",
    new_label: tag_config.fetch(:new_label),
    empty_description: tag_config.fetch(:empty_description),
    read_only_empty_description: tag_config[:read_only_empty_description],
    confirm_message: tag_config[:confirm_message],
    nodes: tag_config.fetch(:nodes),
    create_url: tag_config.fetch(:create_url),
    update_url: tag_config.fetch(:update_url),
    model_param: tag_config.fetch(:model_param),
    details_url: tag_config.fetch(:details_url),
    details_count: tag_config.fetch(:details_count),
    details_count_label: tag_config.fetch(:details_count_label),
    modal_fields: tag_config.fetch(:modal_fields) %>
<% elsif @tag_scope == "story" %>
  <%= render "shared/page_header",
    title: t("tags.title"),
    eyebrow: scope_label,
    description: t("tags.no_story.description") %>

  <%= render "shared/empty_state",
    title: t("tags.no_story.empty_title"),
    description: t("tags.no_story.empty_description"),
    icon: "book" %>
<% end %>
