<% content_for :title, t("scenes.items.document_title", scene: @scene.name) %>
<% editable = can_write_universe? %>

<%# The editor's wrapper has to contain the modal *and* every control that opens
    it, which is why the page header is inside it rather than beside it. %>
<div
  <% if editable %>data-controller="modal-form"<% end %>
  data-modal-form-model-param-value="scene_item"
  data-modal-form-response-value="json"
  data-modal-form-create-title-value="<%= t("scenes.items.add") %>">
  <%= render "shared/page_header",
    title: t("items.title"),
    eyebrow: t("shared.eyebrow.scene", scene: @scene.name),
    description: t("scenes.items.description"),
    count: @scene_items.size,
    count_label: "item" do %>
    <%= link_to t("scenes.back_to_details"), universe_story_scene_path(story_id: @story, id: @scene), class: "btn btn-outline-secondary" %>
    <% if editable %>
      <button type="button" class="btn btn-primary"
        data-action="modal-form#open"
        data-modal-form-url="<%= universe_story_scene_scene_items_path(story_id: @story, scene_id: @scene) %>"
        data-modal-form-method="post"
        data-modal-form-title="<%= t("scenes.items.add") %>"
        data-modal-form-values-value="{}">
        <i class="bi bi-plus-lg" aria-hidden="true"></i>
        <span><%= t("scenes.items.add") %></span>
      </button>
    <% end %>
  <% end %>

  <%= render "scenes/workspace_tabs" %>

  <% if @scene_items.any? %>
    <div class="content-surface entity-list">
      <div class="list-group list-group-flush">
        <% @scene_items.each do |link| %>
          <div class="list-group-item entity-row d-flex align-items-start gap-3">
            <div class="entity-copy flex-grow-1">
              <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="entity-title"><%= link.item.name %></span>
                <span class="badge rounded-pill text-bg-light border"><%= t("scenes.participation.linked") %></span>
              </div>
              <%# The role is the author's own free text, so it is interpolated into
                  the row's label rather than translated. %>
              <div class="entity-description">
                <%= t("scenes.participation.role", role: scene_item_role_label(link)) %>
              </div>
            </div>

            <div class="entity-row-actions d-flex align-items-center gap-2 flex-wrap justify-content-end">
              <%= record_details_link universe_item_path(id: link.item), record: link.item %>

              <% if editable %>
                <div class="dropdown row-actions">
                  <button class="btn btn-sm btn-light border dropdown-toggle" type="button"
                    id="<%= dom_id(link) %>-actions"
                    data-bs-toggle="dropdown"
                    aria-expanded="false"
                    aria-label="<%= t("scenes.participation.actions_for", name: link.item.name, scene: @scene.name) %>">
                    <i class="bi bi-three-dots" aria-hidden="true"></i>
                  </button>
                  <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="<%= dom_id(link) %>-actions">
                    <li>
                      <button type="button" class="dropdown-item"
                        data-action="modal-form#open"
                        data-modal-form-url="<%= universe_story_scene_scene_item_path(story_id: @story, scene_id: @scene, id: link) %>"
                        data-modal-form-method="patch"
                        data-modal-form-title="<%= t("scenes.items.edit_item") %>"
                        data-modal-form-values-value="<%= scene_item_fields_json(link) %>">
                        <i class="bi bi-pencil me-2" aria-hidden="true"></i><%= t("scenes.items.edit_item") %>
                      </button>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                      <button type="button" class="dropdown-item text-danger"
                        data-action="modal-form#destroy"
                        data-modal-form-url="<%= universe_story_scene_scene_item_path(story_id: @story, scene_id: @scene, id: link) %>"
                        data-modal-form-confirm="<%= t("scenes.participation.remove.item",
                          name: link.item.name, scene: @scene.name) %>">
                        <i class="bi bi-trash me-2" aria-hidden="true"></i><%= t("scenes.participation.remove_label") %>
                      </button>
                    </li>
                  </ul>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <%= render "shared/empty_state",
      title: t("scenes.items.empty_title"),
      description: t("scenes.items.empty_description"),
      icon: "box-seam" %>
  <% end %>

  <% if editable %>
    <div class="modal fade" tabindex="-1"
      aria-labelledby="scene-item-modal-title"
      aria-hidden="true"
      data-modal-form-target="modal">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h2 class="modal-title fs-5" id="scene-item-modal-title" data-modal-form-target="title"><%= t("scenes.items.add") %></h2>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t("shared.form.close") %>"></button>
          </div>
          <%= form_with scope: :scene_item,
            url: universe_story_scene_scene_items_path(story_id: @story, scene_id: @scene),
            method: :post,
            data: { modal_form_target: "form", action: "modal-form#save" } do |form| %>
            <div class="modal-body">
              <%= render "shared/modal_errors" %>

              <div class="mb-3">
                <%= form.label :item_id, t("scenes.items.form.item"), class: "form-label" %>
                <%# The blank option's value is the empty string the form stores, so
                    it is not translated; the item ids beside the names are record
                    ids and are not translated either. %>
                <%= form.select :item_id, scene_item_choices(@item_options),
                  { include_blank: t("scenes.items.form.choose_item") },
                  class: "form-select", required: true %>
                <div class="form-text"><%= t("scenes.items.form.item_hint") %></div>
              </div>

              <div>
                <%= form.label :role, t("scenes.items.form.role"), class: "form-label" %>
                <%= form.text_field :role, class: "form-control" %>
                <%# The examples are chrome too — they are words the interface
                    suggests — so they are their own key, interpolated into the one
                    hint all three tabs share. %>
                <div class="form-text"><%= t("scenes.participation.role_hint",
                  examples: t("scenes.items.role_examples")) %></div>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t("shared.form.cancel") %></button>
              <%= form.submit t("scenes.items.save"), class: "btn btn-primary", data: { modal_form_target: "submit" } %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>