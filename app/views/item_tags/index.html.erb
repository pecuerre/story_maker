<% content_for :title, "Item Tags" %>

<%= render "shared/taxonomy_tree",
  title: "Item tags",
  description: "Define optional categories for objects and resources in this universe.",
  eyebrow: "Universe Bible",
  count: Current.universe.item_tags.count,
  count_label: "tag",
  new_label: "Add item tag",
  tag_workspace_scope: "universe",
  tag_workspace_taxonomy: "item",
  empty_description: "Tags are optional. Add one to group items, or create untagged items.",
  read_only_empty_description: "No item tags are defined yet.",
  nodes: @item_tags,
  create_url: universe_item_tags_path,
  update_url: ->(item_tag) { universe_item_tag_path(id: item_tag) },
  model_param: "item_tag",
  details_url: ->(item_tag) { universe_item_tag_path(id: item_tag) },
  details_count: ->(tag) { @tagged_counts.fetch(tag.id, 0) },
  details_count_label: "item",
  modal_fields: item_tag_taxonomy_fields(Current.universe.item_tags.order(:position, :id)) %>
