<% content_for :title, t("passwords.new.title") %>

<div class="auth-shell">
  <%= render "shared/page_header",
    title: t("passwords.new.heading"),
    description: t("passwords.new.description") %>

  <%= form_with url: passwords_path, class: "form-surface" do |form| %>
    <div class="mb-3">
      <%= form.label :email_address, class: "form-label" %>
      <%= form.email_field :email_address,
        class: "form-control",
        required: true,
        autofocus: true,
        autocomplete: "username",
        placeholder: "you@example.com",
        value: params[:email_address] %>
    </div>

    <div class="d-flex align-items-center gap-3">
      <%= form.submit t("passwords.new.submit"), class: "btn btn-primary" %>
      <%= link_to t("passwords.new.back"), new_session_path, class: "btn btn-link" %>
    </div>
  <% end %>
</div>
