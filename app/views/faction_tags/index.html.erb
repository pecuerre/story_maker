<% content_for :title, t("tags.types.faction.title") %>

<%= render "shared/taxonomy_tree",
  title: t("tags.types.faction.title"),
  description: t("tags.types.faction.description"),
  eyebrow: t("sidebar.universe_bible"),
  count: @hierarchy.records.length,
  count_label: "tag",
  new_label: t("tags.types.faction.new_label"),
  tag_workspace_scope: "universe",
  tag_workspace_taxonomy: "faction",
  empty_description: t("tags.types.faction.empty_description"),
  read_only_empty_description: t("tags.types.faction.read_only_empty_description"),
  nodes: @faction_tags,
  hierarchy: @hierarchy,
  filter: @list_filter,
  filter_path: universe_faction_tags_path,
  filter_total: @faction_tag_total,
  filter_shown: @hierarchy.records.length,
  filter_count_label: "tag",
  create_url: universe_faction_tags_path,
  update_url: ->(faction_tag) { universe_faction_tag_path(id: faction_tag) },
  model_param: "faction_tag",
  details_url: ->(faction_tag) { universe_faction_tag_path(id: faction_tag) },
  details_count: ->(tag) { @tagged_counts.fetch(tag.id, 0) },
  details_count_label: "faction",
  modal_fields: faction_tag_taxonomy_fields(@hierarchy.records) %>
