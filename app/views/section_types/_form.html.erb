<%= form_with(model: section_type, url: section_type.persisted? ? story_section_type_path(story_slug: Current.story.slug, id: section_type) : story_section_types_path(story_slug: Current.story.slug)) do |form| %>
  <% if section_type.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(section_type.errors.count, "error") %> prohibited this section_type from being saved:</h2>

      <ul>
        <% section_type.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :parent_id, "Parent", style: "display: block" %>
    <%= form.collection_select :parent_id, section_type.story.section_types.where.not(id: section_type.id).order(:name), :id, :name, { include_blank: "No parent" } %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
