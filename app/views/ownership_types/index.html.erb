<% content_for :title, "Ownership types" %>

<h1>Ownership types</h1>

<%= render "shared/taxonomy_tree",
  nodes: @ownership_types,
  new_url: ->(parent = nil) { new_story_ownership_type_path(parent_id: parent&.id) },
  create_url: story_ownership_types_path(),
  edit_url: ->(ownership_type) { edit_story_ownership_type_path(id: ownership_type) },
