<section class="content-surface p-3 p-md-4 mt-4" aria-labelledby="character-knowledge-heading">
  <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
    <h2 class="h4 mb-0" id="character-knowledge-heading"><%= t("characters.knowledge.title") %></h2>
    <span class="badge rounded-pill text-bg-light border"><%= knowledges.size %></span>
  </div>

  <% if knowledges.any? %>
    <div class="d-grid gap-3">
      <% knowledges.each do |entry| %>
        <article class="border rounded p-3">
          <h3 class="h6"><%= entry.when_text %></h3>
          <p class="mb-2"><%= entry.what_learned %></p>
          <p class="small mb-2">
            <strong><%= t("characters.knowledge.from_whom") %>:</strong>
            <% if entry.source_character %>
              <%= link_to entry.source_character.name,
                universe_character_path(universe_slug: Current.universe.slug, id: entry.source_character) %>
            <% else %>
              <%= t("characters.knowledge.unknown_source") %>
            <% end %>
            <span class="ms-2"><strong><%= t("characters.knowledge.changes_plan") %>:</strong>
              <%= t("characters.knowledge.#{entry.changes_plan? ? 'yes' : 'no'}") %></span>
          </p>

          <% if can_write_universe? %>
            <%= render "characters/knowledge_form", character: character, knowledge: entry %>
            <%= button_to t("characters.knowledge.delete"),
              universe_character_character_knowledge_path(universe_slug: Current.universe.slug,
                character_id: character, id: entry),
              method: :delete, class: "btn btn-outline-danger btn-sm mt-2",
              form: { data: { turbo_confirm: t("characters.knowledge.delete_confirm") } } %>
          <% end %>
        </article>
      <% end %>
    </div>
  <% else %>
    <p class="text-body-secondary"><%= t("characters.knowledge.empty") %></p>
  <% end %>

  <% if can_write_universe? %>
    <div class="border-top mt-4 pt-3">
      <h3 class="h5"><%= t("characters.knowledge.add") %></h3>
      <%= render "characters/knowledge_form", character: character, knowledge: knowledge %>
    </div>
  <% end %>
</section>
