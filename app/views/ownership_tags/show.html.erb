<% content_for :title, @ownership_tag.name %>

<%= render "shared/record_details",
  record: @ownership_tag,
  eyebrow: "Configuration · Tags",
  label: "Ownership tag",
  facts: [
    detail_fact("Scope", "Tags are optional labels. This taxonomy belongs to the universe and is shared by every story in it."),
    detail_fact("Description", @ownership_tag.description, blank: "No description yet."),
    detail_fact("Color", @ownership_tag.bgcolor, blank: "No background color set. An untinted tag is still shown with its name.")
  ],
  back_url: universe_ownership_tags_path,
  back_label: "All ownership tags" %>

<%= render "shared/detail_section",
  title: "Ownerships with this tag",
  count: @tagged_records.size,
  count_label: "ownership",
  icon: "person-check",
  empty_title: "No ownerships carry this tag",
  empty_description: "Nothing uses this tag yet. Tags are optional, so ownerships can stay untagged." do %>
  <%= render "shared/tagged_record_list",
    records: @tagged_records,
    path: ->(record) { universe_ownership_path(id: record) } %>
<% end %>
