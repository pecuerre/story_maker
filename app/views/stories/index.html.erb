<% content_for :title, t("stories.title") %>
<%# The list is empty in two different ways, so it says two different things:
    someone who can add a story is told what one is for, and a read-only member
    is told that the page is waiting rather than inviting them to act. %>
<% empty_description = can_write_universe? ? t("stories.empty_writable_description") : t("stories.empty_read_only_description") %>

<%= render "shared/page_header",
  title: t("stories.title"),
  eyebrow: Current.universe.name,
  description: t("stories.description"),
  count: @stories.size,
  count_label: "story" do %>
  <% if can_write_universe? %>
    <%= link_to new_universe_story_path, class: "btn btn-primary" do %>
      <i class="bi bi-plus-lg" aria-hidden="true"></i>
      <span><%= t("stories.new") %></span>
    <% end %>
  <% end %>
<% end %>

<% if @stories.any? %>
  <div class="row g-3">
    <% @stories.each do |story| %>
      <div class="col-md-6 col-xl-4">
        <article class="card surface-card story-card h-100">
          <div class="card-body p-4">
            <div class="d-flex align-items-start justify-content-between gap-3 mb-2">
              <h2 class="h5 story-card-title mb-0">
                <%= link_to story.name, universe_story_path(id: story) %>
              </h2>
              <% if Current.story == story %>
                <span class="badge text-bg-primary"><%= t("stories.current_badge") %></span>
              <% end %>
            </div>

            <% if story.description.present? %>
              <p class="text-body-secondary"><%= story.description %></p>
            <% else %>
              <p class="text-body-secondary"><%= t("stories.no_description") %></p>
            <% end %>

            <div class="small text-body-secondary mb-3">
              <%= count_with_label(story.sections.size, "section") %>
            </div>
          </div>

          <div class="card-footer bg-body border-top-0 d-flex align-items-center gap-2">
            <%= link_to t("stories.open"), universe_story_path(id: story), class: "btn btn-sm btn-primary" %>
            <%= link_to t("sidebar.sections"), universe_story_sections_path(story_id: story), class: "btn btn-sm btn-outline-secondary" %>

            <% if can_write_universe? %>
              <div class="dropdown row-actions ms-auto">
                <button class="btn btn-sm btn-light border dropdown-toggle" type="button"
                  id="<%= dom_id(story) %>-actions"
                  data-bs-toggle="dropdown"
                  aria-expanded="false"
                  aria-label="<%= t("shared.row_actions.actions_for", name: story.name) %>">
                  <i class="bi bi-three-dots" aria-hidden="true"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="<%= dom_id(story) %>-actions">
                  <li><%= link_to t("stories.edit"), edit_universe_story_path(id: story), class: "dropdown-item" %></li>
                  <li><hr class="dropdown-divider"></li>
                  <li>
                    <%= button_to t("stories.delete"), universe_story_path(id: story),
                      method: :delete,
                      class: "dropdown-item text-danger",
                      data: { turbo_confirm: t("stories.delete_confirm", name: story.name) } %>
                  </li>
                </ul>
              </div>
            <% end %>
          </div>
        </article>
      </div>
    <% end %>
  </div>
<% else %>
  <%= render "shared/empty_state",
    title: t("stories.empty_title"),
    description: empty_description,
    icon: "books" %>
<% end %>
