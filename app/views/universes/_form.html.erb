<%= form_with(model: universe, class: "form-surface") do |form| %>
  <% if universe.errors.any? %>
    <div class="alert alert-danger" role="alert">
      <h2 class="h6"><%= pluralize(universe.errors.count, "error") %> prevented this universe from being saved:</h2>
      <ul class="mb-0">
        <% universe.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, class: "form-control", required: true, autofocus: true %>
  </div>

  <div class="form-actions">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", universe.persisted? ? universe_path(universe) : universes_path, class: "btn btn-link" %>
  </div>
<% end %>
