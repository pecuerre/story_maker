# Template for local environment values. Every value here is intentionally blank
# and no secret belongs in this file: copy it to `.env`, fill in your own local
# values, and keep `.env` itself untracked. It is the one `.env*` path this
# repository tracks, through a deliberate unignore rule in `.gitignore`.
#
# The application does NOT read this file. Nothing in the boot path loads `.env`,
# and `bin/dev` starts foreman with `--env /dev/null`, so a value here only reaches
# a command if your shell exports it. `docker compose` is the exception: it reads
# this file to interpolate `${...}` into `compose.yaml`. Use your own direnv/shell
# setup, or export the variable inline, for everything else.

# Password assigned to every development user that `db:demo:load` /
# `db:demo:reset` creates. Optional: with it unset, the loader generates one for
# that load and prints it on the terminal, along with the export command that
# reuses it. Local development only — it is never used by `db/seeds/`, a deploy
# command, or any other environment.
UNIVERSE_MAKER_DEV_PASSWORD=

# Directory the platform-admin import page may read story-interchange sources
# from. Optional: with it unset, the page explains that no root is configured
# and offers no folders. Only the folders directly under this path are listed,
# and the command-line task takes its own source path instead. Inside the Compose
# container the configured root is /sources.
STORY_INTERCHANGE_IMPORT_ROOT=

# Host directory Compose bind-mounts read-only at /sources/tcs.git, where it is
# one folder under STORY_INTERCHANGE_IMPORT_ROOT. Optional: with it unset,
# Compose uses the sibling ../tcs.git path. Compose only; the Rails process never
# reads this value.
STORY_INTERCHANGE_SOURCE_DIR=