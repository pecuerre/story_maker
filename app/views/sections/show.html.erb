<% content_for :title, @section.name %>

<%= render "shared/record_details",
  record: @section,
  eyebrow: t("shared.eyebrow.story", story: @story.name),
  label: t("sections.show.label"),
  facts: [
    detail_fact(t("sections.show.facts.story"), link_to(@story.name, universe_story_path(id: @story))),
    detail_fact(t("sections.show.facts.path"), @section_path || @section.name),
    detail_fact(t("sections.show.facts.tags"), entity_tag_badge(@section), blank: t("sections.show.facts.tags_blank")),
    detail_fact(t("sections.show.facts.description"), @section.description, blank: t("sections.show.facts.description_blank"))
  ],
  back_url: universe_story_sections_path(story_id: @story),
  back_label: t("sections.show.back_label"),
  actions: discussion_control(@section) %>

<%# "Details" on a Section in the tree leads here, so the scenes grouped under this
    Section are visible on their own. The number shown is the scene's narrative
    position in the story, which this Section does not influence. %>
<%= render "shared/detail_section",
  title: t("sections.show.scenes.title"),
  count: @scenes.size,
  count_label: "scene",
  icon: "film",
  empty_title: t("sections.show.scenes.empty_title"),
  empty_description: t("sections.show.scenes.empty_description") do %>
  <div class="list-group list-group-flush">
    <% @scenes.each do |scene| %>
      <div class="list-group-item entity-row d-flex align-items-center gap-3">
        <span class="badge rounded-pill text-bg-light border"
          aria-label="<%= t("shared.scene_position_aria", position: scene.position + 1, total: @scene_total) %>">
          <%= scene.position + 1 %>
        </span>
        <div class="entity-copy flex-grow-1">
          <span class="entity-title">
            <%= link_to scene.name, universe_story_scene_path(story_id: @story, id: scene), class: "text-break" %>
          </span>
          <% if scene.description.present? %>
            <div class="entity-description"><%= scene.description %></div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<%= render "shared/detail_section",
  title: t("sections.show.related.title"),
  icon: "diagram-3",
  empty_title: t("sections.show.related.empty_title"),
  empty_description: t("sections.show.related.empty_description") %>
