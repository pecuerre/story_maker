<% content_for :title, t("narrative_orders.title") %>

<%= render "shared/page_header",
  title: t("narrative_orders.title"),
  eyebrow: t("shared.eyebrow.story", story: @story.name),
  description: t("narrative_orders.description", story: @story.name),
  count: @comparison.rows.size,
  count_label: "scene" %>

<% if @comparison.rows.empty? %>
  <%= render "shared/empty_state",
    title: t("narrative_orders.empty_title"),
    description: can_write_universe? ? t("narrative_orders.empty_writable_description") : t("narrative_orders.empty_read_only_description"),
    icon: "signpost-split" %>
<% else %>
  <%= render "shared/content_tabs",
    aria_label: t("narrative_orders.views_aria_label"),
    class_name: "narrative-order-views",
    tabs: [
      { label: t("narrative_orders.views.list"),
        path: universe_story_narrative_order_path(story_id: @story),
        active: @view == "list" },
      { label: t("narrative_orders.views.chart"),
        path: universe_story_narrative_order_path(story_id: @story, view: "chart"),
        active: @view == "chart" }
    ] %>

  <% if @view == "chart" %>
    <%= render "chart", chart: @chart, comparison: @comparison %>
  <% else %>
    <%= render "list", comparison: @comparison %>
  <% end %>
<% end %>
