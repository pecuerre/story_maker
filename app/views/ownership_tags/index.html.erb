<% content_for :title, "Ownership Tags" %>

<%= render "shared/taxonomy_tree",
  title: "Ownership tags",
  description: "Describe the kinds of ownership recorded between characters and items.",
  eyebrow: "Universe Bible",
  count: Current.universe.ownership_tags.count,
  count_label: "tag",
  new_label: "Add ownership tag",
  tabs_aria_label: "Item workspace",
  tabs: [
    { label: "Items", path: universe_items_path, controller: :items },
    { label: "Item tags", path: universe_item_tags_path, controller: :item_tags },
    { label: "Ownerships", path: universe_ownerships_path, controller: :ownerships },
    { label: "Ownership tags", path: universe_ownership_tags_path, controller: :ownership_tags }
  ],
  empty_description: "Tags are optional. Add one to classify ownership records, or create them untagged.",
  nodes: @ownership_tags,
  new_url: ->(parent = nil) { new_universe_ownership_tag_path(parent_id: parent&.id) },
  create_url: universe_ownership_tags_path,
  edit_url: ->(ownership_tag) { edit_universe_ownership_tag_path(id: ownership_tag) },
  update_url: ->(ownership_tag) { universe_ownership_tag_path(id: ownership_tag) },
  delete_url: ->(ownership_tag) { universe_ownership_tag_path(id: ownership_tag) },
  model_param: "ownership_tag",
  modal_fields: ownership_tag_taxonomy_fields(Current.universe.ownership_tags.order(:position, :id)) %>
