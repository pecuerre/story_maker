<% content_for :title, t("searches.title") %>

<%# The results page. It is the answer without scripting, and the shareable
    version of an answer: the form above it submits to the same URL the top-bar
    dropdown fetches, so a link to a result set is a link anyone can open. A
    search box in the top bar is not reachable by keyboard otherwise, and neither
    is a result set worth discussing. %>
<%= render "shared/page_header",
  title: t("searches.title"),
  eyebrow: t("searches.eyebrow"),
  description: t("searches.description") %>

<div class="content-surface search-page-form p-3 p-md-4 mb-4">
  <%= form_with url: search_path_for(Current.universe), method: :get, class: "row g-2 align-items-end" do %>
    <div class="col-12 col-lg">
      <label class="form-label" for="search_page_q"><%= t("searches.form.label") %></label>
      <input type="search" class="form-control" id="search_page_q" name="q"
        value="<%= @query.text %>" autocomplete="off"
        placeholder="<%= t("searches.form.placeholder", minimum: Search::Query::MINIMUM_LENGTH) %>">
    </div>

    <div class="col-12 col-sm-6 col-lg-auto">
      <label class="form-label" for="search_page_scope"><%= t("searches.form.scope_label") %></label>
      <%= render "searches/scope_field", id: "search_page_scope", selected: @query.scope.display_value,
        universe: Current.universe, story: @query.story %>
    </div>

    <%# The story boundary travels with the form so a scope of "this story" is a
        plain query value. Nothing about it is remembered: searching inside a
        story must not change the story the workspace is working in. %>
    <% if @query.story %>
      <input type="hidden" name="story_id" value="<%= @query.story.id %>">
    <% end %>

    <div class="col-12 col-sm-auto d-flex align-items-center gap-2">
      <%= submit_tag t("searches.form.submit"), class: "btn btn-primary", name: nil %>
      <% if @query.applied? %>
        <%= link_to t("searches.form.clear"), search_path_for(Current.universe), class: "btn btn-light border" %>
      <% end %>
    </div>
  <% end %>

  <%# One sentence with the scope in it, so the emphasis is the sentence's to
      place rather than a `<strong>` this template wrapped around a translated
      label. %>
  <p class="search-page-scope-note text-body-secondary mb-0 mt-3">
    <%= t("searches.scope_note_html", searched: content_tag(:strong, @query.scope.label)) %>
  </p>
</div>

<% if @search_unavailable.present? %>
  <%# An engine that is not configured or not answering is stated, not hidden.
      The rest of the page still works, which is the point of degrading rather
      than failing. %>
  <div class="content-surface search-empty p-4" role="status">
    <h2 class="h6"><%= t("searches.unavailable_title") %></h2>
    <p class="text-body-secondary mb-0"><%= @search_unavailable %></p>
  </div>
<% elsif @query.too_short? %>
  <div class="content-surface search-empty p-4" role="status">
    <h2 class="h6"><%= t("searches.too_short_title") %></h2>
    <p class="text-body-secondary mb-0">
      <%= t("searches.too_short_description", minimum: Search::Query::MINIMUM_LENGTH) %>
    </p>
  </div>
<% elsif !@query.applied? %>
  <div class="content-surface search-empty p-4" role="status">
    <h2 class="h6"><%= t("searches.idle_title") %></h2>
    <p class="text-body-secondary mb-0">
      <%= t("searches.idle_description", minimum: Search::Query::MINIMUM_LENGTH) %>
    </p>
  </div>
<% elsif @search_results.any? || @search_commands.any? %>
  <%= render "searches/commands", commands: @search_commands %>

  <% if @search_results.any? %>
    <section class="search-results" aria-labelledby="search-results-title">
      <%# The count is the engine's total and not the page's, which is why a
          truncated list says so rather than letting it look complete. Both
          sentences are pluralized on that total. %>
      <h2 class="search-group-title" id="search-results-title">
        <% if @search_results.total > @search_results.size %>
          <%= t("searches.showing", count: @search_results.total, shown: @search_results.size) %>
        <% else %>
          <%= t("searches.matches", count: @search_results.total) %>
        <% end %>
      </h2>

      <ul class="list-unstyled search-results-list mb-0">
        <%= render partial: "searches/result", collection: @search_results.hits, as: :hit %>
      </ul>

      <%# Paging is stated, not implied: a truncated list that looks complete is
          how a reader concludes a universe is smaller than it is. %>
      <% if @search_results.total > Search::Catalog::PAGE_LIMIT %>
        <nav class="search-pagination" aria-label="<%= t("searches.pagination.aria_label") %>">
          <% if current_page > 1 %>
            <%= link_to t("searches.pagination.previous"), search_path_for(Current.universe, @query.query_params.merge(page: current_page - 1)),
              class: "btn btn-light border", rel: "prev" %>
          <% end %>
          <span class="search-pagination-position"><%= t("searches.pagination.page", number: current_page) %></span>
          <% if @search_results.total > current_page * Search::Catalog::PAGE_LIMIT %>
            <%= link_to t("searches.pagination.next"), search_path_for(Current.universe, @query.query_params.merge(page: current_page + 1)),
              class: "btn btn-light border", rel: "next" %>
          <% end %>
        </nav>
      <% end %>
    </section>
  <% end %>
<% else %>
  <%# The scope is a sentence of its own rather than a noun inside the next one:
      a lowercased scope label is a word order the locale does not get to choose,
      and the note above the form has already said what was searched. %>
  <div class="content-surface search-empty p-4" role="status">
    <h2 class="h6"><%= t("searches.nothing_matched_title", query: @query.text) %></h2>
    <p class="text-body-secondary mb-0">
      <%= t("searches.nothing_matched_searched_html", searched: content_tag(:strong, @query.scope.label)) %>
      <% if Current.universe.present? %>
        <%= t("searches.nothing_matched_description", platform_hint: t("searches.platform_hint")) %>
      <% else %>
        <%= t("searches.nothing_matched_description_no_widen") %>
      <% end %>
    </p>
  </div>
<% end %>
