<% content_for :title, t("appearances.title") %>

<%= render "shared/page_header",
  title: t("appearances.title"),
  eyebrow: t("shared.eyebrow.story", story: @story.name),
  description: t("appearances.description", story: @story.name),
  count: @grid.characters.size,
  count_label: "character" %>

<%= render "shared/content_tabs",
  aria_label: t("sidebar.story_workspace"),
  intro: t("appearances.intro", story: @story.name),
  tabs: story_workspace_tabs(@story) %>

<% if !@grid.scenes? %>
  <%= render "shared/empty_state",
    title: t("appearances.empty.no_scenes_title"),
    description: can_write_universe? ? t("appearances.empty.no_scenes_description") : t("appearances.empty.no_scenes_read_only_description"),
    icon: "table" %>
<% elsif !@grid.characters? %>
  <%= render "shared/empty_state",
    title: t("appearances.empty.no_characters_title", story: @story.name),
    description: t("appearances.empty.no_characters_description"),
    icon: "table" %>
<% else %>
  <section class="surface-card p-3 p-md-4" aria-labelledby="appearance-grid-legend-title">
    <h2 class="h5" id="appearance-grid-legend-title"><%= t("appearances.legend.title") %></h2>
    <ul class="appearance-grid-legend list-inline mb-3">
      <li class="list-inline-item">
        <span class="appearance-mark appearance-mark--present" aria-hidden="true"></span>
        <%= t("appearances.legend.present") %>
      </li>
      <li class="list-inline-item">
        <span class="appearance-mark appearance-mark--mention" aria-hidden="true"></span>
        <%= t("appearances.legend.mention") %>
      </li>
    </ul>

    <div class="appearance-grid-scroll" role="region" tabindex="0"
      aria-label="<%= t("appearances.scroll_label", story: @story.name) %>">
      <table class="appearance-grid">
        <caption class="visually-hidden"><%= t("appearances.caption", story: @story.name) %></caption>
        <thead>
          <tr>
            <th scope="col"><%= t("appearances.character_column") %></th>
            <% @grid.scenes.each do |scene| %>
              <th scope="col">
                <span class="appearance-grid-position"><%= scene.position + 1 %></span>
                <%= link_to scene.name, universe_story_scene_path(story_id: @story, id: scene),
                  class: "appearance-grid-scene-link",
                  aria: { label: t("appearances.scene_link", position: scene.position + 1, name: scene.name) } %>
              </th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% @grid.characters.each do |character| %>
            <tr>
              <th scope="row">
                <%= link_to character.name, universe_character_path(universe_slug: Current.universe.slug, id: character),
                  class: "appearance-grid-character-link" %>
              </th>
              <% @grid.scenes.each do |scene| %>
                <% state = @grid.state_for(character, scene) %>
                <td class="appearance-grid-cell appearance-grid-cell--<%= state %>">
                  <% if state == :present || state == :both %>
                    <span class="appearance-mark appearance-mark--present" aria-hidden="true"></span>
                  <% end %>
                  <% if state == :mention || state == :both %>
                    <span class="appearance-mark appearance-mark--mention" aria-hidden="true"></span>
                  <% end %>
                  <span class="visually-hidden"><%= t("appearances.states.#{state}") %></span>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% end %>
